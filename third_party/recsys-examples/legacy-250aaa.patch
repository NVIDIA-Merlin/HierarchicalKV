+def fbgemm_training_double(config, monkeypatch):
+    field_names = "stochastic_rounding gradient_clipping max_gradient max_norm eps beta1 beta2 weight_decay weight_decay_mode eta momentum counter_halflife adjustment_iter adjustment_ub learning_rate_mode grad_sum_decay tail_id_threshold is_tail_id_thresh_ratio total_hash_size weight_norm_coefficient lower_bound regularization_mode use_rowwise_bias_correction".split()
+    args = dict.fromkeys(field_names, 0)
+    args["eps"] = config.eps
+
+    class Tables(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.optimizer_args = SimpleNamespace(_asdict=lambda: args.copy())
+            self.iter = torch.zeros(1, dtype=torch.int64)
+            self.iter_cpu = torch.zeros(1, dtype=torch.int64)
+            self.learning_rate_tensor = torch.tensor(config.learning_rate)
+            self.weights = [
+                torch.full((size, config.embedding_dim), 3.0)
+                for size in config.vocab_sizes
+            ]
+            count = (
+                2
+                if config.optimizer == "adam"
+                else int(backends._state_width(config) != 0)
+            )
+            self.states = [
+                [
+                    torch.full(
+                        (size, backends._state_width(config) // count), float(index + 1)
+                    )
+                    for index in range(count)
+                ]
+                for size in config.vocab_sizes
+            ]
+
+        def split_embedding_weights(self):
+            return self.weights
+
+        def split_optimizer_states(self):
+            return self.states
+
+        def flush(self):
+            pass
+
+        def reset_cache_states(self):
+            pass
+
+    monkeypatch.setattr(backends, "_backend_class", lambda backend: Tables)
+    return Tables
+

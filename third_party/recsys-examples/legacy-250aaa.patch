+def memory_deltas(before, after):
+    fields = {
+        "device_used_bytes_delta": ("device_free_bytes", -1),
+        "torch_allocated_bytes_delta": ("torch_allocated_bytes", 1),
+        "torch_reserved_bytes_delta": ("torch_reserved_bytes", 1),
+        "cpu_process_rss_bytes_delta": ("cpu_process_rss_bytes", 1),
+    }
+    return {
+        label: None
+        if before.get(field) is None or after.get(field) is None
+        else sign * (after[field] - before[field])
+        for label, (field, sign) in fields.items()
+    }

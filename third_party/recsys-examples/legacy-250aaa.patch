+def nvml_memory_snapshot(device):
+    result = {
+        "status": "unavailable",
+        "api": "NVIDIA nvidia-smi NVML query interface",
+        "pid": os.getpid(),
+        "cuda_uuid": None,
+        "gpu_uuid": None,
+        "device_used_bytes": None,
+        "process_used_bytes": None,
+        "resolution_bytes": 1024**2,
+        "started_utc": datetime.now(timezone.utc).isoformat(),
+        "errors": [],
+        "scope": "live caller PID on its CUDA UUID; separate rounded NVML samples, not simultaneous, incremental backend allocations, total physical memory or UVM residency; never sum with CUDA/Torch/RSS/ledger",
+    }
+    try:
+        import torch
+
+        cuda_uuid = str(torch.cuda.get_device_properties(device).uuid)
+        result["cuda_uuid"] = cuda_uuid
+        match = re.fullmatch(
+            r"(?:GPU-)?([0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})",
+            cuda_uuid,
+        )
+        if match is None:
+            raise ValueError("full CUDA GPU UUID unavailable; no ordinal fallback")
+        gpu_uuid = f"GPU-{match.group(1).lower()}"
+        result["gpu_uuid"] = gpu_uuid
+        for kind, fields in (
+            ("gpu", "uuid,memory.used"),
+            ("compute-apps", "gpu_uuid,pid,used_gpu_memory"),
+        ):
+            try:
+                output = subprocess.run(
+                    [
+                        "nvidia-smi",
+                        f"--id={gpu_uuid}",
+                        f"--query-{kind}={fields}",
+                        "--format=csv,noheader,nounits",
+                    ],
+                    capture_output=True,
+                    text=True,
+                    check=True,
+                    timeout=5,
+                )
+                result[f"raw_{kind}"] = output.stdout
+                rows = [
+                    [field.strip() for field in row]
+                    for row in csv.reader(output.stdout.splitlines())
+                    if row
+                ]
+                matches = [
+                    row
+                    for row in rows
+                    if row[0] == gpu_uuid
+                    and (
+                        kind == "gpu"
+                        or (len(row) == 3 and row[1] == str(result["pid"]))
+                    )
+                ]
+                expected_fields = 2 if kind == "gpu" else 3
+                if len(matches) != 1 or len(matches[0]) != expected_fields:
+                    raise ValueError("unique UUID/live-PID memory row unavailable")
+                memory_mib = int(matches[0][-1])
+                if memory_mib < 0:
+                    raise ValueError("negative or unsupported memory usage")
+                field = "device_used_bytes" if kind == "gpu" else "process_used_bytes"
+                result[field] = memory_mib * result["resolution_bytes"]
+            except (OSError, subprocess.SubprocessError, ValueError) as error:
+                result["errors"].append(f"{kind}: {type(error).__name__}: {error}")
+                if isinstance(error, subprocess.CalledProcessError):
+                    result[f"stderr_{kind}"] = error.stderr
+        if not result["errors"]:
+            result["status"] = "observed"
+        elif any(
+            result[field] is not None
+            for field in ("device_used_bytes", "process_used_bytes")
+        ):
+            result["status"] = "partial"
+    except Exception as error:
+        result["errors"].append(f"{type(error).__name__}: {error}")
+    result["finished_utc"] = datetime.now(timezone.utc).isoformat()
+    return result
+

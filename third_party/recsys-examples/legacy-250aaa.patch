+def dirty_update_spec(config):
+    if config.optimizer != "exact_sgd":
+        raise ValueError("dirty oracle requires EXACT_SGD; other optimizers unverified")
+    if config.backend not in BACKENDS or config.embedding_dim != 32:
+        raise ValueError("dirty oracle requires a supported native FP32/32 backend")
+    if (
+        len(config.vocab_sizes) != 26
+        or len(set(config.vocab_sizes)) != 1
+        or config.vocab_sizes[0] < 4
+        or config.batch_size <= 0
+    ):
+        raise ValueError(
+            "dirty oracle requires26 equal finite vocabularies and batches"
+        )
+    initial = [float(component + 8) / 8 for component in range(32)]
+    gradient = [
+        float(component + 1) / 16 * (-1 if component % 2 else 1)
+        for component in range(32)
+    ]
+    resident_initial = [-float(component + 8) / 16 for component in range(32)]
+    resident_gradient = [-float(32 - component) / 32 for component in range(32)]
+    rate = 0.125
+    return {
+        "table": 0,
+        "eviction_key": 0,
+        "resident_key": 1,
+        "learning_rate": rate,
+        "initial": initial,
+        "gradient": gradient,
+        "expected": [value - rate * grad for value, grad in zip(initial, gradient)],
+        "resident_initial": resident_initial,
+        "resident_gradient": resident_gradient,
+        "resident_expected": [
+            value - rate * grad
+            for value, grad in zip(resident_initial, resident_gradient)
+        ],
+        "pressure_first_key": 2,
+        "pressure_end_key": config.vocab_sizes[0],
+        "pressure_requests": config.vocab_sizes[0] - 2,
+    }
+
+
+def _exact_fp32(value):
+    """Reject a proposed dirty-oracle component that needs FP32 rounding."""
+    converted = struct.unpack("<f", struct.pack("<f", float(value)))[0]
+    if Fraction.from_float(converted) != value:
+        raise ValueError("dirty oracle vector component is not exactly FP32")
+    return converted
+
+
+def shared_dirty_table_vectors(spec, table_id):
+    """Distinct exact FP32 vectors; table zero remains the original oracle."""
+    if type(table_id) is not int or not 0 <= table_id < 26:
+        raise ValueError("dirty oracle table outside the 26 logical tables")
+    rate = Fraction.from_float(spec["learning_rate"])
+    offset = Fraction(table_id)
+    initial = [Fraction.from_float(value) + offset for value in spec["initial"]]
+    gradient = [Fraction.from_float(value) for value in spec["gradient"]]
+    resident_initial = [
+        Fraction.from_float(value) + offset for value in spec["resident_initial"]
+    ]
+    resident_gradient = [
+        Fraction.from_float(value) for value in spec["resident_gradient"]
+    ]
+    vectors = {
+        "initial": [_exact_fp32(value) for value in initial],
+        "gradient": [_exact_fp32(value) for value in gradient],
+        "expected": [
+            _exact_fp32(value - rate * grad)
+            for value, grad in zip(initial, gradient)
+        ],
+        "resident_initial": [_exact_fp32(value) for value in resident_initial],
+        "resident_gradient": [_exact_fp32(value) for value in resident_gradient],
+        "resident_expected": [
+            _exact_fp32(value - rate * grad)
+            for value, grad in zip(resident_initial, resident_gradient)
+        ],
+    }
+    if table_id == 0 and any(vectors[field] != spec[field] for field in vectors):
+        raise ValueError("shared table zero differs from the original dirty oracle")
+    return vectors
+
+
+def dirty_update_restore(config, weights, device):
+    if config.backend == "dynamicemb" and config.hkv_layout == "shared":
+        return dirty_update_restore_shared(config, weights, device)
+    import torch
+    from .config import shared_hkv_key
+    from .embedding_config import create_embedding_tables, load_frozen_weights
+    from .serving_replay import _assert_parity, _lookup, reference_embeddings
+
+    spec = dirty_update_spec(config)
+    oracle_config = replace(config, learning_rate=spec["learning_rate"])
+    oracle_weights = list(weights)
+    oracle_weights[0] = weights[0].clone()
+    for key, field in ((0, "initial"), (1, "resident_initial")):
+        oracle_weights[0][key] = torch.tensor(spec[field], dtype=torch.float32)
+    tables = create_embedding_tables(oracle_config, device)
+    load_frozen_weights(tables, oracle_config, oracle_weights, device)
+    tables.train()
+    policy = native_policy_observation(tables, oracle_config)
+
+    def snapshot(key, present):
+        torch.cuda.synchronize(device)
+        observation = diagnostic_cache_snapshot(tables, oracle_config)
+        if observation["status"] != "observed":
+            raise RuntimeError("dirty oracle cache visibility unavailable; unverified")
+        matches = [entry for entry in observation["entries"] if entry[:2] == [0, key]]
+        if bool(matches) != present:
+            raise RuntimeError(
+                f"dirty oracle key {key} cache presence must be {present}; "
+                "natural eviction/residency not verified"
+            )
+        return {"table": 0, "key": key, "present": present, "matches": matches}
+
+    def backing_row(key):
+        with torch.no_grad():
+            if config.backend == "dynamicemb":
+                storage = tables.tables[0]
+                native_key = (
+                    shared_hkv_key(0, key, config.vocab_sizes[0])
+                    if config.hkv_layout == "shared"
+                    else key
+                )
+                keys = torch.tensor([native_key], dtype=torch.int64, device=device)
+                values = torch.full(
+                    (1, storage.value_dim()),
+                    float("nan"),
+                    device=device,
+                    dtype=torch.float32,
+                )
+                found = torch.zeros(1, dtype=torch.bool, device=device)
+                storage.find(keys, values, found)
+                if not bool(found.all()):
+                    raise RuntimeError("dirty oracle target absent from native backing")
+                result = values[0, :32].cpu()
+            else:
+                result = tables.split_embedding_weights()[0][key].detach().cpu().clone()
+        torch.cuda.synchronize(device)
+        return result
+
+    def update(key, initial_field, gradient_field):
+        sparse = torch.full((1, 26), key, dtype=torch.int64)
+        with torch.enable_grad():
+            output = _lookup(tables, oracle_config, sparse, device)
+            _assert_parity(
+                output.detach(),
+                reference_embeddings(oracle_weights, sparse),
+                exact=True,
+            )
+            if not output.requires_grad:
+                raise RuntimeError(
+                    "dirty oracle native backward unavailable; unverified"
+                )
+            gradient = torch.zeros_like(output)
+            gradient[0, :32] = torch.tensor(
+                spec[gradient_field], device=device, dtype=torch.float32
+            )
+            output.backward(gradient)
+        snapshot(key, True)
+        _assert_parity(
+            backing_row(key),
+            torch.tensor(spec[initial_field], dtype=torch.float32),
+            exact=True,
+        )
+
+    update(0, "initial", "gradient")
+    pressure_digest = hashlib.sha256()
+    with torch.no_grad():
+        for begin in range(2, spec["pressure_end_key"], config.batch_size):
+            keys = torch.arange(
+                begin,
+                min(begin + config.batch_size, spec["pressure_end_key"]),
+                dtype=torch.int64,
+            )
+            sparse = keys[:, None].expand(-1, 26).contiguous()
+            pressure_digest.update(sparse.numpy().tobytes())
+            _lookup(tables, oracle_config, sparse, device)
+        absent_after_pressure = snapshot(0, False)
+        expected = torch.tensor(spec["expected"], dtype=torch.float32)
+        recovered_backing = backing_row(0)
+        _assert_parity(recovered_backing, expected, exact=True)
+        sparse = torch.zeros((1, 26), dtype=torch.int64)
+        reference = reference_embeddings(oracle_weights, sparse)
+        reference[0, :32] = expected
+        _assert_parity(
+            _lookup(tables, oracle_config, sparse, device), reference, exact=True
+        )
+        restored_after_miss = snapshot(0, True)
+
+    update(1, "resident_initial", "resident_gradient")
+    dirty_resident = snapshot(1, True)
+    tables.flush()
+    torch.cuda.synchronize(device)
+    resident_expected = torch.tensor(spec["resident_expected"], dtype=torch.float32)
+    _assert_parity(backing_row(1), resident_expected, exact=True)
+    tables.reset_cache_states()
+    absent_after_reset = snapshot(1, False)
+    with torch.no_grad():
+        sparse = torch.ones((1, 26), dtype=torch.int64)
+        reference = reference_embeddings(oracle_weights, sparse)
+        reference[0, :32] = resident_expected
+        _assert_parity(
+            _lookup(tables, oracle_config, sparse, device), reference, exact=True
+        )
+    restored_after_reset = snapshot(1, True)
+    return {
+        "status": "PASS",
+        "scope": "untimed native EXACT_SGD FP32 full-vector oracle; not timed updates, general optimizer or crash durability",
+        "optimizer": "exact_sgd",
+        "eviction_policy": config.eviction,
+        "native_type": type(tables).__module__ + "." + type(tables).__qualname__,
+        "native_policy": policy,
+        "spec": spec,
+        "pressure_trace_sha256": pressure_digest.hexdigest(),
+        "pressure_trace_scope": "one complete ascending sweep of keys[2,vocab_rows) in every table; identical finite trace, no adaptive victim search",
+        "absent_before_flush": absent_after_pressure,
+        "backing_before_flush": recovered_backing.tolist(),
+        "restored_after_real_miss": restored_after_miss,
+        "dirty_resident_before_flush": dirty_resident,
+        "absent_after_reset": absent_after_reset,
+        "restored_after_flush_reset": restored_after_reset,
+        "exact_full_vectors": True,
+        "formal_performance_admitted": False,
+    }
+
+
+def dirty_update_restore_shared(config, weights, device):
+    """Exercise all logical keys in one shared cache, outside the service timer."""
+    import torch
+    from .config import shared_hkv_key
+    from .embedding_config import create_embedding_tables, load_frozen_weights
+    from .serving_replay import _assert_parity, _lookup, reference_embeddings
+
+    spec = dirty_update_spec(config)
+    vectors = [shared_dirty_table_vectors(spec, table) for table in range(26)]
+    oracle_config = replace(config, learning_rate=spec["learning_rate"])
+    oracle_weights = []
+    for table, weight in enumerate(weights):
+        modified = weight.clone()
+        modified[0] = torch.tensor(vectors[table]["initial"], dtype=torch.float32)
+        modified[1] = torch.tensor(
+            vectors[table]["resident_initial"], dtype=torch.float32
+        )
+        oracle_weights.append(modified)
+    tables = create_embedding_tables(oracle_config, device)
+    load_frozen_weights(tables, oracle_config, oracle_weights, device)
+    tables.train()
+    policy = native_policy_observation(tables, oracle_config)
+    if policy["partition"] != "shared_across_tables" or policy["physical_tables"] != 1:
+        raise RuntimeError("dirty oracle requires one shared native cache/backing")
+
+    def snapshot_targets(key, present):
+        torch.cuda.synchronize(device)
+        observation = diagnostic_cache_snapshot(tables, oracle_config)
+        if observation["status"] != "observed":
+            raise RuntimeError("dirty oracle cache visibility unavailable; unverified")
+        entries = {tuple(entry[:2]): entry for entry in observation["entries"]}
+        targets = []
+        for table in range(26):
+            match = entries.get((table, key))
+            if (match is not None) != present:
+                raise RuntimeError(
+                    f"dirty oracle table {table} key {key} cache presence must "
+                    f"be {present}; natural eviction/residency not verified"
+                )
+            targets.append(
+                {"table": table, "key": key, "present": match is not None}
+            )
+        return {"key": key, "targets": targets, "full_cache_exports": 1}
+
+    def backing_rows(key):
+        with torch.no_grad():
+            storage = tables.tables[0]
+            keys = torch.tensor(
+                [shared_hkv_key(table, key, config.vocab_sizes[0]) for table in range(26)],
+                dtype=torch.int64,
+                device=device,
+            )
+            values = torch.full(
+                (26, storage.value_dim()),
+                float("nan"),
+                device=device,
+                dtype=torch.float32,
+            )
+            found = torch.zeros(26, dtype=torch.bool, device=device)
+            storage.find(keys, values, found)
+            if not bool(found.all()):
+                raise RuntimeError("dirty oracle 26-key shared backing read incomplete")
+            result = values[:, :32].detach().cpu().clone()
+        torch.cuda.synchronize(device)
+        return result
+
+    def exact_rows(actual, field):
+        expected = torch.tensor(
+            [vector[field] for vector in vectors], dtype=torch.float32
+        )
+        _assert_parity(actual, expected, exact=True)
+        return actual.tolist()
+
+    def update_all(key, initial_field, gradient_field):
+        sparse = torch.full((1, 26), key, dtype=torch.int64)
+        with torch.enable_grad():
+            output = _lookup(tables, oracle_config, sparse, device)
+            _assert_parity(
+                output.detach(),
+                reference_embeddings(oracle_weights, sparse),
+                exact=True,
+            )
+            if not output.requires_grad:
+                raise RuntimeError("dirty oracle native backward unavailable")
+            gradient = torch.tensor(
+                [vector[gradient_field] for vector in vectors],
+                dtype=torch.float32,
+                device=device,
+            ).reshape(1, 26 * 32)
+            output.backward(gradient)
+        snapshot = snapshot_targets(key, True)
+        old_backing = exact_rows(backing_rows(key), initial_field)
+        return snapshot, old_backing
+
+    dirty_eviction, old_eviction_backing = update_all(0, "initial", "gradient")
+    pressure_digest = hashlib.sha256()
+    with torch.no_grad():
+        for begin in range(2, spec["pressure_end_key"], config.batch_size):
+            keys = torch.arange(
+                begin,
+                min(begin + config.batch_size, spec["pressure_end_key"]),
+                dtype=torch.int64,
+            )
+            sparse = keys[:, None].expand(-1, 26).contiguous()
+            pressure_digest.update(sparse.numpy().tobytes())
+            _lookup(tables, oracle_config, sparse, device)
+        evicted = snapshot_targets(0, False)
+        recovered_backing = exact_rows(backing_rows(0), "expected")
+        sparse = torch.zeros((1, 26), dtype=torch.int64)
+        reference = torch.tensor(
+            [vector["expected"] for vector in vectors], dtype=torch.float32
+        ).reshape(1, 26 * 32)
+        restored_output = _lookup(tables, oracle_config, sparse, device)
+        _assert_parity(restored_output, reference, exact=True)
+        restored_rows = exact_rows(restored_output.reshape(26, 32).cpu(), "expected")
+        restored = snapshot_targets(0, True)
+
+    dirty_resident, old_resident_backing = update_all(
+        1, "resident_initial", "resident_gradient"
+    )
+    tables.flush()
+    torch.cuda.synchronize(device)
+    flushed_backing = exact_rows(backing_rows(1), "resident_expected")
+    tables.reset_cache_states()
+    absent_after_reset = snapshot_targets(1, False)
+    with torch.no_grad():
+        sparse = torch.ones((1, 26), dtype=torch.int64)
+        reference = torch.tensor(
+            [vector["resident_expected"] for vector in vectors], dtype=torch.float32
+        ).reshape(1, 26 * 32)
+        reset_output = _lookup(tables, oracle_config, sparse, device)
+        _assert_parity(reset_output, reference, exact=True)
+        reset_rows = exact_rows(reset_output.reshape(26, 32).cpu(), "resident_expected")
+    restored_after_reset = snapshot_targets(1, True)
+
+    table_results = []
+    for table, vector in enumerate(vectors):
+        table_results.append(
+            {
+                "table": table,
+                "vectors": vector,
+                "backing_old_after_dirty": old_eviction_backing[table],
+                "backing_after_pressure": recovered_backing[table],
+                "restored_after_real_miss": restored_rows[table],
+                "backing_old_resident": old_resident_backing[table],
+                "backing_after_flush": flushed_backing[table],
+                "restored_after_flush_reset": reset_rows[table],
+            }
+        )
+    return {
+        "status": "PASS",
+        "scope": "untimed native EXACT_SGD FP32 full-vector oracle across all 26 logical tables; not general optimizer or crash durability",
+        "optimizer": "exact_sgd",
+        "eviction_policy": config.eviction,
+        "native_type": type(tables).__module__ + "." + type(tables).__qualname__,
+        "native_policy": policy,
+        "spec": spec,
+        "table_coverage": list(range(26)),
+        "table_results": table_results,
+        "snapshots": {
+            "dirty_eviction_resident": dirty_eviction,
+            "evicted_after_pressure": evicted,
+            "restored_after_real_miss": restored,
+            "dirty_resident_before_flush": dirty_resident,
+            "absent_after_reset": absent_after_reset,
+            "restored_after_flush_reset": restored_after_reset,
+        },
+        "backing_batch_reads": 4,
+        "backing_keys_per_read": 26,
+        "pressure_trace_sha256": pressure_digest.hexdigest(),
+        "pressure_trace_scope": "one complete ascending sweep of keys[2,vocab_rows) in every table; identical finite trace, no adaptive victim search",
+        "exact_full_vectors": True,
+        "formal_performance_admitted": False,
+    }
+
+
+def run_native(
+    input_path,
+    backend,
+    state,
+    raw_path,
+    *,
+    cache_rows=None,
+    cuda_event_service=False,
+    hkv_layout="partitioned",
+    diagnostic_flush_repeats=1,
+):
+    if os.environ.get("TBE_EXPERIMENTAL_UVM_PREFETCH", "0") != "0":
+        raise ValueError("fixed comparison requires TBE_EXPERIMENTAL_UVM_PREFETCH=0")
+    if hkv_layout not in ("partitioned", "shared") or (
+        hkv_layout == "shared" and backend != "dynamicemb"
+    ):
+        raise ValueError("shared HKV layout is only available for DynamicEmb")
+    if type(diagnostic_flush_repeats) is not int or diagnostic_flush_repeats not in (1, 2):
+        raise ValueError("diagnostic flush repeats must be exactly 1 or 2")
+    if diagnostic_flush_repeats == 2 and (
+        backend != "dynamicemb" or hkv_layout != "shared"
+    ):
+        raise ValueError("repeated flush is only for the shared HKV diagnostic")
+    budget_range_open = False
+    allocator_history_active = False
+    raw = {
+        "format": FORMAT,
+        "backend": backend,
+        "hkv_layout": hkv_layout,
+        "requested_flush_repeats": diagnostic_flush_repeats,
+        "state": state,
+        "status": "started",
+        "started_utc": datetime.now(timezone.utc).isoformat(),
+        "input_path": str(Path(input_path).resolve()),
+        "open_gates": OPEN_GATES,
+        "formal_performance_admitted": False,
+        "batches": [],
+    }
+    with Path(raw_path).open("x") as stream:
+
+        def emit(kind, value):
+            stream.write(
+                json.dumps(
+                    {"kind": kind, "value": value}, sort_keys=True, allow_nan=False
+                )
+                + "\n"
+            )
+            stream.flush()
+
+        def mark_allocation_phase(phase):
+            if allocation_identities_enabled():
+                import torch
+
+                label = f"native_budget/final/{backend}/{phase}"
+                torch.cuda.nvtx.mark(label)
+                raw.setdefault("allocation_phase_markers", []).append(
+                    {"label": label, "host_perf_counter_ns": time.perf_counter_ns()}
+                )
+
+        emit("start", raw)
+        try:
+            import torch
+            from .config import ExperimentConfig
+            from .embedding_config import (
+                create_embedding_tables,
+                load_frozen_weights,
+                reset_and_check_cache,
+                runtime_manifest,
+                seed_everything,
+            )
+            from .serving_replay import _assert_parity, _lookup, reference_embeddings
+
+            raw["input_sha256"] = sha256(input_path)
+            artifact = torch.load(input_path, map_location="cpu", weights_only=True)
+            cell = validate_inputs(artifact)
+            options, capacity = capacity_options(
+                cell,
+                backend,
+                artifact.get("vocab_rows"),
+                cache_rows,
+                hkv_layout=hkv_layout,
+            )
+            raw.update(
+                cell=asdict(cell),
+                workload=workload_spec(cell, artifact.get("vocab_rows")),
+                native_capacity=capacity,
+                trace_sha256=artifact["trace_sha256"],
+                weights_sha256=artifact["weights_sha256"],
+                expected_requests=cell.batch_size * cell.batches,
+                process=process_identity(),
+            )
+            if not torch.cuda.is_available():
+                raise RuntimeError(
+                    "native V2 requires CUDA; CPU helpers are not backend parity"
+                )
+            device = torch.device("cuda:0")
+            torch.cuda.set_device(device)
+            seed_everything(cell.seed)
+            properties = torch.cuda.get_device_properties(device)
+            raw["hardware"] = {
+                "name": properties.name,
+                "uuid": str(getattr(properties, "uuid", "unavailable")),
+                "capability": [properties.major, properties.minor],
+                "total_memory": properties.total_memory,
+            }
+            config = ExperimentConfig(
+                backend=backend,
+                **options,
+                embedding_dim=32,
+                optimizer="exact_sgd",
+                eviction=cell.eviction,
+                batch_size=cell.batch_size,
+                seed=cell.seed,
+                backing_capacity_factor=2,
+                hkv_layout=hkv_layout,
+            )
+            raw["config"] = asdict(config)
+            raw["service_contract"] = {
+                "value_bytes_per_embedding": 128,
+                "embedding_rows_per_request": 26,
+                "output_bytes_per_request": 26 * 128,
+                "value_dtype": "FP32",
+                "key_dtype": "int64",
+                "pooling": "NONE",
+                "target_miss_scope": artifact["target_scope"],
+                "occupancy_scope": "reference working set; actual native occupancy/policy may differ",
+                "includes": "host loop/completion bookkeeping, layout/H2D, native lookup/prefetch, miss/backing restore, population, gather, eviction writeback, returned FP32 D2H, final flush and CUDA synchronization",
+                "excludes": "DNN/network, input load, initial frozen-weight load, preflight, warm priming, counters, oracle/hash/report work",
+                "updates": "read-only frozen weights; no dirty training updates",
+            }
+            weights, requests = artifact["weights"], artifact["requests"]
+            expected = [reference_embeddings(weights, sparse) for sparse in requests]
+
+            def fresh_tables():
+                native = create_embedding_tables(config, device)
+                policy = native_policy_observation(native, config)
+                raw["native_layout"] = {
+                    "hkv_layout": hkv_layout,
+                    "logical_tables": policy["logical_tables"],
+                    "physical_tables": policy["physical_tables"],
+                    "cache_partitions": len(policy["logical_cache_rows"]),
+                    "partition": policy["partition"],
+                    "key_encoding": (
+                        "table_id * 262144 + local_id"
+                        if hkv_layout == "shared"
+                        else "native per-table keys"
+                    ),
+                }
+                raw["native_capacity"] = capacity_observation(
+                    capacity, policy
+                )
+                emit("native_capacity", raw["native_capacity"])
+                if capacity["explicit_controls"] and not raw["native_capacity"][
+                    "request_satisfied"
+                ]:
+                    raise RuntimeError("native factory changed the requested cache capacity")
+                load_frozen_weights(native, config, weights, device)
+                reset_and_check_cache(native, config)
+                if backend == "torchrec" and native.lxu_cache_state.shape[1] != 32:
+                    raise RuntimeError(
+                        "V2 requires the inspected32-way native TBE cache"
+                    )
+                return native
+
+            raw["dirty_update_restore"] = dirty_update_restore(config, weights, device)
+            emit("dirty_update_restore", raw["dirty_update_restore"])
+
+            with torch.no_grad():
+                tables = fresh_tables()
+                raw["native"] = runtime_manifest(tables, config)
+                emit("native_identity", raw["native"])
+                diagnostic_metrics(tables, config, True)
+                for phase in ("cold", "warm", "flush_reset_restore"):
+                    reset_and_check_cache(tables, config)
+                    if phase == "warm":
+                        for sparse in artifact["prime"].split(cell.batch_size):
+                            _lookup(tables, config, sparse, device)
+                    before = observe(tables, config, metrics_enabled=True)
+                    previous_observation = before
+                    previous_boundary = diagnostic_cache_snapshot(tables, config)
+                    emit(
+                        "phase_begin",
+                        {
+                            "phase": phase,
+                            "state": before,
+                            "cache_boundary": previous_boundary,
+                        },
+                    )

+"""Bounded same-backend training continuation; never a serving or V7 result."""
+
+import argparse
+import json
+import os
+from dataclasses import replace
+from pathlib import Path
+
+import torch
+import torch.distributed as dist
+import torch.nn.functional as functional
+
+from .config import ExperimentConfig
+from .criteo_dataloader import CriteoKaggleDataset
+from .dlrm_model import DNN
+from .embedding_config import (
+    UnsupportedBackendError,
+    cache_metrics,
+    create_embedding_tables,
+    export_native_training_state,
+    file_sha256,
+    reset_and_check_cache,
+    restore_native_training_state,
+    runtime_manifest,
+    seed_everything,
+)
+from .serving_replay import ATOL, RTOL, _lookup, cpu_state, validate_checkpoint
+
+
+def assert_state_close(actual, expected, exact=False):
+    if isinstance(expected, torch.Tensor):
+        torch.testing.assert_close(
+            actual,
+            expected,
+            rtol=0 if exact else RTOL,
+            atol=0 if exact else ATOL,
+            check_dtype=True,
+        )
+    elif isinstance(expected, dict):
+        if not isinstance(actual, dict) or set(actual) != set(expected):
+            raise AssertionError("State fields differ")
+        for key in expected:
+            assert_state_close(
+                actual[key],
+                expected[key],
+                exact=exact or key in {"step", "globals", "optimizer_args"},
+            )
+    elif isinstance(expected, (list, tuple)):
+        if not isinstance(actual, type(expected)) or len(actual) != len(expected):
+            raise AssertionError("State component counts differ")
+        for actual_item, expected_item in zip(actual, expected):
+            assert_state_close(actual_item, expected_item, exact)
+    elif actual != expected:
+        raise AssertionError(f"State scalar differs: {actual!r} != {expected!r}")
+
+
+def training_snapshot(tables, model, optimizer, config, device):
+    weights, native = export_native_training_state(tables, config, device)
+    return {
+        "weights": weights,
+        "native": native,
+        "model": cpu_state(model.state_dict()),
+        "dense_optimizer": cpu_state(optimizer.state_dict()),
+    }
+
+
+def assert_update_occurred(before, after):
+    for parameter_id, state in after["dense_optimizer"]["state"].items():
+        if (
+            state["step"].item()
+            != before["dense_optimizer"]["state"][parameter_id]["step"].item() + 1
+        ):
+            raise AssertionError("Dense optimizer step did not advance exactly once")
+    if after["native"]["backend"] == "torchrec":
+        counter_increment = int(
+            after["native"]["optimizer"] not in ("sgd", "exact_sgd", "exact_adagrad")
+        )
+        for name in ("iter", "iter_cpu"):
+            if (
+                after["native"]["globals"][name].item()
+                != before["native"]["globals"][name].item() + counter_increment
+            ):
+                raise AssertionError(
+                    "FBGEMM optimizer-specific forward counter delta mismatch"
+                )
+    elif after["native"]["optimizer"] == "adam":
+        if (
+            after["native"]["optimizer_args"]["iters"]
+            != before["native"]["optimizer_args"]["iters"] + 1
+        ):
+            raise AssertionError(
+                "DynamicEmb Adam iteration did not advance exactly once"
+            )
+    if all(
+        torch.equal(first, second)
+        for first, second in zip(before["weights"], after["weights"])
+    ):
+        raise AssertionError("No native embedding update observed")
+    if all(
+        torch.equal(before["model"][name], value)
+        for name, value in after["model"].items()
+    ):
+        raise AssertionError("No dense model update observed")
+    rows = before["native"]["optimizer_rows"]
+    if any(row.numel() for row in rows) and all(
+        torch.equal(first, second)
+        for first, second in zip(rows, after["native"]["optimizer_rows"])
+    ):
+        raise AssertionError("No native optimizer-state update observed")
+
+
+def load_training_input(path, data_dir):
+    checkpoint = torch.load(path, map_location="cpu", weights_only=True)
+    state = checkpoint.get("training_state", {})
+    if (
+        checkpoint.get("metadata", {}).get("trained") is not True
+        or "config" not in state
+    ):
+        raise ValueError(
+            "Training gate requires a real trained checkpoint, not a smoke fixture"
+        )
+    config = ExperimentConfig(**state["config"])
+    validate_checkpoint(checkpoint, config)
+    if not config.caching or config.stw_mode:
+        raise UnsupportedBackendError(
+            "Training gate requires native caching without host STW maintenance"
+        )
+    config = replace(config, criteo_data_dir=str(data_dir))
+    dataset = CriteoKaggleDataset(config, use_synthetic=False)
+    if dataset.source_sha256 != checkpoint["metadata"]["dataset_sha256"]:
+        raise ValueError("Training gate dataset SHA-256 differs from checkpoint")
+    return checkpoint, config, dataset
+
+
+def run_training_gate(checkpoint_path, data_dir, output_path, steps=3):
+    if steps < 2:
+        raise ValueError("At least two updates are required to test dirty-state reload")
+    if Path(output_path).exists():
+        raise FileExistsError(output_path)
+    checkpoint, config, dataset = load_training_input(checkpoint_path, data_dir)
+    if not torch.cuda.is_available():
+        raise RuntimeError(
+            "Native training gate requires CUDA; CPU doubles cannot establish parity"
+        )
+    device = torch.device("cuda:0")
+    torch.cuda.set_device(device)
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    seed_everything(config.seed)
+    branches = []
+    for _branch in range(2):
+        tables = create_embedding_tables(config, device)
+        restore_native_training_state(
+            tables,
+            config,
+            checkpoint["embedding_weights"],
+            checkpoint["training_state"]["native"],
+            device,
+        )
+        model = DNN(config.embedding_dim).to(device).train()
+        model.load_state_dict(checkpoint["model_state_dict"], strict=True)
+        optimizer = torch.optim.Adagrad(model.parameters(), lr=config.learning_rate)
+        optimizer.load_state_dict(
+            cpu_state(checkpoint["training_state"]["dense_optimizer"])
+        )
+        initial = training_snapshot(tables, model, optimizer, config, device)
+        assert_state_close(
+            initial,
+            {
+                "weights": checkpoint["embedding_weights"],
+                "native": checkpoint["training_state"]["native"],
+                "model": checkpoint["model_state_dict"],
+                "dense_optimizer": checkpoint["training_state"]["dense_optimizer"],
+            },
+            exact=True,
+        )
+        reset_and_check_cache(tables, config)
+        branches.append((tables, model, optimizer))
+    if config.backend == "dynamicemb":
+        branches[1][0].set_record_cache_metrics(True)
+    count = min(config.batch_size, dataset.num_train)
+    sparse = torch.from_numpy(dataset.sparse[:count].copy())
+    dense = torch.from_numpy(dataset.dense[:count].copy()).to(device)
+    labels = torch.from_numpy(dataset.labels[:count].copy()).to(device)
+    checks = []
+    before = training_snapshot(*branches[0], config, device)
+    for step in range(steps):
+        embeddings, predictions, losses, snapshots = [], [], [], []
+        for tables, model, optimizer in branches:
+            embedding = _lookup(tables, config, sparse, device)
+            logits = model(embedding, dense)
+            loss = functional.binary_cross_entropy_with_logits(logits, labels)
+            embeddings.append(embedding.detach().cpu().clone())
+            predictions.append(logits.detach().cpu().clone())
+            losses.append(loss.detach().cpu().clone())
+            loss.backward()
+            optimizer.step()
+            optimizer.zero_grad(set_to_none=True)
+            snapshots.append(
+                training_snapshot(tables, model, optimizer, config, device)
+            )
+        assert_state_close(embeddings[1], embeddings[0])
+        assert_state_close(predictions[1], predictions[0])
+        assert_state_close(losses[1], losses[0])
+        assert_state_close(snapshots[1], snapshots[0])
+        assert_update_occurred(before, snapshots[0])
+        metrics = cache_metrics(branches[1][0], config)
+        if config.backend == "dynamicemb" and (
+            metrics.get("lookup_keys", 0) <= 0 or metrics.get("hits") != 0
+        ):
+            raise AssertionError("Reset branch did not observe all backing misses")
+        if config.backend == "torchrec" and not bool(
+            (branches[1][0].lxu_cache_state >= 0).any()
+        ):
+            raise AssertionError(
+                "FBGEMM cold forward did not populate the native cache"
+            )
+        reset_and_check_cache(branches[1][0], config)
+        checks.append(
+            {
+                "step": step + 1,
+                "loss": losses[0].item(),
+                "embedding_prediction_and_full_state_parity": True,
+                "reset_branch_metrics": metrics,
+            }
+        )
+        before = snapshots[0]
+    result = {
+        "status": "BOUNDED_SAME_BACKEND_TRAINING_RESTORE_PASS",
+        "independent_run_count": 1,
+        "backend": config.backend,
+        "formal_v7_admitted": False,
+        "independent_optimizer_math_verified": False,
+        "optimizer": config.optimizer,

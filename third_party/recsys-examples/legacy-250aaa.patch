+def paired_interval(ratios):
+    if len(ratios) < 5 or any(
+        not math.isfinite(value) or value <= 0 for value in ratios
+    ):
+        raise ValueError("at least5 independent finite positive pair ratios required")
+    logs = [math.log(value) for value in ratios]
+    generator = random.Random(20261020)
+    samples = sorted(
+        math.exp(statistics.mean(generator.choices(logs, k=len(logs))))
+        for _ in range(10000)
+    )
+    return {
+        "tbe_over_hkv_wall_geomean": math.exp(statistics.mean(logs)),
+        "ci95": [samples[249], samples[9749]],
+        "method": "paired-seed percentile bootstrap of log ratios;10000 fixed resamples; small-n uncertainty",
+        "independent_pairs": len(ratios),
+    }
+
+
+def summarize(records):
+    problems = []
+    pairs = {}
+    processes = set()
+    signatures = set()
+    capacity_signatures = {backend: set() for backend in BACKENDS}
+    hkv_layouts = set()
+    for record in records:
+        if not isinstance(record, dict) or record.get("status") != "complete":
+            problems.append("failed/interrupted run retained")
+            continue
+        try:
+            cell = dict(record["cell"])
+            validated_cell = Cell(**cell)
+            if record["expected_requests"] != cell["batch_size"] * cell["batches"]:
+                raise ValueError("completed count does not match configured trace")
+            seed = cell.pop("seed")
+            if record["format"] != FORMAT or record["state"] not in ("cold", "warm"):
+                raise ValueError("raw format/state mismatch")
+            if record["hardware"].get("uuid") in (None, "", "None", "unavailable"):
+                raise ValueError("physical GPU identity unavailable")
+            backend = record["backend"]
+            if backend == "dynamicemb":
+                hkv_layouts.add(record.get("hkv_layout", "partitioned"))
+            native = record["native"]
+            if (
+                backend not in BACKENDS
+                or native["concrete_type"] != NATIVE_TYPES[backend]
+            ):
+                raise ValueError("not the named actual backend")
+            checked = completed_denominator(
+                record["batches"],
+                record["expected_requests"],
+                record["measurement"]["host_wall_seconds"],
+            )
+            if (
+                checked != record["measurement"]
+                or record["parity"] != "exact"
+                or not native["loaded_objects_sha256"]
+            ):
+                raise ValueError("invalid denominator/parity/native identity")
+            for key in (
+                "backend_module_sha256",
+                "torch_version",
+                "cuda_version",
+                "package_versions",
+                "scaffold_sha256",
+            ):
+                if not native.get(key):
+                    raise ValueError("incomplete backend identity")
+            process = tuple(
+                record["process"][key]
+                for key in ("host", "pid", "boot_id", "start_ticks")
+            )
+            if process in processes or any(value is None for value in process):
+                problems.append("independent process identity missing or repeated")
+            processes.add(process)
+            workload = record.get("workload", workload_spec(validated_cell))
+            signatures.add(
+                json.dumps(
+                    [
+                        cell, workload, record["state"], record["hardware"],
+                        record.get("cuda_event_service") is not None,
+                    ],
+                    sort_keys=True,
+                )
+            )
+            capacity_signatures[backend].add(
+                json.dumps(record.get("native_capacity"), sort_keys=True)
+            )
+            pair = pairs.setdefault(seed, {})
+            if backend in pair:
+                problems.append("duplicate or unsupported backend arm")
+            pair[backend] = record
+            for key in ("input_sha256", "trace_sha256", "weights_sha256"):
+                if not record.get(key):
+                    raise ValueError("missing paired input identity")
+        except (KeyError, TypeError, ValueError):
+            problems.append("invalid completed raw record")
+            continue
+    if len(signatures) != 1:
+        problems.append("mixed cell/state/hardware/event timing mode or no complete run")
+    if any(len(values) > 1 for values in capacity_signatures.values()):
+        problems.append("per-arm native capacity changed across seeds")
+    if len(hkv_layouts) != 1 or not hkv_layouts <= {"partitioned", "shared"}:
+        problems.append("mixed or missing HKV layout across seeds")
+    ratios = []
+    independent_traces = set()
+    backend_identities = {backend: set() for backend in BACKENDS}
+    for pair in pairs.values():
+        if set(pair) != set(BACKENDS):
+            problems.append("missing paired arm")
+            continue
+        hkv, tbe = (pair[backend] for backend in BACKENDS)
+        independent_traces.add(hkv.get("trace_sha256"))
+        if any(
+            hkv.get(key) != tbe.get(key)
+            for key in (
+                "input_sha256",
+                "trace_sha256",
+                "weights_sha256",
+                "expected_requests",
+            )
+        ):
+            problems.append("pair inputs differ")
+        for backend, record in pair.items():
+            native = record["native"]
+            backend_identities[backend].add(
+                json.dumps(
+                    [
+                        native["concrete_type"],
+                        native["backend_module_sha256"],
+                        native["loaded_objects_sha256"],
+                        native["torch_version"],
+                        native["cuda_version"],
+                        native["package_versions"],
+                        native["scaffold_sha256"],
+                    ],
+                    sort_keys=True,
+                )
+            )
+        ratios.append(
+            tbe["measurement"]["host_wall_seconds"]
+            / hkv["measurement"]["host_wall_seconds"]
+        )
+    if any(len(identities) != 1 for identities in backend_identities.values()):
+        problems.append("backend build/scaffold identity changed or missing")
+    if len(ratios) < 5:
+        problems.append("fewer than5 complete independent seed pairs")
+    if len(independent_traces) != len(ratios):
+        problems.append("reused trace across purported independent seeds")
+    return {
+        "format": FORMAT,
+        "hkv_layout": next(iter(hkv_layouts)) if len(hkv_layouts) == 1 else None,
+        "scope": "diagnostic full cache service, never formal V2 admission",
+        "status": "INCOMPLETE" if problems else "DIAGNOSTIC_ONLY",
+        "problems": sorted(set(problems)),
+        "input_records": len(records),
+        "interval": None if problems else paired_interval(ratios),
+        "formal_performance_admitted": False,
+        "open_gates": OPEN_GATES,
+    }
+

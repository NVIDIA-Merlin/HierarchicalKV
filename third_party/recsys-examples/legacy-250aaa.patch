+@dataclass(frozen=True)
+class Cell:
+    seed: int
+    distribution: str = "uniform"
+    target_miss_percent: int = 25
+    occupancy: str = "full-overfill"
+    eviction: str = "lru"
+    cache_rows: int = 1024
+    batch_size: int = 256
+    batches: int = 32
+
+    def __post_init__(self):
+        if not 0 <= self.seed < 2**32:
+            raise ValueError("seed must be in [0, 2**32)")
+        if self.distribution not in ("uniform", "hotset"):
+            raise ValueError("distribution must be uniform or hotset")
+        if self.target_miss_percent not in (0, 25, 75):
+            raise ValueError("target miss must be 0,25,75")
+        if self.occupancy not in ("underfull", "full-overfill"):
+            raise ValueError("occupancy must be underfull or full-overfill")
+        if self.eviction not in ("lru", "lfu"):
+            raise ValueError("native policy must be lru or lfu")
+        if self.cache_rows < 1024 or self.cache_rows % 1024:
+            raise ValueError("logical cache rows must be a positive multiple of1024")
+        if self.batch_size <= 0 or self.batch_size % 4 or self.batches <= 0:
+            raise ValueError("positive batches and batch_size divisible by4 required")
+
+
+def workload_spec(cell, vocab_rows=None):
+    working_rows = (
+        cell.cache_rows // 2 if cell.occupancy == "underfull" else 4 * cell.cache_rows
+    )
+    vocab_rows = 4 * cell.cache_rows if vocab_rows is None else vocab_rows
+    if type(vocab_rows) is not int or vocab_rows < working_rows:
+        raise ValueError(
+            "vocabulary rows must be an integer covering the reference working set"
+        )
+    return {
+        "vocab_rows_per_table": vocab_rows,
+        "reference_cache_rows_per_table": cell.cache_rows,
+        "working_rows_per_table": working_rows,
+    }
+
+
+def capacity_options(
+    cell, backend, vocab_rows=None, cache_rows=None, hkv_layout="partitioned"
+):
+    workload = workload_spec(cell, vocab_rows)
+    vocab = workload["vocab_rows_per_table"]
+    rows = cell.cache_rows if cache_rows is None else cache_rows
+    if backend not in BACKENDS:
+        raise ValueError("unsupported native backend")
+    if type(rows) is not int or not 0 < rows <= vocab:
+        raise ValueError(
+            "native cache rows must be a positive integer no larger than vocabulary"
+        )
+    if hkv_layout == "shared" and (
+        backend != "dynamicemb" or rows != 65536 or vocab != 262144
+    ):
+        raise ValueError("shared HKV candidate requires the frozen 26x65536/262144 cell")
+    explicit = cache_rows is not None or vocab_rows is not None
+    if explicit and backend == "dynamicemb" and (rows < 1024 or rows & (rows - 1)):
+        raise ValueError("DynamicEmb override requires power-of-two rows >=1024")
+    if explicit and backend == "torchrec" and 26 * rows % 32:
+        raise ValueError("TorchRec aggregate cache rows must fill complete32-way sets")
+    payload_bytes = 26 * rows * 128
+    options = {
+        "vocab_sizes": [vocab] * 26,
+        "gpu_ratio": rows / vocab,
+        "hbm_budget_gb": payload_bytes / 1024**3,
+    }
+    if explicit and backend == "torchrec":
+        factory_rows = ((int(26 * vocab * options["gpu_ratio"]) + 31) // 32) * 32
+        if factory_rows != 26 * rows:
+            raise ValueError(
+                "native load-factor rounding cannot express requested cache rows"
+            )
+    return options, {
+        "requested_rows_per_table_equivalent": rows,
+        "requested_total_rows": 26 * rows,
+        "requested_payload_capacity_bytes": payload_bytes,
+        "explicit_controls": explicit,
+        "effective_rows_by_native_partition": None,
+        "effective_total_rows": None,
+        "request_satisfied": None,
+        "matched_total_budget": False,
+        "scope": (
+            "requested payload capacity, not a physical-byte budget; shared HKV "
+            "is a new policy/layout; actual capacity must be observed"
+            if hkv_layout == "shared"
+            else "requested payload capacity, not a physical-byte budget; DynamicEmb "
+            "partitions per table, TorchRec shares one cache; actual capacity "
+            "must be observed"
+        ),
+    }
+
+
+def capacity_observation(request, policy):
+    rows = policy["logical_cache_rows"]
+    per_table = policy["partition"] == "per_table"
+    if (
+        policy["partition"] not in ("per_table", "shared_across_tables")
+        or len(rows) != (26 if per_table else 1)
+        or any(type(value) is not int or value <= 0 for value in rows)
+    ):
+        raise ValueError("native capacity partition is invalid")
+    expected = (
+        [request["requested_rows_per_table_equivalent"]] * 26
+        if per_table
+        else [request["requested_total_rows"]]
+    )
+    return {
+        **request,
+        "partition": policy["partition"],
+        "effective_rows_by_native_partition": rows,
+        "effective_total_rows": sum(rows),
+        "effective_payload_capacity_bytes": sum(rows) * 128,
+        "request_satisfied": rows == expected,
+    }
+
+
+def make_trace(cell, vocab_rows=None):
+    generator = random.Random(cell.seed)
+    workload = workload_spec(cell, vocab_rows)
+    working_rows = workload["working_rows_per_table"]
+    prime_rows = working_rows // 2
+    vocab = workload["vocab_rows_per_table"]
+    permutations = [generator.sample(range(vocab), working_rows) for _ in range(26)]
+    prime = [[keys[index] for keys in permutations] for index in range(prime_rows)]
+    requests = []
+    cold_count = cell.batch_size * cell.target_miss_percent // 100
+    for _ in range(cell.batches):
+        batch = [[0] * 26 for _ in range(cell.batch_size)]
+        for table, keys in enumerate(permutations):
+            pool_flags = [True] * cold_count + [False] * (cell.batch_size - cold_count)
+            generator.shuffle(pool_flags)
+            for row, cold_pool in enumerate(pool_flags):
+                begin, end = (
+                    (prime_rows, working_rows) if cold_pool else (0, prime_rows)
+                )
+                if cell.distribution == "hotset" and generator.random() < 0.8:
+                    end = begin + max(1, (end - begin) // 8)
+                batch[row][table] = keys[generator.randrange(begin, end)]
+        requests.append(batch)
+    return {
+        "prime": prime,
+        "requests": requests,
+        "request_ids": list(range(cell.batch_size * cell.batches)),
+    }
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def tensor_sha256(tensor):
+    return hashlib.sha256(tensor.contiguous().numpy().tobytes()).hexdigest()
+
+
+def prepare(cell, path, *, vocab_rows=None):
+    import torch
+
+    workload = workload_spec(cell, vocab_rows)
+    trace = make_trace(cell, vocab_rows)
+    generator = torch.Generator().manual_seed(cell.seed)
+    weights = [
+        torch.rand((workload["vocab_rows_per_table"], 32), generator=generator)
+        for _ in range(26)
+    ]
+    request_tensor = torch.tensor(trace["requests"], dtype=torch.int64)
+    artifact = {
+        "format": FORMAT,
+        "cell": asdict(cell),
+        "provenance": "controlled synthetic V2 input; not Criteo, trained weights or V7",
+        "weights": weights,
+        "prime": torch.tensor(trace["prime"], dtype=torch.int64),
+        "requests": request_tensor,
+        "request_ids": trace["request_ids"],
+        "weights_sha256": [tensor_sha256(weight) for weight in weights],
+        "trace_sha256": tensor_sha256(request_tensor),
+        "target_scope": "fraction sampled outside reference priming pool; NOT native miss rate",
+    }
+    if vocab_rows is not None:
+        artifact["vocab_rows"] = vocab_rows
+    with Path(path).open("xb") as stream:
+        torch.save(artifact, stream)
+

+def _budget_host_heap_observation(*, allow_f52_local_new=False):
+    import ctypes
+    import sys
+
+    result = {"status": "incomplete", "budget_qualification": "HOLD",
+              "coverage_complete": False, "pid": os.getpid()}
+    try:
+        libc = ctypes.CDLL(None, use_errno=True)
+        libc.fflush.argtypes = [ctypes.c_void_p]
+        libc.fflush.restype = ctypes.c_int
+        libc.open_memstream.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_size_t)]
+        libc.open_memstream.restype = ctypes.c_void_p
+        libc.malloc_info.argtypes = [ctypes.c_int, ctypes.c_void_p]
+        libc.malloc_info.restype = ctypes.c_int
+        libc.fclose.argtypes = [ctypes.c_void_p]
+        libc.fclose.restype = ctypes.c_int
+        libc.free.argtypes = [ctypes.c_void_p]
+        libc.free.restype = None
+        libc.malloc_stats.argtypes = []
+        libc.malloc_stats.restype = None
+        libc.gnu_get_libc_version.argtypes = []
+        libc.gnu_get_libc_version.restype = ctypes.c_char_p
+        version = libc.gnu_get_libc_version().decode("ascii", "strict")
+        if version not in BUDGET_GLIBC_SOURCE_VERSIONS or ctypes.sizeof(ctypes.c_ulong) != 8:
+            raise ValueError("unsupported glibc version/word size")
+        buffer, length = ctypes.c_void_p(), ctypes.c_size_t()
+        stream = libc.open_memstream(ctypes.byref(buffer), ctypes.byref(length))
+        if not stream:
+            raise OSError("open_memstream failed")
+        try:
+            if libc.malloc_info(0, stream) != 0 or libc.fflush(stream) != 0:
+                raise OSError("malloc_info failed")
+            if not 0 < length.value <= 1 << 20:
+                raise ValueError("empty or oversized malloc_info XML")
+            xml = ctypes.string_at(buffer.value, length.value)
+        finally:
+            libc.fclose(stream)
+            if buffer.value:
+                libc.free(buffer)
+        arena = _budget_parse_malloc_info(xml)
+        mmap = _budget_parse_malloc_stats(_budget_capture_c_stderr(libc, libc.malloc_stats))
+        if mmap["arena_count"] != arena["arena_count"] or mmap["mmap_max_bytes"] < arena["mmap_current_bytes"]:
+            raise ValueError("glibc arena count/mmap highwater changed inconsistently")
+        if not hasattr(sys, "_debugmallocstats"):
+            raise ValueError("CPython arena highwater API unavailable")
+        pymalloc = _budget_parse_pymalloc_stats(_budget_capture_c_stderr(libc, sys._debugmallocstats))
+        overcommit = Path("/proc/sys/vm/overcommit_memory").read_text().strip()
+        if overcommit not in {"0", "1", "2"}:
+            raise ValueError("unknown Linux overcommit mode")
+
+        class ArenaAllocator(ctypes.Structure):
+            _fields_ = [("ctx", ctypes.c_void_p), ("alloc", ctypes.c_void_p), ("free", ctypes.c_void_p)]
+        class BlockAllocator(ctypes.Structure):
+            _fields_ = [("ctx", ctypes.c_void_p), ("malloc", ctypes.c_void_p),
+                        ("calloc", ctypes.c_void_p), ("realloc", ctypes.c_void_p),
+                        ("free", ctypes.c_void_p)]
+        ctypes.pythonapi.PyObject_GetArenaAllocator.argtypes = [ctypes.POINTER(ArenaAllocator)]
+        ctypes.pythonapi.PyObject_GetArenaAllocator.restype = None
+        ctypes.pythonapi.PyMem_GetAllocator.argtypes = [ctypes.c_int, ctypes.POINTER(BlockAllocator)]
+        ctypes.pythonapi.PyMem_GetAllocator.restype = None
+        callbacks = ArenaAllocator()
+        ctypes.pythonapi.PyObject_GetArenaAllocator(ctypes.byref(callbacks))
+        domains = {}
+        callback_pointers = {"arena_alloc": callbacks.alloc, "arena_free": callbacks.free}
+        for name, number in (("raw", 0), ("mem", 1), ("obj", 2)):
+            block = BlockAllocator()
+            ctypes.pythonapi.PyMem_GetAllocator(number, ctypes.byref(block))
+            domains[name] = {key: hex(getattr(block, key)) if getattr(block, key) else None
+                             for key in ("malloc", "calloc", "realloc", "free")}
+            callback_pointers.update({f"{name}_{key}": getattr(block, key)
+                                      for key in ("malloc", "calloc", "realloc", "free")})
+        result.update(status="observed_unqualified", glibc_version=version,
+                      glibc=arena, glibc_mmap=mmap, pymalloc=pymalloc,
+                      overcommit_mode=int(overcommit),
+                      prot_none_va_reservation_classified=False,
+                      python_allocator={"arena_alloc": hex(callbacks.alloc) if callbacks.alloc else None,
+                                        "arena_free": hex(callbacks.free) if callbacks.free else None,
+                                        "domains": domains, "PYTHONMALLOC": os.environ.get("PYTHONMALLOC"),
+                                        "baseline_callback_verified": False},
+                      provider_identity=_budget_dso_observation(
+                          libc, callback_pointers,
+                          allow_f52_local_new=allow_f52_local_new))
+    except Exception as error:
+        result["error"] = f"{type(error).__name__}: {error}"
+    return result

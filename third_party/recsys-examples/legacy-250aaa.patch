+        if Path(companion.__file__).resolve() != Path(spec.origin).resolve():
+            raise ValueError("loaded companion path differs from frozen spec")
+        source_root = Path(__file__).resolve().parents[5]
+        recsys_src = source_root / "recsys/corelib/dynamicemb/src"
+        hkv_include = source_root / "hkv/include"
+        rosters, seen = [], set()
+        for role, wrappers in (("cache", tables.caches), ("backing", tables.tables)):
+            for index, wrapper in enumerate(wrappers):
+                if wrapper is None:
+                    continue
+                owner = wrapper.table
+                if id(owner) in seen:
+                    continue
+                seen.add(id(owner))
+                roster = dict(companion.live_roster(owner, str(recsys_src), str(hkv_include)))
+                if (roster.get("schema_version") != 1
+                        or roster.get("native_elf_sha256") != expected_native
+                        or roster.get("identity_enabled") is not False
+                        or roster.get("live_map_counter_consistent") is not True
+                        or roster.get("bookkeeping_complete") is not True
+                        or roster.get("bookkeeping_errors") != 0
+                        or not isinstance(roster.get("live"), list)):
+                    raise ValueError("f52 mode0 companion roster invariant failed")
+                keys = set()
+                for row in roster["live"]:
+                    key = (row.get("type_id"), row.get("pointer"))
+                    if (row.get("type") not in ("device", "pinned", "host", "managed")
+                            or type(row.get("pointer")) is not int or row["pointer"] <= 0
+                            or type(row.get("requested_bytes")) is not int
+                            or row["requested_bytes"] <= 0 or key in keys):
+                        raise ValueError("invalid or duplicate native live allocation row")
+                    keys.add(key)

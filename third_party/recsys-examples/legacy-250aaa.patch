+def requested_allocation_schema_error(stats):
+    if not isinstance(stats, dict) or type(stats.get("schema_version")) is not int:
+        return "missing or invalid schema_version"
+    if stats["schema_version"] != 1:
+        return "unsupported schema_version"
+    if type(stats.get("bookkeeping_complete")) is not bool:
+        return "missing or invalid bookkeeping_complete"
+    for field in (
+        "bookkeeping_errors",
+        "failed_delegate_calls",
+        "direct_curand_requested_bytes",
+    ):
+        if type(stats.get(field)) is not int or stats[field] < 0:
+            return f"missing or invalid {field}"
+    for field in (
+        "physical_bytes",
+        "resident_bytes",
+        "async_pending_bytes",
+        "pool_idle_bytes",
+        "payload_metadata_breakdown",
+    ):
+        if field not in stats or stats[field] is not None:
+            return f"schema1 requires explicit unknown {field}"
+    if not isinstance(stats.get("semantics"), str) or not stats["semantics"]:
+        return "missing semantics"
+    allocator = stats.get("allocator")
+    if not isinstance(allocator, dict) or set(allocator) != {
+        "device",
+        "pinned",
+        "host",
+        "managed",
+    }:
+        return "missing or unsupported allocator categories"
+    for category, counters in allocator.items():
+        if not isinstance(counters, dict):
+            return f"invalid allocator.{category}"
+        for field in (
+            "live_requested_bytes",
+            "current_allocations",
+            "peak_live_requested_bytes",
+            "peak_current_allocations",
+            "async_free_issued_requested_bytes",
+            "async_free_issued_allocations",
+        ):
+            if type(counters.get(field)) is not int or counters[field] < 0:
+                return f"missing or invalid allocator.{category}.{field}"
+        if (
+            counters["peak_live_requested_bytes"] < counters["live_requested_bytes"]
+            or counters["peak_current_allocations"] < counters["current_allocations"]
+        ):
+            return f"inconsistent allocator.{category} peaks"
+    return None
+
+
+def requested_allocation_observation(tables, config):
+    result = {
+        "api": "dynamicemb_extensions.dyn_emb_memory_stats",
+        "status": "not_applicable",
+        "tables": [],
+        "scope": "per-table requested-allocation ledger only; snapshots are not simultaneous; shared handles deduplicated only by identical Python native-table object; live ends at successful free issuance, async-free counts are lifetime cumulative, curand is separate; no sum of category/table peaks or physical/resident/total inference; untracked allocations remain unknown",
+    }
+    if config.backend != "dynamicemb":
+        return result
+    try:
+        import dynamicemb_extensions
+
+        read_stats = getattr(dynamicemb_extensions, "dyn_emb_memory_stats", None)
+        unavailable_reason = "dyn_emb_memory_stats absent or not callable"
+    except ImportError as error:
+        read_stats = None
+        unavailable_reason = f"{type(error).__name__}: {error}"
+    seen = {}
+    native_owners = {}
+    for kind, wrappers in (("cache", tables.caches), ("backing", tables.tables)):
+        for index, wrapper in enumerate(wrappers):
+            record = {"kind": kind, "index": index, "stats": None}
+            handle = getattr(wrapper, "table", None)
+            if handle is None:
+                record.update(status="table_unavailable", error="native table absent")
+            elif not callable(read_stats):
+                record.update(status="api_unavailable", error=unavailable_reason)
+            elif id(handle) in seen:
+                previous = seen[id(handle)][1]
+                record.update(
+                    status="alias",
+                    alias_of={"kind": previous["kind"], "index": previous["index"]},
+                )
+            else:
+                seen[id(handle)] = (handle, record)
+                try:
+                    stats = (
+                        read_stats(handle, include_allocations=True)
+                        if allocation_identities_enabled()
+                        else read_stats(handle)
+                    )
+                except Exception as error:
+                    record.update(
+                        status="call_error", error=f"{type(error).__name__}: {error}"
+                    )
+                else:
+                    try:
+                        json.dumps(stats, allow_nan=False)
+                    except (TypeError, ValueError) as error:
+                        record.update(
+                            status="unsupported_data",
+                            raw_repr=repr(stats),
+                            error=str(error),
+                        )
+                    else:
+                        record["stats"] = stats
+                        if allocation_identities_enabled():
+                            identity = stats.get("allocation_identity")
+                            if not isinstance(identity, dict) or not identity.get(
+                                "recording_enabled"
+                            ):
+                                record["allocation_identity_status"] = "disabled_or_missing"
+                            elif not identity.get("records_complete"):
+                                record["allocation_identity_status"] = "incomplete"
+                            else:
+                                record["allocation_identity_status"] = "recorded_requires_trace_join"
+                                owner = identity["owner_id"]
+                                if owner in native_owners:
+                                    record["native_owner_alias_of"] = native_owners[owner]
+                                else:
+                                    native_owners[owner] = {"kind": kind, "index": index}
+                        error = requested_allocation_schema_error(stats)
+                        if error:
+                            record.update(status="unsupported_data", error=error)
+                        elif (
+                            not stats["bookkeeping_complete"]
+                            or stats["bookkeeping_errors"]
+                        ):
+                            record.update(status="invalid_bookkeeping")
+                        else:
+                            record.update(status="valid_requested_accounting")
+            result["tables"].append(record)
+    primary = [record for record in result["tables"] if record["status"] != "alias"]
+    result["status"] = (
+        "unavailable"
+        if not callable(read_stats)
+        else "observed"
+        if primary
+        and all(record["status"] == "valid_requested_accounting" for record in primary)
+        else "invalid"
+    )
+    return result
+

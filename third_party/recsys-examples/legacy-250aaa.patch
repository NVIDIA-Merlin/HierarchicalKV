+# SPDX-FileCopyrightText: Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Criteo Kaggle data loader for DynamicEmb (HKV) benchmark experiments.
+
+Loads Criteo Kaggle Display Advertising Challenge data (train.txt),
+applies standard preprocessing (log-transform for dense, hashing for sparse),
+and yields batches as (KeyedJaggedTensor, dense_tensor, labels).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+from pathlib import Path
+from typing import TYPE_CHECKING, Generator, Optional, Tuple
+
+import numpy as np
+import torch
+
+from .config import (
+    CRITEO_VOCAB_SIZES,
+    ExperimentConfig,
+    NUM_DENSE_FEATURES,
+    NUM_SPARSE_FEATURES,
+)
+
+logger = logging.getLogger(__name__)
+
+if TYPE_CHECKING:
+    import torchrec
+
+SPARSE_KEYS = [f"cate_{i}" for i in range(NUM_SPARSE_FEATURES)]
+
+
+def _hash_hex_to_int64(hex_str: str) -> int:
+    """Hash a hex string to a stable int64 value."""
+    if not hex_str:
+        return 0
+    return int(hashlib.md5(hex_str.encode()).hexdigest()[:16], 16)
+
+
+def _process_chunk(
+    lines: list,
+    vocab_sizes=CRITEO_VOCAB_SIZES,
+) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """Parse a chunk of TSV lines into labels, dense, sparse arrays."""
+    n = len(lines)
+    labels = np.zeros(n, dtype=np.float32)
+    dense = np.zeros((n, NUM_DENSE_FEATURES), dtype=np.float32)
+    sparse = np.zeros((n, NUM_SPARSE_FEATURES), dtype=np.int64)
+
+    for i, line in enumerate(lines):
+        fields = line.rstrip("\n").split("\t")
+        if len(fields) != 40:
+            raise ValueError("Criteo train.txt requires exactly 40 TSV fields per row")
+        # Label
+        labels[i] = float(fields[0]) if fields[0] else 0.0
+        # Dense features (cols 1-13): fill missing with 0, log(abs(x)+1) transform
+        # Criteo dense values can be negative or extremely large; use abs + log
+        for j in range(NUM_DENSE_FEATURES):
+            val = fields[j + 1] if (j + 1) < len(fields) else ""
+            if val:
+                try:
+                    x = int(val)
+                    dense[i, j] = np.log(abs(x) + 1.0)
+                except (ValueError, OverflowError):
+                    dense[i, j] = 0.0
+            # else: stays 0.0
+        # Sparse features (cols 14-39): hash hex → int64, mod vocab size
+        for j in range(NUM_SPARSE_FEATURES):
+            col = j + 1 + NUM_DENSE_FEATURES
+            hex_str = fields[col] if col < len(fields) else ""
+            hashed = _hash_hex_to_int64(hex_str)
+            sparse[i, j] = hashed % vocab_sizes[j]
+
+    return labels, dense, sparse
+
+
+class CriteoKaggleDataset:
+    """Row-order 80/10/10 split, with synthetic data only by explicit request."""
+
+    def __init__(
+        self,
+        config: ExperimentConfig,
+        use_synthetic: bool = False,
+        synthetic_num_rows: int = 100_000,
+    ):
+        self.config = config
+        self.data_dir = Path(config.criteo_data_dir)
+        self.train_split = config.train_split
+        self.use_synthetic = use_synthetic
+        self.synthetic_num_rows = synthetic_num_rows
+
+        self.labels: Optional[np.ndarray] = None
+        self.dense: Optional[np.ndarray] = None
+        self.sparse: Optional[np.ndarray] = None
+        self.n_train: int = 0
+        self.n_val: int = 0
+        self.source_sha256: Optional[str] = None
+
+        self._load_data()
+        total = len(self.labels)
+        if self.dense.shape != (total, NUM_DENSE_FEATURES) or self.sparse.shape != (
+            total,
+            NUM_SPARSE_FEATURES,
+        ):
+            raise ValueError("Cached feature shapes do not match Criteo rows")
+        if not np.isfinite(self.dense).all() or not np.isin(self.labels, [0, 1]).all():
+            raise ValueError("Criteo requires finite dense values and binary labels")
+        if np.any(self.sparse < 0) or np.any(
+            self.sparse >= np.asarray(config.vocab_sizes)
+        ):
+            raise ValueError("Cached sparse IDs exceed configured vocab sizes")
+        if min(self.num_train, self.num_val, self.num_test) <= 0:
+            raise ValueError(
+                "Data is empty or too small for nonempty train/validation/test splits"
+            )
+
+    # ------------------------------------------------------------------
+    # Data loading
+    # ------------------------------------------------------------------
+
+    def _cache_dir(self) -> Path:
+        identity = json.dumps(
+            ["md5-logabs-v1", self.source_sha256, self.config.vocab_sizes]
+        )
+        return self.data_dir / ".cache" / hashlib.sha256(identity.encode()).hexdigest()
+
+    def _load_data(self):
+        if self.use_synthetic:
+            self._generate_synthetic()
+            return
+
+        source = self.data_dir / "train.txt"
+        if not source.is_file():
+            raise FileNotFoundError(
+                f"Missing {source}; synthetic data requires explicit --synthetic smoke mode"
+            )
+        digest = hashlib.sha256()
+        with source.open("rb") as stream:
+            for block in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(block)
+        self.source_sha256 = digest.hexdigest()
+        if source.stat().st_size == 0:
+            raise ValueError("Criteo train.txt is empty")
+
+        cache = self._cache_dir()
+        if self._cache_exists(cache):
+            logger.info("Loading cached .npy files from %s", cache)
+            self.labels = np.load(cache / "labels.npy", allow_pickle=False)
+            self.dense = np.load(cache / "dense.npy", allow_pickle=False)
+            self.sparse = np.load(cache / "sparse.npy", allow_pickle=False)
+        else:
+            logger.info(
+                "Parsing train.txt from %s (this may take a while)...", self.data_dir
+            )
+            self._parse_tsv()
+            self._save_cache(cache)
+
+        total = len(self.labels)
+        self.n_train = int(total * self.train_split)
+        self.n_val = int(total * self.config.val_split)
+        logger.info(
+            "Loaded %d rows: %d train / %d val",
+            total,
+            self.n_train,
+            total - self.n_train,
+        )
+
+    def _cache_exists(self, cache: Path) -> bool:
+        return all(
+            (cache / f).exists() for f in ("labels.npy", "dense.npy", "sparse.npy")
+        )
+
+    def _save_cache(self, cache: Path):
+        cache.mkdir(parents=True, exist_ok=True)
+        np.save(cache / "labels.npy", self.labels)
+        np.save(cache / "dense.npy", self.dense)
+        np.save(cache / "sparse.npy", self.sparse)
+        logger.info("Saved cache to %s", cache)
+
+    def _parse_tsv(self):
+        """Parse Criteo train.txt in chunks to avoid OOM."""
+        chunk_size = 1_000_000
+        all_labels, all_dense, all_sparse = [], [], []
+
+        filepath = self.data_dir / "train.txt"
+        with open(filepath, "r") as f:
+            while True:
+                lines = []
+                for _ in range(chunk_size):
+                    line = f.readline()
+                    if not line:
+                        break
+                    lines.append(line)
+                if not lines:
+                    break
+                labels, dense, sparse = _process_chunk(lines, self.config.vocab_sizes)
+                all_labels.append(labels)
+                all_dense.append(dense)
+                all_sparse.append(sparse)
+                logger.info(
+                    "Processed %dk rows so far...",
+                    sum(len(l) for l in all_labels) // 1000,
+                )
+
+        self.labels = np.concatenate(all_labels)
+        self.dense = np.concatenate(all_dense)
+        self.sparse = np.concatenate(all_sparse)
+
+    def _generate_synthetic(self):
+        """Generate synthetic data with power-law sparse and normal dense."""
+        n = self.synthetic_num_rows
+        rng = np.random.RandomState(self.config.seed)
+        logger.info("Generating %d synthetic rows...", n)
+
+        self.labels = rng.randint(0, 2, size=n).astype(np.float32)
+        self.dense = rng.randn(n, NUM_DENSE_FEATURES).astype(np.float32)
+
+        # Power-law sparse features: zipf-like distribution per feature
+        self.sparse = np.zeros((n, NUM_SPARSE_FEATURES), dtype=np.int64)
+        for j in range(NUM_SPARSE_FEATURES):
+            vocab = self.config.vocab_sizes[j]
+            # Zipf with clipping to valid vocab range
+            raw = rng.zipf(a=1.3, size=n)
+            self.sparse[:, j] = raw % vocab
+
+        self.n_train = int(n * self.train_split)
+        self.n_val = int(n * self.config.val_split)
+        logger.info(
+            "Synthetic data ready: %d train / %d val", self.n_train, n - self.n_train
+        )
+
+    # ------------------------------------------------------------------
+    # Batch generation
+    # ------------------------------------------------------------------
+
+    def _make_batches(
+        self,
+        start: int,
+        end: int,
+        batch_size: int,
+        device: torch.device,
+    ) -> Generator[
+        Tuple[torchrec.KeyedJaggedTensor, torch.Tensor, torch.Tensor], None, None
+    ]:
+        """Yield (sparse_kjt, dense_tensor, labels) batches."""
+        import torchrec
+
+        for offset in range(start, end, batch_size):
+            bs = min(batch_size, end - offset)
+            sl = slice(offset, offset + bs)
+
+            # Dense + labels → torch
+            dense_t = torch.from_numpy(self.dense[sl]).to(device)
+            labels_t = torch.from_numpy(self.labels[sl]).to(device)
+
+            # Sparse → single-hot KeyedJaggedTensor
+            sparse_np = self.sparse[sl]  # (bs, 26)
+            values_list = []
+            lengths_list = []
+            for j in range(NUM_SPARSE_FEATURES):
+                values_list.append(torch.from_numpy(sparse_np[:, j].copy()))
+                lengths_list.append(torch.ones(bs, dtype=torch.int64))
+
+            values = torch.cat(values_list).to(device)
+            lengths = torch.cat(lengths_list).to(device)
+
+            kjt = torchrec.KeyedJaggedTensor(
+                keys=SPARSE_KEYS,
+                values=values,
+                lengths=lengths,
+            )
+
+            yield kjt, dense_t, labels_t
+
+    def train_batches(
+        self,
+        batch_size: int,
+        device: torch.device = torch.device("cuda"),
+    ) -> Generator[
+        Tuple[torchrec.KeyedJaggedTensor, torch.Tensor, torch.Tensor], None, None
+    ]:
+        """Yield training batches (first train_split fraction of data)."""
+        return self._make_batches(0, self.n_train, batch_size, device)
+
+    def val_batches(
+        self,
+        batch_size: int,
+        device: torch.device = torch.device("cuda"),
+    ) -> Generator[
+        Tuple[torchrec.KeyedJaggedTensor, torch.Tensor, torch.Tensor], None, None
+    ]:
+        """Yield validation batches (last 1-train_split fraction of data)."""
+        return self._make_batches(
+            self.n_train, self.n_train + self.n_val, batch_size, device
+        )
+
+    def test_batches(self, batch_size: int, device: torch.device):
+        return self._make_batches(
+            self.n_train + self.n_val, len(self.labels), batch_size, device
+        )
+
+    def __len__(self) -> int:
+        return len(self.labels) if self.labels is not None else 0
+
+    @property
+    def num_train(self) -> int:
+        return self.n_train
+
+    @property
+    def num_val(self) -> int:
+        return self.n_val
+
+    @property
+    def num_test(self) -> int:
+        return (
+            len(self.labels) - self.n_train - self.n_val
+            if self.labels is not None
+            else 0
+        )
diff --git a/corelib/dynamicemb/benchmark/criteo_experiment/dlrm_model.py b/corelib/dynamicemb/benchmark/criteo_experiment/dlrm_model.py

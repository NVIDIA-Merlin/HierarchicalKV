+    seed_everything,
+)
+from .serving_replay import (
+    CHECKPOINT_VERSION,
+    checkpoint_metadata,
+    cpu_state,
+    validate_checkpoint,
+)
+
+logger = logging.getLogger(__name__)
+
+CSV_COLUMNS = [
+    "iteration",
+    "wall_time_ms",
+    "throughput",
+    "unique_lookup_hit_rate",
+    "loss",
+    "logloss",
+    "auc",
+    "gpu_memory_mb",
+    "stw_event",
+    "stw_duration_ms",
+]
+
+
+def _gpu_memory_used_mb(device_index: int = 0) -> float:
+    return torch.cuda.max_memory_allocated(device_index) / (1024 * 1024)
+
+
+def _get_cache_hit_rate(emb_table, config):
+    metrics = cache_metrics(emb_table, config)
+    count = metrics.get("lookup_keys", 0)
+    return metrics["hits"] / count if count else None
+
+
+def perform_stw_eviction(cache, storage, evict_fraction: float) -> Dict:
+    """Export all entries, rank by LRU, evict bottom fraction, reimport."""
+    from dynamicemb.key_value_table import batched_export_keys_values, load_key_values
+
+    device = cache.device
+    all_keys, all_embs, all_opts, all_scores = [], [], [], []
+    for keys, embs, opts, scores in batched_export_keys_values(cache.table, device):
+        all_keys.append(keys)
+        all_embs.append(embs)
+        all_opts.append(opts)
+        all_scores.append(scores)
+    if not all_keys:
+        return {}
+    keys = torch.cat(all_keys)
+    embs = torch.cat(all_embs)
+    opts = torch.cat(all_opts)
+    scores = torch.cat(all_scores)
+    total = len(keys)
+    if total == 0:
+        return {}
+    num_keep = max(1, int(total * (1.0 - evict_fraction)))
+    _, top_idx = torch.topk(scores.to(torch.int64), num_keep)
+    cache.flush(storage)
+    cache.reset()
+    load_key_values(
+        cache.table,
+        keys[top_idx],
+        embs[top_idx],
+        scores[top_idx],
+        opts[top_idx] if opts.numel() > 0 else None,
+    )
+    return {"entries_before": total, "entries_after": num_keep}
+
+
+def train_criteo(
+    config: ExperimentConfig,
+    use_synthetic: bool = False,
+    manage_distributed: bool = True,
+    checkpoint_out=None,
+) -> None:
+    if int(os.environ.get("WORLD_SIZE", 1)) != 1:
+        raise ValueError("This CTR scaffold supports exactly one process/GPU")
+    dataset = CriteoKaggleDataset(config, use_synthetic=use_synthetic)
+    if checkpoint_out is not None:
+        if use_synthetic or not dataset.source_sha256:
+            raise ValueError(
+                "Trained checkpoint export requires real Criteo data, not synthetic smoke"
+            )
+        if Path(checkpoint_out).exists():
+            raise FileExistsError(checkpoint_out)
+    if manage_distributed:
+        dist.init_process_group(backend="nccl")
+    try:
+        _train_criteo(config, dataset, checkpoint_out)
+    finally:
+        if manage_distributed and dist.is_initialized():
+            dist.destroy_process_group()
+
+
+def save_training_checkpoint(
+    path, config, dataset, tables, model, optimizer, completed_steps, device
+):
+    if dataset.use_synthetic or not dataset.source_sha256:
+        raise ValueError("Trained checkpoint export requires real Criteo data")
+    weights, native = export_native_training_state(tables, config, device)
+    metadata = checkpoint_metadata(
+        config,
+        True,
+        "native training export; constant-zero initialization; bounded training, not converged-model evidence",
+    )
+    metadata.update(
+        dataset_sha256=dataset.source_sha256,
+        data_kind="Criteo train.txt",
+        runtime=json.loads(json.dumps(runtime_manifest(tables, config))),
+    )
+    checkpoint = {
+        "format_version": CHECKPOINT_VERSION,
+        "model_state_dict": cpu_state(model.state_dict()),
+        "embedding_weights": weights,
+        "metadata": metadata,
+        "training_state": {
+            "version": 1,
+            "config": asdict(config),
+            "completed_steps": completed_steps,
+            "native": native,
+            "dense_optimizer": cpu_state(optimizer.state_dict()),
+        },
+    }
+    validate_checkpoint(checkpoint, config)
+    destination = Path(path)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    with destination.open("xb") as stream:
+        torch.save(checkpoint, stream)
+
+
+def _train_criteo(config, dataset, checkpoint_out=None):
+    local_rank = int(os.environ.get("LOCAL_RANK", 0))
+    device = torch.device(f"cuda:{local_rank}")
+    torch.cuda.set_device(device)
+    seed_everything(config.seed)
+
+    # ---- Data ----
+    # ---- Embedding tables ----
+    emb_table = create_embedding_tables(config, device)
+    if checkpoint_out is not None:
+        if dataset.use_synthetic:
+            raise ValueError("Trained checkpoint export forbids synthetic data")
+        initialize_training_backing(emb_table, config, device)
+    if config.caching and config.backend == "dynamicemb":
+        emb_table.set_record_cache_metrics(True)
+
+    # ---- Model ----
+    model = DNN(config.embedding_dim).to(device)
+    optimizer = torch.optim.Adagrad(model.parameters(), lr=config.learning_rate)
+
+    # ---- Output ----
+    output_dir = Path(config.output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    csv_path = output_dir / config.result_filename
+    csv_file = open(csv_path, "x", newline="")
+    writer = csv.DictWriter(csv_file, fieldnames=CSV_COLUMNS)
+    writer.writeheader()
+
+    # ---- Training ----
+    last_auc = None
+    wall_start = time.perf_counter()
+    total_stw_events: List[Dict] = []
+    batch_gen = dataset.train_batches(config.batch_size, device)
+
+    for iteration in range(1, config.num_iterations + 1):
+        # Get next batch (cycle if exhausted)
+        try:
+            sparse_kjt, dense, labels = next(batch_gen)
+        except StopIteration:
+            batch_gen = dataset.train_batches(config.batch_size, device)
+            sparse_kjt, dense, labels = next(batch_gen)
+
+        torch.cuda.synchronize(device)
+        t0 = time.perf_counter()
+        bs = labels.size(0)
+
+        # Forward
+        emb_out = emb_table(sparse_kjt.values(), sparse_kjt.offsets())
+        sparse_flat = flatten_embeddings(emb_out, config, bs)
+        logits = model(sparse_flat, dense)
+        loss = F.binary_cross_entropy_with_logits(logits, labels)
+
+        # Backward + step
+        loss.backward()
+        optimizer.step()
+        optimizer.zero_grad()
+
+        torch.cuda.synchronize(device)
+
+        # ---- STW check ----
+        stw_event = False
+        stw_duration = 0.0
+        if config.stw_mode and config.caching:
+            for ci, cache in enumerate(emb_table.caches):
+                cur = cache.size()
+                cap = cache.capacity()
+                if cap > 0 and cur / cap >= config.stw_threshold:
+                    t_stw = time.perf_counter()
+                    info = perform_stw_eviction(
+                        cache, emb_table.tables[ci], config.stw_evict_fraction
+                    )
+                    torch.cuda.synchronize(device)
+                    stw_ms = (time.perf_counter() - t_stw) * 1000
+                    stw_event = True
+                    stw_duration += stw_ms
+                    total_stw_events.append(
+                        {
+                            "iteration": iteration,
+                            "table": ci,
+                            "duration_ms": stw_ms,
+                            **info,
+                        }
+                    )
+
+        torch.cuda.synchronize(device)
+        iter_ms = (time.perf_counter() - t0) * 1000
+
+        # ---- Logging ----
+        if iteration % config.log_interval == 0 or iteration == 1:
+            throughput = bs / (iter_ms / 1000) if iter_ms > 0 else 0
+            chr_val = _get_cache_hit_rate(emb_table, config) if config.caching else None
+            gpu_mem = _gpu_memory_used_mb(local_rank)
+            writer.writerow(
+                {
+                    "iteration": iteration,
+                    "wall_time_ms": f"{iter_ms:.2f}",
+                    "throughput": f"{throughput:.1f}",
+                    "unique_lookup_hit_rate": f"{chr_val:.4f}"
+                    if chr_val is not None
+                    else "",
+                    "loss": f"{loss.item():.6f}",
+                    "logloss": f"{loss.item():.6f}",
+                    "auc": f"{last_auc:.4f}" if last_auc is not None else "",
+                    "gpu_memory_mb": f"{gpu_mem:.1f}",
+                    "stw_event": 1 if stw_event else 0,
+                    "stw_duration_ms": f"{stw_duration:.2f}",
+                }
+            )
+            csv_file.flush()
+
+        # ---- Periodic eval ----
+        if iteration % config.eval_interval == 0:
+            model.eval()
+            emb_table.eval()
+            all_logits, all_labels = [], []
+            with torch.no_grad():
+                for kjt2, d2, l2 in dataset.val_batches(config.batch_size, device):
+                    bs2 = l2.size(0)
+                    eo2 = emb_table(kjt2.values(), kjt2.offsets())
+                    sf2 = flatten_embeddings(eo2, config, bs2)
+                    lo2 = model(sf2, d2)
+                    all_logits.append(lo2)
+                    all_labels.append(l2)
+            if all_logits:
+                last_auc = compute_auc(torch.cat(all_logits), torch.cat(all_labels))
+            model.train()
+            emb_table.train()
+            logger.info("iter %d | AUC=%.4f", iteration, last_auc)
+
+    csv_file.close()
+
+    # ---- Summary ----
+    wall_total = time.perf_counter() - wall_start
+    if checkpoint_out is not None:
+        save_training_checkpoint(
+            checkpoint_out,
+            config,
+            dataset,
+            emb_table,
+            model,
+            optimizer,
+            config.num_iterations,
+            device,
+        )
+    summary = {
+        "status": "DEVELOPMENT_TRAINING_ONLY",
+        "model": "CTR DNN; concat plus MLP, no DLRM interaction",
+        "seed": config.seed,
+        "independent_run_count": 1,
+        "config": asdict(config),
+        "runtime": runtime_manifest(emb_table, config),
+        "dataset_sha256": dataset.source_sha256,
+        "data_kind": "explicit synthetic smoke"
+        if dataset.use_synthetic
+        else "Criteo train.txt",
+        "split_rows": [dataset.num_train, dataset.num_val, dataset.num_test],
+        "embedding_initialization": "constant zero for both backends; seed controls model/data, not native random initialization",
+        "timing_scope": "training forward/backward/optimizer plus STW maintenance and terminal CUDA completion; excludes batch preparation/H2D, evaluation, logging, network; not serving latency",
+        "memory_scope": "PyTorch peak allocated bytes only, not total HBM or a matched budget",
+        "stw_scope": "optional host-coordinated cache maintenance in addition to native continuous eviction; flushes backing before reset",
+        "cache_metrics_scope": "DynamicEmb last per-table unique lookup, instrumented host synchronization; FBGEMM unavailable, not a matched hit-rate comparison",
+        "training_update_and_optimizer_restore_gate": "NOT_RUN",
+        "trained_checkpoint": str(checkpoint_out)
+        if checkpoint_out is not None
+        else None,
+        "checkpoint_scope": "opt-in full native embedding/optimizer backing plus dense Adagrad; initialization/export excluded from iteration timing and wall_time_s; no convergence or optimizer-correctness claim",
+        "config_id": config.config_id,
+        "embedding_dim": config.embedding_dim,
+        "hbm_budget_gb": config.hbm_budget_gb,
+        "stw_mode": config.stw_mode,
+        "num_iterations": config.num_iterations,
+        "final_auc": last_auc,
+        "wall_time_s": round(wall_total, 2),
+        "gpu_memory_peak_mb": round(_gpu_memory_used_mb(local_rank), 1),
+        "total_stw_events": len(total_stw_events),
+        "total_stw_time_ms": round(sum(e["duration_ms"] for e in total_stw_events), 1),
+    }
+    with open(output_dir / f"{config.run_id}_summary.json", "x") as f:
+        json.dump(summary, f, indent=2)
+    if total_stw_events:
+        with open(output_dir / f"{config.run_id}_stw_events.json", "x") as f:
+            json.dump(total_stw_events, f, indent=2)
+
+
+if __name__ == "__main__":
+    import argparse
+
+    logging.basicConfig(
+        level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s"
+    )
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--config", type=str, default="HKV-CE")
+    parser.add_argument("--synthetic", action="store_true")
+    parser.add_argument("--output_dir", type=str, default="results")
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--data-dir", default="data/criteo-kaggle")
+    parser.add_argument("--checkpoint-out")
+    parser.add_argument("--steps", type=int)
+    parser.add_argument("--batch-size", type=int)
+    parser.add_argument("--vocab-size", type=int)
+    parser.add_argument("--embedding-dim", type=int)
+    parser.add_argument("--backing-capacity-factor", type=int)
+    parser.add_argument("--hbm-budget-gb", type=float)
+    parser.add_argument("--gpu-ratio", type=float)
+    parser.add_argument(
+        "--optimizer",
+        choices=["exact_sgd", "adam", "exact_adagrad", "exact_row_wise_adagrad"],
+    )
+    args = parser.parse_args()
+    from .config import ALL_CONFIGS
+
+    overrides = {
+        "seed": args.seed,
+        "criteo_data_dir": args.data_dir,
+        "output_dir": args.output_dir,
+    }
+    for name in (
+        "batch_size",
+        "embedding_dim",
+        "backing_capacity_factor",
+        "hbm_budget_gb",
+        "gpu_ratio",
+        "optimizer",
+    ):
+        if getattr(args, name) is not None:
+            overrides[name] = getattr(args, name)
+    if args.steps is not None:
+        overrides["num_iterations"] = args.steps
+    if args.vocab_size is not None:
+        overrides["vocab_sizes"] = [args.vocab_size] * 26
+    config = replace(ALL_CONFIGS[args.config](), **overrides)
+    train_criteo(
+        config, use_synthetic=args.synthetic, checkpoint_out=args.checkpoint_out
+    )

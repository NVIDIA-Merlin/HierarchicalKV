+
+
+ALL_CONFIGS = {
+    "BASELINE-UNLIMITED": baseline_unlimited,
+    "HKV-CE": hkv_ce,
+    "HKV-LFU": hkv_lfu,
+    "STW-BASELINE": stw_baseline,
+    "HKV-CE-1G": hkv_ce_1g,
+    "STW-BASELINE-1G": stw_baseline_1g,

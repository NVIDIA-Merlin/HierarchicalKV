+def test_bounded_matrix_trace(distribution, occupancy, target):
+    cell = comparison.Cell(17, distribution, target, occupancy, batch_size=8, batches=2)
+    trace = comparison.make_trace(cell)
+    for table in range(26):
+        primed = {row[table] for row in trace["prime"]}
+        requested = {row[table] for batch in trace["requests"] for row in batch}
+        assert all(0 <= key < cell.cache_rows * 4 for key in primed | requested)
+        if occupancy == "underfull":
+            assert len(primed | requested) <= cell.cache_rows // 2
+        else:
+            assert len(primed) > cell.cache_rows
+        for batch in trace["requests"]:
+            assert (
+                sum(row[table] not in primed for row in batch)
+                == target * cell.batch_size // 100

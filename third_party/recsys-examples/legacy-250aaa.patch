+            "optimizer_rows": [torch.zeros(2, 4 if has_rows else 0)],
+        },
+        "model": {"weight": torch.zeros(2)},
+        "dense_optimizer": {"state": {0: {"step": torch.tensor(4.0)}}},
+    }
+    after = copy.deepcopy(before)
+    after["weights"][0].add_(1)
+    after["native"]["optimizer_rows"][0].add_(1)
+    after["model"]["weight"].add_(1)
+    after["dense_optimizer"]["state"][0]["step"].add_(1)
+    for name in ("iter", "iter_cpu"):
+        after["native"]["globals"][name].add_(increment)
+    assert_update_occurred(before, after)
+    if fault in ("iter", "iter_cpu"):
+        after["native"]["globals"][fault].add_(1 if increment == 0 else -1)
+    elif fault == "weights":
+        after["weights"] = copy.deepcopy(before["weights"])
+    elif fault == "optimizer_rows":
+        after["native"]["optimizer_rows"] = copy.deepcopy(
+            before["native"]["optimizer_rows"]
+        )
+    elif fault == "model":
+        after["model"] = copy.deepcopy(before["model"])
+    elif fault == "dense_step":
+        after["dense_optimizer"] = copy.deepcopy(before["dense_optimizer"])
+    if fault is None or (fault == "optimizer_rows" and not has_rows):
+        assert_update_occurred(before, after)
+    else:
+        with pytest.raises(AssertionError):
+            assert_update_occurred(before, after)
+
+    corrupt_restore = copy.deepcopy(before)
+    corrupt_restore["native"]["globals"]["iter_cpu"].add_(1)
+    with pytest.raises(AssertionError):
+        assert_state_close(corrupt_restore, before, exact=True)

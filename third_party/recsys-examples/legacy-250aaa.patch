+def _budget_cuda_pool_high_observation(device, old_endpoints):
+    import ctypes
+
+    result = {"status": "incomplete", "budget_qualification": "HOLD",
+              "coverage_complete": False, "pid": os.getpid(), "device_id": device}
+    try:
+        cuda = ctypes.CDLL("libcudart.so.12")
+        cuda.cudaGetDevice.argtypes = [ctypes.POINTER(ctypes.c_int)]
+        cuda.cudaGetDevice.restype = ctypes.c_int
+        for name in ("cudaDeviceGetMemPool", "cudaDeviceGetDefaultMemPool"):
+            fn = getattr(cuda, name)
+            fn.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_int]
+            fn.restype = ctypes.c_int
+        cuda.cudaMemPoolGetAttribute.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p]
+        cuda.cudaMemPoolGetAttribute.restype = ctypes.c_int
+        cuda.cudaRuntimeGetVersion.argtypes = [ctypes.POINTER(ctypes.c_int)]
+        cuda.cudaRuntimeGetVersion.restype = ctypes.c_int
+        actual, version = ctypes.c_int(), ctypes.c_int()
+        if cuda.cudaGetDevice(ctypes.byref(actual)) or actual.value != device or cuda.cudaRuntimeGetVersion(ctypes.byref(version)):
+            raise ValueError("CUDA device/runtime query failed")
+        queries = []
+        for role, getter in (("current", cuda.cudaDeviceGetMemPool),
+                             ("default", cuda.cudaDeviceGetDefaultMemPool)):
+            handle = ctypes.c_void_p()
+            if getter(ctypes.byref(handle), device) or not handle.value:
+                raise ValueError("CUDA pool handle query failed: " + role)
+            fields = {}
+            for key, attribute in (("reserved_current_bytes", 0x5), ("reserved_high_bytes", 0x6),
+                                   ("used_current_bytes", 0x7), ("used_high_bytes", 0x8)):
+                amount = ctypes.c_uint64()
+                if cuda.cudaMemPoolGetAttribute(handle, attribute, ctypes.byref(amount)):
+                    raise ValueError("CUDA pool attribute failed: " + key)
+                fields[key] = amount.value
+            queries.append({"role": role, "handle_hex": hex(handle.value), **fields})
+        current, default = queries
+        same = current["handle_hex"] == default["handle_hex"]
+        old = old_endpoints.get("queries", []) if isinstance(old_endpoints, dict) else []
+        old_same = (None if old_endpoints is None else
+                    (len(old) == 2 and old[0].get("pool_handle_hex") == current["handle_hex"]
+                     and old[1].get("pool_handle_hex") == default["handle_hex"]))
+        consistent = all(q["used_current_bytes"] <= q["reserved_current_bytes"] <= q["reserved_high_bytes"]
+                         and q["used_current_bytes"] <= q["used_high_bytes"] <= q["reserved_high_bytes"]
+                         for q in queries)
+        result.update(status="observed_unqualified", cuda_runtime_version=version.value,
+                      queries=queries, current_default_same_handle=same,
+                      matches_existing_native_probe=old_same, counter_invariants=consistent,
+                      provider_lifetime_alias_verified=False)
+    except Exception as error:
+        result["error"] = f"{type(error).__name__}: {error}"
+    return result
+

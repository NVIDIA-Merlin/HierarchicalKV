diff --git a/corelib/dynamicemb/test/unit_tests/memory_accounting_test.cu b/corelib/dynamicemb/test/unit_tests/memory_accounting_test.cu
new file mode 100644
index 0000000..1ecb96b
--- /dev/null
+++ b/corelib/dynamicemb/test/unit_tests/memory_accounting_test.cu
@@ -0,0 +1,424 @@
+#include "accounting_allocator.cuh"
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+using nv::merlin::MemoryType;
+
+static void require(bool condition) {
+  if (!condition) {
+    throw std::runtime_error("allocation accounting expectation failed");
+  }
+}
+
+class FakeAllocator : public nv::merlin::BaseAllocator {
+public:
+  void *next = nullptr;
+  bool fail = false;
+  bool heap = false;
+  unsigned int flags = 0;
+  cudaStream_t stream = nullptr;
+  MemoryType last_type = nv::merlin::Host;
+  size_t calls = 0;
+
+  void alloc(MemoryType type, void **ptr, size_t size,
+             unsigned int pinned_flags = cudaHostAllocDefault) override {
+    ++calls;
+    last_type = type;
+    flags = pinned_flags;
+    if (fail) {
+      throw std::runtime_error("fake allocation failure");
+    }
+    *ptr = heap ? std::malloc(size == 0 ? 1 : size) : next;
+  }
+
+  void alloc_async(MemoryType type, void **ptr, size_t size,
+                   cudaStream_t requested_stream) override {
+    stream = requested_stream;
+    alloc(type, ptr, size);
+  }
+
+  void free(MemoryType type, void *ptr) override {
+    ++calls;
+    last_type = type;
+    if (fail) {
+      throw std::runtime_error("fake free failure");
+    }
+    if (heap) {
+      std::free(ptr);
+    }
+  }
+
+  void free_async(MemoryType type, void *ptr,
+                  cudaStream_t requested_stream) override {
+    stream = requested_stream;
+    free(type, ptr);
+  }
+};
+
+static void categories_and_reuse() {
+  FakeAllocator fake;
+  dyn_emb::AccountingAllocator allocator(fake);
+  char storage;
+  fake.next = &storage;
+  for (auto type : {nv::merlin::Device, nv::merlin::Pinned,
+                    nv::merlin::Host, nv::merlin::Managed}) {
+    void *ptr = nullptr;
+    allocator.alloc(type, &ptr, 64, cudaHostAllocMapped);
+    require(ptr == &storage && fake.last_type == type && fake.flags == cudaHostAllocMapped);
+    const auto live = allocator.snapshot().categories[type];
+    require(live.live_requested_bytes == 64 && live.current_allocations == 1);
+    allocator.free(type, ptr);
+    allocator.alloc(type, &ptr, 16);
+    const auto reused = allocator.snapshot().categories[type];
+    require(reused.live_requested_bytes == 16 && reused.peak_live_requested_bytes == 64);
+    allocator.free(type, ptr);
+  }
+  const auto calls = fake.calls;
+  require(allocator.snapshot().bookkeeping_complete);
+  require(fake.calls == calls);
+}
+
+static void asynchronous_issuance() {
+  FakeAllocator fake;
+  dyn_emb::AccountingAllocator allocator(fake);
+  char storage;
+  fake.next = &storage;
+  auto stream = reinterpret_cast<cudaStream_t>(&storage);
+  void *ptr = nullptr;
+  allocator.alloc_async(nv::merlin::Device, &ptr, 128, stream);
+  require(fake.stream == stream);
+  fake.fail = true;
+  try {
+    allocator.free_async(nv::merlin::Device, ptr, stream);
+    require(false);
+  } catch (const std::runtime_error &error) {
+    require(std::string(error.what()) == "fake free failure");
+  }
+  require(allocator.snapshot().categories[nv::merlin::Device].live_requested_bytes == 128);
+  fake.fail = false;
+  allocator.free_async(nv::merlin::Device, ptr, stream);
+  const auto retired = allocator.snapshot().categories[nv::merlin::Device];
+  require(retired.live_requested_bytes == 0 && retired.current_allocations == 0);
+  require(retired.async_free_issued_requested_bytes == 128 && retired.async_free_issued_allocations == 1);
+  allocator.alloc_async(nv::merlin::Device, &ptr, 32, stream);
+  const auto reused = allocator.snapshot().categories[nv::merlin::Device];
+  require(reused.live_requested_bytes == 32 && reused.async_free_issued_requested_bytes == 128);
+  allocator.free(nv::merlin::Device, ptr);
+}
+
+static void null_zero_failure() {
+  FakeAllocator fake;
+  dyn_emb::AccountingAllocator allocator(fake);
+  void *ptr = nullptr;
+  allocator.alloc(nv::merlin::Host, &ptr, 64);
+  allocator.free(nv::merlin::Host, nullptr);
+  require(allocator.snapshot().categories[nv::merlin::Host].current_allocations == 0);
+  char storage;
+  fake.next = &storage;
+  allocator.alloc(nv::merlin::Host, &ptr, 0);
+  require(allocator.snapshot().categories[nv::merlin::Host].current_allocations == 1);
+  fake.fail = true;
+  try {
+    allocator.free(nv::merlin::Host, ptr);
+    require(false);
+  } catch (const std::runtime_error &error) {
+    require(std::string(error.what()) == "fake free failure");
+  }
+  try {
+    allocator.alloc(nv::merlin::Host, &ptr, 32);
+    require(false);
+  } catch (const std::runtime_error &error) {
+    require(std::string(error.what()) == "fake allocation failure");
+  }
+  require(allocator.snapshot().failed_delegate_calls == 2);
+  require(allocator.snapshot().categories[nv::merlin::Host].current_allocations == 1);
+  fake.fail = false;
+  allocator.free(nv::merlin::Host, ptr);
+  require(allocator.snapshot().bookkeeping_complete);
+}
+
+static void inconsistent_delegate() {
+  FakeAllocator fake;
+  dyn_emb::AccountingAllocator allocator(fake);
+  char storage;
+  fake.next = &storage;
+  void *ptr = nullptr;
+  allocator.alloc(nv::merlin::Host, &ptr, 16);
+  allocator.alloc(nv::merlin::Host, &ptr, 32);
+  allocator.free(nv::merlin::Device, ptr);
+  auto stats = allocator.snapshot();
+  require(!stats.bookkeeping_complete && stats.bookkeeping_errors == 2);
+  require(stats.categories[nv::merlin::Host].live_requested_bytes == 16);
+  allocator.free(nv::merlin::Host, ptr);
+  allocator.free(nv::merlin::Host, ptr);
+  require(allocator.snapshot().bookkeeping_errors == 3);
+}
+
+static void owner_lifetime_and_concurrency() {
+  FakeAllocator fake;
+  fake.heap = true;
+  {
+    dyn_emb::AccountingAllocator allocator(fake);
+    std::vector<std::thread> workers;
+    for (size_t worker = 0; worker < 4; ++worker) {
+      workers.emplace_back([&allocator] {
+        for (size_t iteration = 0; iteration < 100; ++iteration) {
+          void *ptr = nullptr;
+          allocator.alloc(nv::merlin::Host, &ptr, 64);
+          allocator.snapshot();
+          allocator.free(nv::merlin::Host, ptr);
+        }
+      });
+    }
+    for (auto &worker : workers) {
+      worker.join();
+    }
+    const auto stats = allocator.snapshot();
+    require(stats.bookkeeping_complete && stats.categories[nv::merlin::Host].current_allocations == 0);
+    require(stats.categories[nv::merlin::Host].live_requested_bytes == 0);
+  }
+  require(fake.calls == 800);
+}
+
+static void identity_events_and_generations() {
+  setenv("DYNAMICEMB_ALLOCATION_IDENTITIES", "1", 1);
+  FakeAllocator fake;
+  dyn_emb::AccountingAllocator allocator(fake);
+  allocator.set_device_id(3);
+  char storage;
+  fake.next = &storage;
+  void *pointer = nullptr;
+  allocator.alloc(nv::merlin::Host, &pointer, 32);
+  fake.fail = true;
+  bool failed = false;
+  try {
+    allocator.free(nv::merlin::Host, pointer);
+  } catch (const std::runtime_error &) {
+    failed = true;
+  }
+  require(failed);
+  require(allocator.snapshot(true).identity.events.size() == 1);
+  fake.fail = false;
+  allocator.free(nv::merlin::Host, pointer);
+  allocator.alloc_async(nv::merlin::Device, &pointer, 16, nullptr);
+  allocator.free_async(nv::merlin::Device, pointer, nullptr);
+  const auto stats = allocator.snapshot(true);
+  const auto &events = stats.identity.events;
+  require(stats.identity.enabled && stats.identity.complete &&
+          stats.identity.device_id == 3);
+  require(events.size() == 4 && events[0].pointer == events[2].pointer);
+  require(events[0].generation == events[1].generation);
+  require(events[2].generation == events[3].generation);
+  require(events[0].generation != events[2].generation);
+  require(!events[0].host_extent_known && events[1].free_issued);
+  require(events[2].asynchronous && events[3].asynchronous &&
+          events[3].free_issued);
+  require(events[0].begin_ns <= events[0].end_ns);
+  require(events[1].sequence < events[2].sequence);
+  require(!allocator.snapshot().identity.enabled);
+  require(stats.categories[nv::merlin::Host].live_requested_bytes == 0);
+  require(
+      stats.categories[nv::merlin::Device].async_free_issued_requested_bytes ==
+      16);
+  allocator.identity_state()->incomplete();
+  require(!allocator.snapshot(true).identity.complete);
+  unsetenv("DYNAMICEMB_ALLOCATION_IDENTITIES");
+}
+
+static void identity_known_host_and_external() {
+  setenv("DYNAMICEMB_ALLOCATION_IDENTITIES", "1", 1);
+  dyn_emb::AccountingAllocator allocator;
+  void *pointer = nullptr;
+  allocator.alloc(nv::merlin::Host, &pointer, 37);
+  const auto host = allocator.snapshot(true).identity.events.front();
+#if defined(__GLIBC__)
+  require(host.host_extent_known && host.host_usable_bytes >= 37);
+#endif
+  allocator.free(nv::merlin::Host, pointer);
+  char direct;
+  allocator.record_external_allocation(&direct, 128, nullptr, 10, 20);
+  require(allocator.snapshot(true)
+              .categories[nv::merlin::Device]
+              .current_allocations == 0);
+  allocator.record_external_free(&direct, 30, 40);
+  const auto events = allocator.snapshot(true).identity.events;
+  require(events.size() == 4 &&
+          std::string(events[2].origin) == "direct_curand");
+  require(events[2].generation == events[3].generation &&
+          events[3].free_issued);
+  unsetenv("DYNAMICEMB_ALLOCATION_IDENTITIES");
+}
+
+static void identity_control_block_lifetime() {
+  setenv("DYNAMICEMB_ALLOCATION_IDENTITIES", "1", 1);
+  struct Owned {
+    dyn_emb::AccountingAllocator allocator;
+  };
+  auto state = std::make_shared<dyn_emb::AllocationIdentityState>();
+  std::weak_ptr<Owned> weak;
+  {
+    dyn_emb::AllocationConstructionScope scope(state);
+    auto owned = std::allocate_shared<Owned>(
+        dyn_emb::AllocationControlBlockAllocator<Owned>{});
+    require(owned->allocator.identity_state() == state);
+    weak = owned;
+    require(state->snapshot().events.size() == 1);
+  }
+  require(weak.expired());
+  require(state->snapshot().events.size() == 1);
+  require(!dyn_emb::construction_identity);
+  weak.reset();
+  const auto events = state->snapshot().events;
+  require(events.size() == 2 && events[1].free_issued);
+  require(events[0].generation == events[1].generation);
+  require(events[0].pointer == events[1].pointer);
+  {
+    dyn_emb::AllocationConstructionScope scope(state);
+    require(dyn_emb::construction_identity == state);
+  }
+  require(!dyn_emb::construction_identity);
+  struct Failing {
+    Failing() { throw std::runtime_error("constructor failure"); }
+  };
+  auto failure_state = std::make_shared<dyn_emb::AllocationIdentityState>();
+  bool construction_failed = false;
+  try {
+    dyn_emb::AllocationConstructionScope scope(failure_state);
+    std::allocate_shared<Failing>(
+        dyn_emb::AllocationControlBlockAllocator<Failing>{});
+  } catch (const std::runtime_error &) {
+    construction_failed = true;
+  }
+  const auto failure_events = failure_state->snapshot().events;
+  require(construction_failed && !dyn_emb::construction_identity);
+  require(failure_events.size() == 2 && failure_events[1].free_issued);
+  require(failure_events[0].generation == failure_events[1].generation);
+  require(failure_events[0].pointer == failure_events[1].pointer);
+  unsetenv("DYNAMICEMB_ALLOCATION_IDENTITIES");
+  dyn_emb::AccountingAllocator disabled;
+  require(!disabled.snapshot(true).identity.enabled);
+}
+
+static void identity_control_block_nested_owners() {
+  struct Nested {
+    std::shared_ptr<int> child;
+    Nested(const std::shared_ptr<dyn_emb::AllocationIdentityState> &child_state) {
+      dyn_emb::AllocationConstructionScope scope(child_state);
+      child = std::allocate_shared<int>(
+          dyn_emb::AllocationControlBlockAllocator<int>{}, 7);
+    }
+  };
+  auto parent_state = std::make_shared<dyn_emb::AllocationIdentityState>();
+  auto child_state = std::make_shared<dyn_emb::AllocationIdentityState>();
+  std::weak_ptr<int> child_weak;
+  {
+    dyn_emb::AllocationConstructionScope scope(parent_state);
+    auto parent = std::allocate_shared<Nested>(
+        dyn_emb::AllocationControlBlockAllocator<Nested>{}, child_state);
+    require(dyn_emb::construction_identity == parent_state);
+    child_weak = parent->child;
+    require(*parent->child == 7);
+  }
+  require(!dyn_emb::construction_identity && child_weak.expired());
+  require(parent_state->snapshot().events.size() == 2);
+  require(child_state->snapshot().events.size() == 1);
+  require(parent_state->owner_id != child_state->owner_id);
+  std::weak_ptr<dyn_emb::AllocationIdentityState> state_weak = child_state;
+  child_state.reset();
+  require(!state_weak.expired());
+  child_weak.reset();
+  require(state_weak.expired());
+}
+
+static void identity_control_block_registry_reuse() {
+  auto state = std::make_shared<dyn_emb::AllocationIdentityState>();
+  dyn_emb::AllocationConstructionScope scope(state);
+  std::map<uintptr_t, uint64_t> generations;
+  size_t observed_reuse = 0;
+  for (size_t iteration = 0; iteration < 16; ++iteration) {
+    auto first = std::allocate_shared<int>(
+        dyn_emb::AllocationControlBlockAllocator<int>{}, 3);
+    auto second = std::allocate_shared<int>(
+        dyn_emb::AllocationControlBlockAllocator<int>{}, 5);
+    const auto before_free = state->snapshot().events;
+    const auto first_record = before_free[before_free.size() - 2];
+    const auto second_record = before_free.back();
+    require(first_record.pointer != second_record.pointer);
+    first.reset();
+    second.reset();
+    const auto events = state->snapshot().events;
+    const auto first_free = events[events.size() - 2];
+    const auto second_free = events.back();
+    require(first_free.pointer == first_record.pointer && first_free.free_issued);
+    require(second_free.pointer == second_record.pointer && second_free.free_issued);
+    require(first_free.generation == first_record.generation);
+    require(second_free.generation == second_record.generation);
+    for (const auto &record : {first_record, second_record}) {
+      const auto previous = generations.find(record.pointer);
+      if (previous != generations.end()) {
+        require(previous->second != record.generation);
+        ++observed_reuse;
+      }
+      generations[record.pointer] = record.generation;
+    }
+  }
+  require(state->snapshot().complete);
+  std::cout << "control-block actual pointer reuse observations=" << observed_reuse
+            << '\n';
+}
+
+static void identity_control_block_layout_and_concurrency() {
+  dyn_emb::verify_control_block_layout<int>();
+  static_assert(std::is_empty<dyn_emb::AllocationControlBlockAllocator<int>>::value);
+  static_assert(std::allocator_traits<
+                dyn_emb::AllocationControlBlockAllocator<int>>::is_always_equal::value);
+  std::vector<std::thread> workers;
+  for (size_t worker = 0; worker < 4; ++worker) {
+    workers.emplace_back([] {
+      auto state = std::make_shared<dyn_emb::AllocationIdentityState>();
+      for (size_t iteration = 0; iteration < 16; ++iteration) {
+        dyn_emb::AllocationConstructionScope scope(state);
+        auto owned = std::allocate_shared<int>(
+            dyn_emb::AllocationControlBlockAllocator<int>{}, 17);
+        const auto record = state->snapshot().events.back();
+        require(*owned == 17);
+#if defined(__GLIBC__)
+        require(record.host_extent_known);
+        require(record.host_usable_bytes ==
+                malloc_usable_size(reinterpret_cast<void *>(record.pointer)));
+        require(record.host_usable_bytes >= record.requested_bytes);
+#endif
+      }
+      require(!dyn_emb::construction_identity);
+      const auto events = state->snapshot().events;
+      require(events.size() == 32 && state->snapshot().complete);
+      for (size_t index = 0; index < events.size(); index += 2) {
+        require(events[index].pointer == events[index + 1].pointer);
+        require(events[index].generation == events[index + 1].generation);
+        require(!events[index].free_issued && events[index + 1].free_issued);
+      }
+    });
+  }
+  for (auto &worker : workers) {
+    worker.join();
+  }
+}

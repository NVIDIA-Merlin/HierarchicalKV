+# SPDX-FileCopyrightText: Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""CTR DNN experiment presets; requested budgets are not matched allocations."""
+
+from dataclasses import dataclass, field
+from typing import List, Optional
+
+
+# Criteo Kaggle Display Advertising Challenge: 26 sparse feature vocab sizes
+CRITEO_VOCAB_SIZES: List[int] = [
+    45833188,
+    36746,
+    17245,
+    7413,
+    20243,
+    3,
+    7114,
+    1441,
+    62,
+    29275261,
+    1572176,
+    345138,
+    10,
+    2209,
+    11267,
+    128,
+    4,
+    974,
+    14,
+    48937457,
+    11316796,
+    40094537,
+    452104,
+    12606,
+    104,
+    35,
+]
+
+NUM_DENSE_FEATURES = 13
+NUM_SPARSE_FEATURES = 26
+
+
+def shared_hkv_key(table_id: int, local_id: int, vocab_rows: int) -> int:
+    """Map one bounded logical-table key into a shared int64 key space."""
+    if vocab_rows <= 0 or not 0 <= table_id < NUM_SPARSE_FEATURES or not 0 <= local_id < vocab_rows:
+        raise ValueError("shared HKV table/key outside the frozen vocabulary")
+    key = table_id * vocab_rows + local_id
+    if key >= (1 << 63) - 3:
+        raise ValueError("shared HKV key reaches the reserved int64 range")
+    return key
+
+
+def split_shared_hkv_key(key: int, vocab_rows: int) -> tuple[int, int]:
+    """Recover the logical table and local key for diagnostics and oracles."""
+    if vocab_rows <= 0 or not 0 <= key < NUM_SPARSE_FEATURES * vocab_rows:
+        raise ValueError("shared HKV key outside the frozen vocabulary")
+    return divmod(key, vocab_rows)
+
+
+def shared_hkv_weight_chunks(vocab_rows: int, chunk_rows: int = 65536):
+    """Yield every logical weight span and its shared backing-key origin."""
+    if vocab_rows <= 0 or chunk_rows <= 0:
+        raise ValueError("shared HKV weight chunk size and vocabulary must be positive")
+    for table_id in range(NUM_SPARSE_FEATURES):
+        for begin in range(0, vocab_rows, chunk_rows):
+            end = min(begin + chunk_rows, vocab_rows)
+            yield table_id, begin, end, shared_hkv_key(table_id, begin, vocab_rows)
+
+
+@dataclass
+class ExperimentConfig:
+    """Configuration for a single Criteo experiment run."""
+
+    # --- Identity ---
+    config_id: str = "HKV-CE"
+
+    # --- Data ---
+    criteo_data_dir: str = "data/criteo-kaggle"
+    train_split: float = 0.8
+    val_split: float = 0.1
+    batch_size: int = 8192
+
+    # --- Embedding ---
+    embedding_dim: int = 16
+    vocab_sizes: List[int] = field(default_factory=lambda: list(CRITEO_VOCAB_SIZES))
+
+    # --- Backend ---
+    backend: str = "dynamicemb"  # "dynamicemb" or "torchrec"
+    eviction: str = "lru"  # "lru", "lfu", or "none"
+    gpu_ratio: float = 0.25  # fraction of total embeddings cached on HBM
+
+    # --- HBM budget (v4) ---
+    hbm_budget_gb: float = 2.2  # total HBM budget across all 26 tables
+
+    # --- STW baseline controls ---
+    stw_mode: bool = False  # True = stop-the-world eviction baseline
+    stw_threshold: float = 0.90  # trigger STW when cache is this full
+    stw_evict_fraction: float = 0.10  # evict this fraction of entries (bottom by LRU)
+
+    # --- Optimizer ---
+    optimizer: str = "exact_row_wise_adagrad"
+    learning_rate: float = 0.01
+    eps: float = 1e-8
+
+    # --- Training ---
+    num_iterations: int = 12000
+    eval_interval: int = 500  # AUC evaluation every N iterations
+    log_interval: int = 10  # CSV logging every N iterations
+    seed: int = 42
+
+    # --- HKV specific ---
+    bucket_capacity: int = 128
+    caching: bool = True
+    backing_capacity_factor: int = 1
+    hkv_layout: str = "partitioned"
+
+    # --- Output ---
+    output_dir: str = "results"
+    csv_filename: Optional[str] = None  # auto-generated from config_id if None
+
+    def __post_init__(self):
+        if len(self.vocab_sizes) != NUM_SPARSE_FEATURES or any(
+            size <= 0 for size in self.vocab_sizes
+        ):
+            raise ValueError("Criteo requires 26 positive vocab sizes")
+        if not 0 < self.train_split < self.train_split + self.val_split < 1:
+            raise ValueError("train/validation/test splits must all be nonempty")
+        if self.backend not in ("dynamicemb", "torchrec"):
+            raise ValueError(f"Unsupported backend: {self.backend}")
+        if self.hkv_layout not in ("partitioned", "shared"):
+            raise ValueError("HKV layout must be partitioned or shared")
+        if self.hkv_layout == "shared" and (
+            self.backend != "dynamicemb"
+            or self.embedding_dim != 32
+            or len(set(self.vocab_sizes)) != 1
+        ):
+            raise ValueError("shared HKV requires DynamicEmb and 26 equal dim32 tables")
+        if self.backend == "torchrec" and not self.caching:
+            raise ValueError("This FBGEMM adapter supports managed caching only")
+        if self.eviction not in ("lru", "lfu"):
+            raise ValueError("Only lru and lfu are supported")
+        if self.stw_mode and (self.backend != "dynamicemb" or not self.caching):
+            raise ValueError("STW maintenance requires DynamicEmb caching")
+        if (
+            min(
+                self.batch_size,
+                self.embedding_dim,
+                self.num_iterations,
+                self.eval_interval,
+                self.log_interval,
+            )
+            <= 0
+        ):
+            raise ValueError(
+                "Batch, dimension, iteration and logging sizes must be positive"
+            )
+        if not 0 < self.gpu_ratio <= 1 or self.hbm_budget_gb <= 0:
+            raise ValueError("Cache ratio and requested HBM budget must be positive")
+        if not 0 <= self.seed < 2**32:
+            raise ValueError("Seed must be in [0, 2**32)")
+        if self.backing_capacity_factor < 1:
+            raise ValueError("Backing capacity factor must be at least one")
+
+    @property
+    def run_id(self) -> str:
+        return f"{self.config_id}-seed{self.seed}"
+
+    @property
+    def result_filename(self) -> str:
+        return self.csv_filename or f"{self.run_id}.csv"
+
+
+# ============================================================
+# v4 predefined experiment configurations
+# ============================================================
+
+
+def hkv_ce() -> ExperimentConfig:
+    """HKV continuous eviction with a 0.55 GiB requested payload budget."""
+    return ExperimentConfig(
+        config_id="HKV-CE",
+        embedding_dim=16,
+        hbm_budget_gb=0.55,
+        stw_mode=False,
+        eviction="lru",
+        num_iterations=12000,
+        eval_interval=500,
+    )
+
+

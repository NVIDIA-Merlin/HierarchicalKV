+def buffer_memory_category(name):
+    name = name.rsplit(".", 1)[-1]
+    if name == "lxu_cache_weights":
+        return "cache_payload"
+    if name in ("weights_dev", "weights_host", "weights_uvm"):
+        return "backing_payload"
+    if name.endswith(("_offsets", "_placements")) or name in (
+        "lxu_cache_state",
+        "lxu_state",
+        "cache_index_table_map",
+        "cache_hash_size_cumsum",
+        "cache_miss_counter",
+    ):
+        return "metadata"
+    return "other_registered_buffer"

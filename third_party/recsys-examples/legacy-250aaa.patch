+def _budget_capture_c_stderr(libc, action):
+    fd = os.memfd_create("native-budget-stats", os.MFD_CLOEXEC)
+    old = os.dup(2)
+    try:
+        if libc.fflush(None) != 0:
+            raise OSError("libc fflush before capture failed")
+        os.dup2(fd, 2)
+        try:
+            action()
+            if libc.fflush(None) != 0:
+                raise OSError("libc fflush after capture failed")
+        finally:
+            os.dup2(old, 2)
+        length = os.lseek(fd, 0, os.SEEK_END)
+        if not 0 < length <= 1 << 20:
+            raise ValueError("empty or oversized allocator stderr capture")
+        os.lseek(fd, 0, os.SEEK_SET)
+        data = bytearray()
+        while len(data) < length:
+            chunk = os.read(fd, length - len(data))
+            if not chunk:
+                raise ValueError("truncated allocator stderr capture")
+            data.extend(chunk)
+        return bytes(data)
+    finally:
+        os.close(old)
+        os.close(fd)
+

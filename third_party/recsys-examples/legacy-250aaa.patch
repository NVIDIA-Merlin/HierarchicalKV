+def _budget_cuda_pointer_reader():
+    import ctypes
+
+    cuda = ctypes.CDLL("libcuda.so.1")
+    cuda.cuPointerGetAttribute.argtypes = [ctypes.c_void_p, ctypes.c_int,
+                                           ctypes.c_uint64]
+    cuda.cuPointerGetAttribute.restype = ctypes.c_int
+    for name in ("cuMemGetAddressRange_v2", "cuMemGetAddressRange"):
+        function = getattr(cuda, name, None)
+        if function is not None:
+            function.argtypes = [ctypes.POINTER(ctypes.c_uint64),
+                                 ctypes.POINTER(ctypes.c_size_t), ctypes.c_uint64]
+            function.restype = ctypes.c_int
+            return cuda, function, name
+    raise ValueError("CUDA 12.6 cuMemGetAddressRange symbol unavailable")
+
+
+def _budget_probe_cuda_pointer(cuda, range_function, row, pool_handles,
+                               *, pool_high_verified=True):
+    """Classify one still-live CUDA API pointer; never allocate or free."""
+    import ctypes
+
+    pointer, requested = row["pointer"], row["requested_bytes"]
+    if (type(pointer) is not int or pointer <= 0 or type(requested) is not int
+            or requested <= 0 or pointer + requested > 1 << 64):
+        raise ValueError("invalid live CUDA pointer/request")
+
+    def attribute(number, value_type):
+        value = value_type()
+        code = cuda.cuPointerGetAttribute(ctypes.byref(value), number,
+                                          ctypes.c_uint64(pointer))
+        if code != 0:
+            raise ValueError(f"cuPointerGetAttribute({number}) returned {code}")
+        return value.value
+
+    memory_type = attribute(2, ctypes.c_uint)
+    managed = attribute(8, ctypes.c_uint)
+    buffer_id = attribute(7, ctypes.c_uint64)
+    mapped = attribute(13, ctypes.c_uint)
+    pool = attribute(17, ctypes.c_void_p)
+    if not buffer_id or mapped != 1:
+        raise ValueError("CUDA buffer ID/mapped status unavailable")
+    result = {"pointer": pointer, "requested_bytes": requested,
+              "type": row["type"], "memory_type": memory_type,
+              "is_managed": bool(managed), "buffer_id": buffer_id,
+              "mapped": True, "pool_handle_hex": hex(pool) if pool else None,
+              "owner_origin": row.get("origin"),
+              "in_allocator_map": row.get("in_allocator_map"),
+              "classification": "unresolved", "api_allocation_region": None}
+    if row["type"] == "device" and memory_type == 2 and not managed:
+        if pool:
+            if pool not in pool_handles:
+                raise ValueError("live CUDA pointer belongs to unobserved pool handle")
+            result["classification"] = (
+                "pool_suballocation_in_reserved_high" if pool_high_verified
+                else "pool_suballocation_upper_unverified")
+        else:
+            base, size = ctypes.c_uint64(), ctypes.c_size_t()
+            code = range_function(ctypes.byref(base), ctypes.byref(size),
+                                  ctypes.c_uint64(pointer))
+            if code != 0 or base.value > pointer or size.value < requested \
+                    or pointer + requested > base.value + size.value:
+                raise ValueError("legacy CUDA API allocation region unavailable")
+            result["classification"] = "legacy_api_allocation_region"
+            result["api_allocation_region"] = {"base": base.value,
+                                               "size": size.value,
+                                               "not_physical_vram_measure": True}
+    elif row["type"] == "pinned" and memory_type == 1 and not managed and not pool:
+        host = attribute(4, ctypes.c_void_p)
+        device = attribute(3, ctypes.c_void_p)
+        if host != pointer or not device:
+            raise ValueError("pinned host/device pointer alias unresolved")
+        result.update(classification="pinned_host_mapped_span",
+                      host_pointer=host, device_pointer=device)
+    elif row["type"] == "managed" or managed:
+        result["classification"] = "managed_requires_separate_extent_review"
+    else:
+        raise ValueError("CUDA pointer domain differs from native allocation type")
+    # CUDA 12.6 RANGE_* may describe mappable VA, never use it as backing bytes.
+    try:
+        start = attribute(11, ctypes.c_uint64)
+        span = attribute(12, ctypes.c_size_t)
+        result["mappable_va_range"] = {"start": start, "size": span}
+    except ValueError as error:
+        result["mappable_va_query_error"] = str(error)
+    return result
+
+
+def _budget_union_intervals(intervals):
+    ordered = sorted((start, start + size) for start, size in intervals)
+    if any(start < 0 or end <= start or end > 1 << 64 for start, end in ordered):
+        raise ValueError("invalid allocation interval")
+    merged = []
+    for start, end in ordered:
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(end, merged[-1][1]))
+        else:
+            merged.append((start, end))
+    return {"bytes": sum(end - start for start, end in merged),
+            "intervals": [[start, end] for start, end in merged]}
+
+
+def _budget_live_native_cuda_extents(rosters, pool, extra_direct_rows=()):
+    result = {"status": "incomplete", "coverage_complete": False,
+              "budget_qualification": "HOLD"}
+    try:
+        if rosters.get("status") != "observed_unqualified" or pool.get("status") != "observed_unqualified":
+            raise ValueError("native roster or actual CUDA pool high unavailable")
+        invariants = pool.get("counter_invariants")
+        if type(invariants) is not bool:
+            raise ValueError("pool counter invariant result unavailable")
+        result["pool_counter_invariants"] = invariants
+        queries = pool.get("queries")
+        if type(queries) is not list or not queries:
+            raise ValueError("observed pool handle list unavailable")
+        handles = set()
+        for item in queries:
+            handle_hex = item.get("handle_hex") if type(item) is dict else None
+            if (type(handle_hex) is not str or
+                    not re.fullmatch(r"0x[0-9a-fA-F]+", handle_hex)):
+                raise ValueError("invalid observed CUDA pool handle")
+            handle = int(handle_hex, 16)
+            if handle <= 0:
+                raise ValueError("zero observed CUDA pool handle")
+            handles.add(handle)
+        result["pool_handles_observed"] = sorted(hex(handle) for handle in handles)
+        cuda, range_function, range_name = _budget_cuda_pointer_reader()
+        vm_regions = []
+        for line in Path("/proc/self/maps").read_text().splitlines():
+            fields = line.split(maxsplit=5)
+            start, end = (int(value, 16) for value in fields[0].split("-"))
+            vm_regions.append((start, end, fields[1]))
+        rows, legacy, pinned = [], [], []
+        seen = set()
+        owner_rows = [row for owner in rosters["rosters"]
+                      for row in owner["native"]["live"]]
+        owner_rows.extend(extra_direct_rows)
+        for row in owner_rows:
+            if row["type"] == "host":
+                continue  # whole-process glibc upper, subject to provider proof
+            key = (row["type"], row["pointer"])
+            if key in seen:
+                raise ValueError("native pointer appears in two physical owners")
+            seen.add(key)
+            observed = _budget_probe_cuda_pointer(
+                cuda, range_function, row, handles,
+                pool_high_verified=invariants)
+            if (row.get("allocation_api") == "cudaMalloc"
+                    or row.get("origin") == "f52_static_DeviceTimestamp_cudaMalloc") \
+                    and observed["classification"] != "legacy_api_allocation_region":
+                raise ValueError("direct cudaMalloc owner lacks legacy API allocation region")
+            expected_pool_class = (
+                "pool_suballocation_in_reserved_high" if invariants
+                else "pool_suballocation_upper_unverified")
+            if row.get("origin") == "direct_curand_cudaMallocAsync" \
+                    and observed["classification"] != expected_pool_class:
+                raise ValueError("source-proven curand async allocation lacks matching pool")
+            rows.append(observed)
+            if observed["classification"] == "legacy_api_allocation_region":
+                region = observed["api_allocation_region"]
+                legacy.append((region["base"], region["size"]))
+            elif observed["classification"] == "pinned_host_mapped_span":
+                matches = [(start, end - start) for start, end, perms in vm_regions
+                           if "r" in perms and start <= row["pointer"]
+                           and row["pointer"] + row["requested_bytes"] <= end]
+                if len(matches) != 1:
+                    raise ValueError("pinned pointer has no unique covering mapped VMA")
+                pinned.append(matches[0])
+        result.update(status="observed_unqualified", pointer_rows=rows,
+                      extra_direct_row_count=len(extra_direct_rows),
+                      cu_mem_get_address_range_symbol=range_name,
+                      legacy_api_allocation_region_union=_budget_union_intervals(legacy),
+                      pinned_host_covering_vma_union=_budget_union_intervals(pinned),
+                      managed_owner_upper_complete=False,
+                      source_lifetime_review_complete=False)
+    except Exception as error:
+        result["error"] = f"{type(error).__name__}: {error}"
+    return result
+

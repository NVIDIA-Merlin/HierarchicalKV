+def diagnostic_cache_snapshot(tables, config):
+    result = {
+        "status": "unavailable",
+        "entries": None,
+        "scope": "untimed cache boundary; entries are [table, key, native score]; not admission/eviction events or a timed-state observation",
+    }
+    try:
+        entries = []
+        if config.backend == "dynamicemb":
+            from dynamicemb.key_value_table import batched_export_keys_values
+            from .config import split_shared_hkv_key
+
+            if not tables.caches:
+                raise ValueError("diagnostic cache roster is empty")
+            timestamps = []
+            for table_index, cache in enumerate(tables.caches):
+                if cache is None:
+                    raise ValueError("cache missing from diagnostic table roster")
+                timestamps.append(int(cache._timestamp))
+                for (
+                    keys,
+                    embeddings,
+                    optimizer_states,
+                    scores,
+                ) in batched_export_keys_values(cache.table, "cpu"):
+                    key_values, score_values = keys.tolist(), scores.tolist()
+                    if len(key_values) != len(score_values):
+                        raise ValueError("exported key/score lengths differ")
+                    for key, score in zip(key_values, score_values):
+                        logical_table, logical_key = (
+                            split_shared_hkv_key(key, config.vocab_sizes[0])
+                            if config.hkv_layout == "shared"
+                            else (table_index, key)
+                        )
+                        entries.append([logical_table, logical_key, score])
+            result["table_timestamps"] = timestamps
+        elif config.backend == "torchrec":
+            keys = tables.lxu_cache_state.cpu().tolist()
+            scores = tables.lxu_state.cpu().tolist()
+            offsets = tables.cache_hash_size_cumsum.cpu().tolist()
+            if len(offsets) < 2 or any(
+                first >= second for first, second in zip(offsets, offsets[1:])
+            ):
+                raise ValueError("cache table offsets must be strictly increasing")
+            for set_index, cache_set in enumerate(keys):
+                for way, linear_key in enumerate(cache_set):
+                    if linear_key == -1:
+                        continue
+                    if not offsets[0] <= linear_key < offsets[-1]:
+                        raise ValueError("cache key outside native table offsets")
+                    table_index = bisect_right(offsets, linear_key) - 1
+                    score = (
+                        scores[linear_key]
+                        if config.eviction == "lfu"
+                        else scores[set_index][way]
+                    )
+                    entries.append(
+                        [table_index, linear_key - offsets[table_index], score]
+                    )
+            result.update(
+                native_cache_state=keys,
+                native_score_state=scores,
+                native_table_offsets=offsets,
+                native_timestep=int(tables.timestep),
+            )
+        else:
+            raise ValueError("unsupported diagnostic backend")
+        if any(
+            any(type(value) is not int for value in entry)
+            or entry[0] < 0
+            or entry[1] < 0
+            for entry in entries
+        ) or len({tuple(entry[:2]) for entry in entries}) != len(entries):
+            raise ValueError("invalid or duplicate exported table-key identity")
+        result.update(status="observed", entries=sorted(entries))
+    except Exception as error:
+        result["error"] = f"{type(error).__name__}: {error}"
+    return result
+

+inline bool allocation_identities_enabled() noexcept {
+  const char *value = std::getenv("DYNAMICEMB_ALLOCATION_IDENTITIES");
+  return value != nullptr && std::strcmp(value, "1") == 0;
+}
+
+inline uint64_t allocation_clock_ns() noexcept {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+inline HostAllocationExtent host_allocation_extent(const void *pointer,
+                                                   size_t object_bytes,
+                                                   const char *origin,
+                                                   bool known_malloc_base) {
+  HostAllocationExtent result;
+  result.pointer = reinterpret_cast<uintptr_t>(pointer);
+  result.object_bytes = object_bytes;
+  result.origin = origin;
+#if defined(__GLIBC__)
+  if (pointer != nullptr && known_malloc_base) {
+    result.usable_bytes = malloc_usable_size(const_cast<void *>(pointer));
+    result.extent_known = true;
+  }
+#endif
+  return result;
+}
+
+class AllocationIdentityState {
+public:
+  AllocationIdentityState() : owner_id(next_owner_.fetch_add(1)) {}
+
+  uint64_t sequence() noexcept { return next_sequence_.fetch_add(1); }
+  uint64_t generation() noexcept { return next_generation_.fetch_add(1); }
+
+  void append(const AllocationIdentityRecord &record) noexcept {
+    try {
+      std::lock_guard<std::mutex> guard(mutex_);
+      events_.push_back(record);
+    } catch (...) {
+      dropped_.fetch_add(1);
+    }
+  }
+
+  AllocationIdentityStats snapshot() const {
+    std::lock_guard<std::mutex> guard(mutex_);
+    AllocationIdentityStats result;
+    result.enabled = true;
+    result.owner_id = owner_id;
+    result.device_id = device_id.load();
+    result.native_object = native_object.load();
+    result.nvtx_available = DYNAMICEMB_HAS_ALLOCATION_NVTX;
+    result.dropped_records = dropped_.load();
+    result.complete = result.dropped_records == 0;
+    result.last_sequence = next_sequence_.load() - 1;
+    result.events = events_;
+    return result;
+  }
+
+  void incomplete() noexcept { dropped_.fetch_add(1); }
+
+  const uint64_t owner_id;
+  std::atomic<int> device_id{-1};
+  std::atomic<uintptr_t> native_object{0};
+
+private:
+  inline static std::atomic<uint64_t> next_owner_{1};
+  std::atomic<uint64_t> next_sequence_{1};
+  std::atomic<uint64_t> next_generation_{1};
+  std::atomic<uint64_t> dropped_{0};
+  mutable std::mutex mutex_;
+  std::vector<AllocationIdentityRecord> events_;
+};
+
+inline thread_local std::shared_ptr<AllocationIdentityState>
+    construction_identity;
+
+class AllocationConstructionScope {
+public:
+  explicit AllocationConstructionScope(
+      std::shared_ptr<AllocationIdentityState> state)
+      : previous_(construction_identity) {
+    construction_identity = std::move(state);
+  }
+  ~AllocationConstructionScope() {
+    construction_identity = std::move(previous_);
+  }
+
+private:
+  std::shared_ptr<AllocationIdentityState> previous_;
+};
+
+class AllocationIdentityRange {
+public:
+  AllocationIdentityRange(const std::shared_ptr<AllocationIdentityState> &state,
+                          const char *operation, uint64_t sequence = 0)
+      : enabled_(state != nullptr) {
+#if DYNAMICEMB_HAS_ALLOCATION_NVTX
+    if (enabled_) {
+      char label[160];
+      std::snprintf(label, sizeof(label),
+                    "dynamicemb/allocation/owner=%llu/sequence=%llu/%s",
+                    static_cast<unsigned long long>(state->owner_id),
+                    static_cast<unsigned long long>(sequence), operation);
+      nvtxRangePushA(label);
+    }
+#endif
+  }
+  ~AllocationIdentityRange() {
+#if DYNAMICEMB_HAS_ALLOCATION_NVTX
+    if (enabled_) {
+      nvtxRangePop();
+    }
+#endif
+  }
+
+private:
+  bool enabled_;
+};
+
+class AllocationControlBlockRegistry {
+public:
+  struct Entry {
+    std::shared_ptr<AllocationIdentityState> state;
+    AllocationIdentityRecord record;
+  };
+
+  static AllocationControlBlockRegistry &instance() {
+    static auto *registry = new AllocationControlBlockRegistry;
+    return *registry;
+  }
+
+  void insert(void *pointer, const Entry &entry) {
+    std::lock_guard<std::mutex> guard(mutex_);
+    if (!entries_.emplace(pointer, entry).second) {
+      throw std::bad_alloc();
+    }
+  }
+
+  Entry take(void *pointer) noexcept {
+    std::lock_guard<std::mutex> guard(mutex_);
+    const auto found = entries_.find(pointer);
+    if (found == entries_.end()) {
+      return {};
+    }
+    auto entry = std::move(found->second);
+    entries_.erase(found);
+    return entry;
+  }
+
+  std::shared_ptr<AllocationIdentityState>
+  find_native_object(const void *pointer) {
+    if (pointer == nullptr) {
+      return {};
+    }
+    std::lock_guard<std::mutex> guard(mutex_);
+    for (const auto &entry : entries_) {
+      if (entry.second.state->native_object.load() ==
+          reinterpret_cast<uintptr_t>(pointer)) {
+        return entry.second.state;
+      }
+    }
+    return {};
+  }
+
+private:
+  std::mutex mutex_;
+  std::map<void *, Entry> entries_;
+};
+
+inline constexpr bool allocation_control_block_abi_supported() noexcept {
+#if defined(__GLIBCXX__) && __GLIBCXX__ == 20230510 && \
+    defined(_GLIBCXX_RELEASE) && _GLIBCXX_RELEASE == 12 && \
+    defined(__GXX_ABI_VERSION) && __GXX_ABI_VERSION == 1017 && \
+    defined(_GLIBCXX_USE_CXX11_ABI) && _GLIBCXX_USE_CXX11_ABI == 1 && \
+    !defined(_GLIBCXX_DEBUG) && defined(__x86_64__) && __cplusplus == 201703L
+  return true;
+#else
+  return false;
+#endif
+}
+
+template <typename Value> class AllocationControlBlockAllocator {
+public:
+  using value_type = Value;
+  using is_always_equal = std::true_type;
+  AllocationControlBlockAllocator() noexcept = default;
+  template <typename Other>
+  AllocationControlBlockAllocator(
+      const AllocationControlBlockAllocator<Other> &) noexcept {}
+
+  Value *allocate(size_t count) {
+    auto &registry = AllocationControlBlockRegistry::instance();
+    const auto state = construction_identity;
+    if (!state) {
+      return std::allocator<Value>{}.allocate(count);
+    }
+    AllocationIdentityRecord record;
+    record.sequence = state->sequence();
+    AllocationIdentityRange range(state, "host_control_block_alloc",
+                                  record.sequence);
+    record.begin_ns = allocation_clock_ns();
+    auto *pointer = std::allocator<Value>{}.allocate(count);
+    record.end_ns = allocation_clock_ns();
+    record.generation = state->generation();
+    record.pointer = reinterpret_cast<uintptr_t>(pointer);
+    record.domain = nv::merlin::Host;
+    record.origin = "native_object_control_block";
+    record.requested_bytes = count * sizeof(Value);
+#if defined(__GLIBC__)
+    if constexpr (alignof(Value) <= alignof(std::max_align_t)) {
+      record.host_extent_known = true;
+      record.host_usable_bytes = malloc_usable_size(pointer);
+    }
+#endif
+    try {
+      registry.insert(pointer, {state, record});
+    } catch (...) {
+      state->incomplete();
+      std::allocator<Value>{}.deallocate(pointer, count);
+      throw;
+    }
+    state->append(record);
+    return pointer;
+  }
+
+  void deallocate(Value *pointer, size_t count) noexcept {
+    auto entry = AllocationControlBlockRegistry::instance().take(pointer);
+    if (!entry.state) {
+      std::allocator<Value>{}.deallocate(pointer, count);
+      return;
+    }
+    const auto &state = entry.state;
+    auto record = entry.record;
+    record.sequence = state->sequence();
+    AllocationIdentityRange range(state, "host_control_block_free",
+                                  record.sequence);
+    record.begin_ns = allocation_clock_ns();
+    std::allocator<Value>{}.deallocate(pointer, count);
+    record.end_ns = allocation_clock_ns();
+    record.free_issued = true;
+    state->append(record);
+  }
+
+  template <typename Other>
+  bool operator==(
+      const AllocationControlBlockAllocator<Other> &) const noexcept {
+    return true;
+  }
+  template <typename Other>
+  bool operator!=(
+      const AllocationControlBlockAllocator<Other> &other) const noexcept {
+    return !(*this == other);
+  }
+};
+
+template <typename Value> constexpr void verify_control_block_layout() {
+  static_assert(std::is_empty<AllocationControlBlockAllocator<Value>>::value);
+#if defined(__GLIBCXX__) && __GLIBCXX__ == 20230510 && \
+    defined(_GLIBCXX_RELEASE) && _GLIBCXX_RELEASE == 12 && \
+    defined(__GXX_ABI_VERSION) && __GXX_ABI_VERSION == 1017 && \
+    defined(_GLIBCXX_USE_CXX11_ABI) && _GLIBCXX_USE_CXX11_ABI == 1 && \
+    !defined(_GLIBCXX_DEBUG) && defined(__x86_64__) && __cplusplus == 201703L
+  using DefaultBlock = std::_Sp_counted_ptr_inplace<
+      Value, std::allocator<void>, __gnu_cxx::__default_lock_policy>;
+  using ObservedBlock = std::_Sp_counted_ptr_inplace<
+      Value, AllocationControlBlockAllocator<Value>,
+      __gnu_cxx::__default_lock_policy>;
+  using DefaultEbo = std::_Sp_ebo_helper<0, std::allocator<void>>;
+  using ObservedEbo =
+      std::_Sp_ebo_helper<0, AllocationControlBlockAllocator<Value>>;
+  static_assert(std::is_empty<std::allocator<void>>::value);
+  static_assert(std::is_empty<DefaultEbo>::value);
+  static_assert(std::is_empty<ObservedEbo>::value);
+  static_assert(sizeof(DefaultEbo) == sizeof(ObservedEbo));
+  static_assert(alignof(DefaultEbo) == alignof(ObservedEbo));
+  static_assert(sizeof(DefaultBlock) == sizeof(ObservedBlock));
+  static_assert(alignof(DefaultBlock) == alignof(ObservedBlock));
+#endif
+}
+
+class AccountingAllocator : public nv::merlin::BaseAllocator {
+public:
+  AccountingAllocator()
+      : delegate_(default_allocator_), known_host_malloc_(true) {}
+  explicit AccountingAllocator(nv::merlin::BaseAllocator &delegate)
+      : delegate_(delegate) {}
+
+  const std::shared_ptr<AllocationIdentityState> &identity_state() const {
+    return identity_;
+  }
+  void set_device_id(int device) {
+    if (identity_)
+      identity_->device_id.store(device);
+  }
+
+  template <typename Table> std::unique_ptr<Table> make_owned_table() {
+    AllocationIdentityRange range(identity_, "hkv_constructor");
+    return std::make_unique<Table>();
+  }
+
+  void record_external_allocation(void *pointer, size_t size,
+                                  cudaStream_t stream, uint64_t begin,
+                                  uint64_t end) {
+    if (!identity_)
+      return;
+    std::lock_guard<std::mutex> guard(mutex_);
+    record_allocation(nv::merlin::Device, pointer, size, stream, true, begin,
+                      end, identity_->sequence(), "direct_curand", false);
+  }
+
+  void record_external_free(void *pointer, uint64_t begin, uint64_t end) {
+    if (!identity_)
+      return;
+    std::lock_guard<std::mutex> guard(mutex_);
+    record_free(nv::merlin::Device, pointer, false, nullptr, begin, end,
+                identity_->sequence());
+  }
+
+  void alloc(nv::merlin::MemoryType type, void **ptr, size_t size,
+             unsigned int pinned_flags = cudaHostAllocDefault) override {
+    std::lock_guard<std::mutex> guard(mutex_);
+    const auto sequence = identity_ ? identity_->sequence() : 0;
+    AllocationIdentityRange range(identity_, "alloc", sequence);
+    const auto begin = identity_ ? allocation_clock_ns() : 0;
+    try {
+      delegate_.alloc(type, ptr, size, pinned_flags);
+    } catch (...) {
+      ++stats_.failed_delegate_calls;
+      throw;
+    }
+    record_allocation(type, ptr == nullptr ? nullptr : *ptr, size, nullptr,
+                      false, begin, identity_ ? allocation_clock_ns() : 0,
+                      sequence);
+  }
+
+  void alloc_async(nv::merlin::MemoryType type, void **ptr, size_t size,
+                   cudaStream_t stream) override {
+    std::lock_guard<std::mutex> guard(mutex_);
+    const auto sequence = identity_ ? identity_->sequence() : 0;
+    AllocationIdentityRange range(identity_, "alloc_async", sequence);
+    const auto begin = identity_ ? allocation_clock_ns() : 0;
+    try {
+      delegate_.alloc_async(type, ptr, size, stream);
+    } catch (...) {
+      ++stats_.failed_delegate_calls;
+      throw;
+    }
+    record_allocation(type, ptr == nullptr ? nullptr : *ptr, size, stream, true,
+                      begin, identity_ ? allocation_clock_ns() : 0, sequence);
+  }
+
+  void free(nv::merlin::MemoryType type, void *ptr) override {
+    std::lock_guard<std::mutex> guard(mutex_);
+    const auto sequence = identity_ ? identity_->sequence() : 0;
+    AllocationIdentityRange range(identity_, "free", sequence);
+    const auto begin = identity_ ? allocation_clock_ns() : 0;
+    try {
+      delegate_.free(type, ptr);
+    } catch (...) {
+      ++stats_.failed_delegate_calls;
+      throw;
+    }
+    record_free(type, ptr, false, nullptr, begin,
+                identity_ ? allocation_clock_ns() : 0, sequence);
+  }
+
+  void free_async(nv::merlin::MemoryType type, void *ptr,
+                  cudaStream_t stream) override {
+    std::lock_guard<std::mutex> guard(mutex_);
+    const auto sequence = identity_ ? identity_->sequence() : 0;
+    AllocationIdentityRange range(identity_, "free_async", sequence);
+    const auto begin = identity_ ? allocation_clock_ns() : 0;
+    try {
+      delegate_.free_async(type, ptr, stream);
+    } catch (...) {
+      ++stats_.failed_delegate_calls;
+      throw;
+    }
+    record_free(type, ptr, true, stream, begin,
+                identity_ ? allocation_clock_ns() : 0, sequence);
+  }
+
+  AllocationStats snapshot(bool include_allocations = false) const {
+    std::lock_guard<std::mutex> guard(mutex_);
+    auto result = stats_;
+    if (include_allocations && identity_)
+      result.identity = identity_->snapshot();
+    return result;
+  }
+
+private:
+  void mark_incomplete() noexcept {
+    stats_.bookkeeping_complete = false;
+    ++stats_.bookkeeping_errors;
+    if (identity_)
+      identity_->incomplete();
+  }
+
+  bool valid_type(nv::merlin::MemoryType type) noexcept {
+    if (type < nv::merlin::Device || type > nv::merlin::Managed) {
+      mark_incomplete();
+      return false;
+    }
+    return true;
+  }
+
+  void add(uint64_t &value, uint64_t increment) noexcept {
+    if (increment > std::numeric_limits<uint64_t>::max() - value) {
+      value = std::numeric_limits<uint64_t>::max();
+      mark_incomplete();
+    } else {
+      value += increment;
+    }
+  }
+
+  struct AllocationEntry {
+    size_t size;
+    bool counted;
+    AllocationIdentityRecord identity;
+  };
+
+  void record_allocation(nv::merlin::MemoryType type, void *ptr, size_t size,
+                         cudaStream_t stream, bool asynchronous, uint64_t begin,
+                         uint64_t end, uint64_t sequence,
+                         const char *origin = "allocator",
+                         bool counted = true) noexcept {
+    if (ptr == nullptr || !valid_type(type)) {
+      return;
+    }
+    AllocationIdentityRecord record;
+    if (identity_) {
+      record.sequence = sequence;
+      record.generation = identity_->generation();
+      record.pointer = reinterpret_cast<uintptr_t>(ptr);
+      record.stream = reinterpret_cast<uintptr_t>(stream);
+      record.requested_bytes = size;
+      record.domain = type;
+      record.asynchronous = asynchronous;
+      record.begin_ns = begin;
+      record.end_ns = end;
+      record.origin = origin;
+#if defined(__GLIBC__)
+      if (type == nv::merlin::Host && known_host_malloc_) {
+        record.host_usable_bytes = malloc_usable_size(ptr);
+        record.host_extent_known = true;
+      }
+#endif
+    }
+    try {
+      const auto inserted = allocations_.emplace(
+          std::make_pair(static_cast<int>(type),
+                                              reinterpret_cast<uintptr_t>(ptr)),
+                               AllocationEntry{size, counted, record});
+      if (!inserted.second) {
+        mark_incomplete();
+        return;
+      }
+    } catch (...) {
+      mark_incomplete();
+      return;
+    }
+    if (identity_)
+      identity_->append(record);
+    if (!counted)
+      return;
+    auto &category = stats_.categories[type];
+    add(category.live_requested_bytes, size);
+    add(category.current_allocations, 1);
+    category.peak_live_requested_bytes =
+        std::max(category.peak_live_requested_bytes, category.live_requested_bytes);
+    category.peak_current_allocations =
+        std::max(category.peak_current_allocations, category.current_allocations);
+  }
+
+  void record_free(nv::merlin::MemoryType type, void *ptr, bool asynchronous,
+                   cudaStream_t stream, uint64_t begin, uint64_t end,
+                   uint64_t sequence) noexcept {
+    if (ptr == nullptr || !valid_type(type)) {
+      return;
+    }
+    const auto found = allocations_.find(
+        std::make_pair(static_cast<int>(type), reinterpret_cast<uintptr_t>(ptr)));
+    if (found == allocations_.end()) {
+      mark_incomplete();
+      return;
+    }
+    if (identity_) {
+      auto record = found->second.identity;
+      record.sequence = sequence;
+      record.free_issued = true;
+      record.asynchronous = asynchronous;
+      record.stream = reinterpret_cast<uintptr_t>(stream);
+      record.begin_ns = begin;
+      record.end_ns = end;
+      identity_->append(record);
+    }
+    if (!found->second.counted) {
+      allocations_.erase(found);
+      return;
+    }
+    auto &category = stats_.categories[type];
+    if (asynchronous) {
+      add(category.async_free_issued_requested_bytes, found->second.size);
+      add(category.async_free_issued_allocations, 1);
+    }
+    category.live_requested_bytes -= std::min(category.live_requested_bytes,
+                                               static_cast<uint64_t>(found->second.size));
+    --category.current_allocations;
+    allocations_.erase(found);
+  }
+
+  nv::merlin::DefaultAllocator default_allocator_;
+  nv::merlin::BaseAllocator &delegate_;
+  mutable std::mutex mutex_;
+  std::map<std::pair<int, uintptr_t>, AllocationEntry> allocations_;
+  AllocationStats stats_;
+  bool known_host_malloc_ = false;
+  std::shared_ptr<AllocationIdentityState> identity_ =
+      allocation_identities_enabled()
+          ? (construction_identity
+                 ? construction_identity
+                 : std::make_shared<AllocationIdentityState>())
+          : nullptr;
+};
+
+}
diff --git a/corelib/dynamicemb/src/allocation_stats.h b/corelib/dynamicemb/src/allocation_stats.h
new file mode 100644
index 0000000..4b5dbe6
--- /dev/null
+++ b/corelib/dynamicemb/src/allocation_stats.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace dyn_emb {
+
+struct AllocationIdentityRecord {
+  uint64_t sequence = 0;
+  uint64_t generation = 0;
+  uintptr_t pointer = 0;
+  uintptr_t stream = 0;
+  uint64_t requested_bytes = 0;
+  uint64_t host_usable_bytes = 0;
+  uint64_t begin_ns = 0;
+  uint64_t end_ns = 0;
+  int domain = 0;
+  bool host_extent_known = false;
+  bool free_issued = false;
+  bool asynchronous = false;
+  const char *origin = "allocator";
+};
+
+struct HostAllocationExtent {
+  uintptr_t pointer = 0;
+  uint64_t object_bytes = 0;
+  uint64_t usable_bytes = 0;
+  bool extent_known = false;
+  std::string origin;
+};
+
+struct AllocationIdentityStats {
+  bool enabled = false;
+  bool complete = true;
+  bool nvtx_available = false;
+  uint64_t owner_id = 0;
+  uint64_t dropped_records = 0;
+  uint64_t last_sequence = 0;
+  uintptr_t native_object = 0;
+  int device_id = -1;
+  std::vector<AllocationIdentityRecord> events;
+  std::vector<HostAllocationExtent> host_allocations;
+};
+
+struct AllocationCategoryStats {
+  uint64_t live_requested_bytes = 0;
+  uint64_t current_allocations = 0;
+  uint64_t peak_live_requested_bytes = 0;
+  uint64_t peak_current_allocations = 0;
+  uint64_t async_free_issued_requested_bytes = 0;
+  uint64_t async_free_issued_allocations = 0;
+};
+
+struct AllocationStats {
+  std::array<AllocationCategoryStats, 4> categories{};
+  uint64_t failed_delegate_calls = 0;
+  uint64_t bookkeeping_errors = 0;
+  uint64_t direct_curand_requested_bytes = 0;
+  bool bookkeeping_complete = true;
+  AllocationIdentityStats identity;
+};
+
+}

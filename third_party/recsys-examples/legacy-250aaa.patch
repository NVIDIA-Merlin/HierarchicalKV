+def memory_observation(
+    tables, config, device, before_factory=None, *, synchronization_anchor=None
+):
+    identities_enabled = allocation_identities_enabled()
+    named_storages = list(tables.named_buffers(remove_duplicate=False))
+    if identities_enabled:
+        named_storages.extend(tables.named_parameters(remove_duplicate=False))
+        feature_offsets = getattr(tables, "feature_offsets", None)
+        if feature_offsets is not None:
+            named_storages.append(("feature_offsets", feature_offsets))
+        if config.backend == "dynamicemb":
+            for kind, wrappers in (("cache", tables.caches), ("backing", tables.tables)):
+                for index, wrapper in enumerate(wrappers):
+                    metrics = getattr(wrapper, "_cache_metrics", None)
+                    if metrics is not None:
+                        named_storages.append(
+                            (f"{kind}.{index}._cache_metrics", metrics)
+                        )
+    buffers, totals = visible_buffer_inventory(
+        named_storages, include_identity=identities_enabled
+    )
+    backing_bytes = None
+    cache_bytes = None
+    if config.backend == "dynamicemb":
+        import dynamicemb_extensions
+
+        backing_bytes = sum(
+            dynamicemb_extensions.dyn_emb_capacity(storage.table)
+            * storage.value_dim()
+            * 4
+            for storage in tables.tables
+        )
+        cache_bytes = sum(
+            dynamicemb_extensions.dyn_emb_capacity(cache.table) * cache.value_dim() * 4
+            for cache in tables.caches
+            if cache is not None
+        )
+    snapshot = memory_snapshot(device)
+    result = {
+        **snapshot,
+        "visible_native_buffers": buffers,
+        "visible_virtual_storage_bytes_by_category": totals,
+        "hkv_backing_value_capacity_bytes": backing_bytes,
+        "hkv_cache_value_capacity_bytes": cache_bytes,
+        "since_before_factory": memory_deltas(before_factory or {}, snapshot),
+        "native_requested_allocation": requested_allocation_observation(tables, config),
+        "native_untracked_metadata_bytes": None,
+        "native_untracked_workspace_bytes": None,
+        "native_total_allocated_bytes": None,
+        "native_managed_resident_bytes": None,
+        "matched_total_budget": False,
+        "scope": "registered storage bytes are deduplicated virtual extents, not physical residency; capacity estimates are not allocations; CUDA device-wide, PyTorch allocator and CPU process RSS deltas overlap and include runner/context state, do not sum; non-buffer native metadata/workspace/UVM residency remain unknown",
+    }
+    if identities_enabled:
+        result["allocation_identity_observation"] = allocation_identity_observation(
+            tables, config, device, buffers, synchronization_anchor
+        )
+    return result

+def native_host_allocation_observation(tables, backend="dynamicemb"):
+    result = {
+        "status": "disabled",
+        "metrics_storage_allocations": [],
+        "feature_dims_storage_allocations": [],
+        "unique_op": {"status": "unavailable"},
+        "unresolved": [],
+        "native_total_bytes": None,
+        "scope": "Live allocator extents only, not arena/RSS/residency. Storage aliases count once; do not add logical bytes. Unique-op state/journal/registry are instrumentation, not native object bytes. No allocation/free timestamps are inferred from snapshots.",
+    }
+    if not allocation_identities_enabled():
+        return result
+    try:
+        import dynamicemb_extensions
+    except ImportError as error:
+        result.update(status="unavailable", error=str(error))
+        return result
+    by_base = {}
+    groups = (
+        (("feature_dims", [tables]),)
+        if backend == "torchrec"
+        else (("cache", tables.caches), ("backing", tables.tables))
+    )
+    for role, wrappers in groups:
+        for index, wrapper in enumerate(wrappers):
+            if wrapper is None:
+                continue
+            name = (
+                "feature_dims"
+                if backend == "torchrec"
+                else f"{role}.{index}._cache_metrics"
+            )
+            record = None
+            try:
+                record = dict(
+                    dynamicemb_extensions.dyn_emb_cpu_storage_extent(
+                        None if backend == "torchrec" else wrapper.table,
+                        wrapper.feature_dims
+                        if backend == "torchrec"
+                        else wrapper._cache_metrics,
+                    )
+                )
+                extent = record.get("observed_extent_bytes")
+                base = record.get("allocation_base_ptr_hex")
+                if (
+                    record.get("status") != "observed_live_allocation_extent"
+                    or record.get("recording_enabled") is not True
+                    or type(extent) is not int
+                    or extent <= 0
+                    or type(record.get("storage_bytes")) is not int
+                    or extent < record["storage_bytes"]
+                    or not isinstance(base, str)
+                    or int(base, 16) <= 0
+                ):
+                    raise ValueError("verified allocator base/extent unavailable")
+                base = int(base, 16)
+                owner = {
+                    "name": name,
+                    "native_object_ptr": record["owner_native_object_ptr"],
+                }
+                if base in by_base:
+                    if by_base[base]["observed_extent_bytes"] != extent:
+                        raise ValueError("aliased live allocation extent changed")
+                    by_base[base]["owners"].append(owner)
+                else:
+                    record["owners"] = [owner]
+                    by_base[base] = record
+            except Exception as error:
+                result["unresolved"].append(
+                    {
+                        "name": name,
+                        "error": f"{type(error).__name__}: {error}",
+                        "observation": record,
+                    }
+                )
+    storage_field = (
+        "feature_dims_storage_allocations"
+        if backend == "torchrec"
+        else "metrics_storage_allocations"
+    )
+    result[storage_field] = list(by_base.values())
+    if backend == "torchrec":
+        result["unique_op"] = {"status": "not_applicable"}
+        result["status"] = (
+            "partial" if result["unresolved"] else "observed_live_host_extents"
+        )
+        return result
+    try:
+        unique = dict(
+            dynamicemb_extensions.dyn_emb_unique_host_stats(tables._unique_op)
+        )
+        result["unique_op"] = unique
+        blocks = [
+            record
+            for record in unique.get("events", [])
+            if record.get("origin") == "native_object_control_block"
+            and record.get("event") == "alloc_success"
+        ]
+        children = [
+            record
+            for record in unique.get("host_allocations", [])
+            if record.get("origin") == "unique_op_object"
+        ]
+        if (
+            not unique.get("recording_enabled")
+            or not unique.get("records_complete")
+            or unique.get("native_object_control_block_budget", {}).get(
+                "diagnostic_extent_is_baseline_evidence"
+            )
+            is not True
+            or len(blocks) != 1
+            or len(children) != 1
+            or any(
+                record.get("event") == "free_issued"
+                for record in unique.get("events", [])
+            )
+            or any(
+                type(record.get("observed_extent_bytes")) is not int
+                or record["observed_extent_bytes"] <= 0
+                for record in blocks + children
+            )
+            or len({record.get("pointer_hex") for record in blocks + children}) != 2
+            or any(int(record["pointer_hex"], 16) <= 0 for record in blocks + children)
+        ):
+            raise ValueError("two live unique-op host allocation extents unavailable")
+        unique["status"] = "observed_live_host_extents"
+    except Exception as error:
+        result["unresolved"].append(
+            {"name": "_unique_op", "error": f"{type(error).__name__}: {error}"}
+        )
+    result["status"] = (
+        "partial" if result["unresolved"] else "observed_live_host_extents"
+    )
+    return result

+def allocation_identity_observation(tables, config, device, buffers, sync_anchor):
+    import torch
+
+    result = {
+        "schema_version": 1,
+        "pid": os.getpid(),
+        "synchronization_anchor": sync_anchor,
+        "instrumented_timing_is_not_formal_evidence": True,
+        "pool_endpoints": {"status": "not_applicable"},
+        "torch_segments": [],
+        "storage_segment_aliases": [],
+        "unresolved_native_objects": (
+            ["_unique_op"] if config.backend == "dynamicemb" else []
+        ),
+        "scope": "Identity/alias facts only; endpoint snapshots miss short-lived allocations. "
+        "Use the full supported CUDA/NVTX trace. Do not sum storage, blocks, segments, "
+        "or pool backing. Host usable bytes do not describe allocator arenas.",
+    }
+    if sync_anchor is None:
+        result["status"] = "missing_existing_synchronization_anchor"
+        return result
+    if config.backend in {"dynamicemb", "torchrec"}:
+        host = native_host_allocation_observation(tables, config.backend)
+        result["native_host_allocations"] = host
+        if host["unique_op"].get("status") == "observed_live_host_extents":
+            result["unresolved_native_objects"] = []
+    try:
+        snapshot = torch.cuda.memory._snapshot()
+        result["torch_allocator_snapshot"] = snapshot
+        traces = snapshot.get("device_traces", [])
+        result["torch_allocator_history"] = {
+            "source": "torch.cuda.memory._snapshot",
+            "status": "recorded_events" if any(traces) else "empty_or_unavailable",
+            "max_entries_per_device": TORCH_ALLOCATOR_HISTORY_MAX_ENTRIES,
+            "possibly_truncated": any(
+                len(trace) >= TORCH_ALLOCATOR_HISTORY_MAX_ENTRIES for trace in traces
+            ),
+            "scope": "Stock Torch allocator history only, not host/managed/CUDA allocation coverage. "
+            "Final-object interval includes timer-outside initial/final observations; "
+            "use preserved frames and phase markers to distinguish observer activity. "
+            "Missing/empty/truncated history cannot exclude service reuse.",
+        }
+        for segment in snapshot["segments"]:
+            if segment["device"] != torch.device(device).index:
+                continue
+            base = segment["address"]
+            size = segment["total_size"]
+            if type(base) is not int or base < 0 or type(size) is not int or size < 0:
+                raise ValueError("unsupported Torch segment address/size")
+            blocks, offset = [], 0
+            for block in segment["blocks"]:
+                block_size = block["size"]
+                if type(block_size) is not int or block_size < 0:
+                    raise ValueError("unsupported Torch block size")
+                blocks.append(
+                    {
+                        "address_hex": hex(base + offset),
+                        "size": block_size,
+                        "state": block["state"],
+                    }
+                )
+                offset += block_size
+            if offset != size:
+                raise ValueError("Torch blocks do not partition segment")
+            result["torch_segments"].append(
+                {
+                    "address_hex": hex(base),
+                    "total_size": size,
+                    "device": segment["device"],
+                    "blocks": blocks,
+                }
+            )
+            for buffer in buffers:
+                pointer = int(buffer["storage_ptr_hex"], 16)
+                if (
+                    buffer["device"] == str(torch.device(device))
+                    and buffer["storage_bytes"] > 0
+                    and base <= pointer
+                    and pointer + buffer["storage_bytes"] <= base + size
+                ):
+                    result["storage_segment_aliases"].append(
+                        {
+                            "storage_ptr_hex": buffer["storage_ptr_hex"],
+                            "names": buffer["names"],
+                            "segment_ptr_hex": hex(base),
+                            "offset_bytes": pointer - base,
+                        }
+                    )
+        result["status"] = "observed_endpoint_only"
+    except Exception as error:
+        result.update(
+            status="invalid_or_unavailable_torch_snapshot",
+            error=f"{type(error).__name__}: {error}",
+        )
+    try:
+        import dynamicemb_extensions
+
+        result["pool_endpoints"] = dynamicemb_extensions.dyn_emb_cuda_pool_stats(
+            torch.device(device).index
+        )
+    except Exception as error:
+        result["pool_endpoints"] = {
+            "status": "query_error",
+            "error": f"{type(error).__name__}: {error}",
+        }
+    result["budget_closure_candidate"] = {
+        "status": "capture_only_coverage_incomplete",
+        "budget_qualification": "HOLD",
+        "coverage_complete": False,
+        "torch_allocator_backend": {"status": "unavailable"},
+        "cuda_pool_high": _budget_cuda_pool_high_observation(
+            torch.device(device).index, result["pool_endpoints"]),
+    }
+    try:
+        result["budget_closure_candidate"]["torch_allocator_backend"] = {
+            "status": "observed",
+            "value": torch.cuda.memory.get_allocator_backend(),
+        }
+    except Exception as error:
+        result["budget_closure_candidate"]["torch_allocator_backend"] = {
+            "status": "unavailable",
+            "error": f"{type(error).__name__}: {error}",
+        }
+    if sync_anchor == "final_flush_device_sync":
+        result["budget_closure_candidate"]["ordinary_host_global"] = (
+            _budget_host_heap_observation()
+        )
+    return result
+

+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Real backend construction and explicit frozen-weight loading for CTR DNN."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib
+import importlib.metadata
+import math
+import random
+import subprocess
+from pathlib import Path
+from typing import TYPE_CHECKING, Dict
+
+import numpy as np
+import torch
+
+from .config import ExperimentConfig, shared_hkv_weight_chunks
+
+if TYPE_CHECKING:
+    from dynamicemb import EmbOptimType
+    from dynamicemb.batched_dynamicemb_tables import BatchedDynamicEmbeddingTablesV2
+    from fbgemm_gpu.split_embedding_configs import EmbOptimType as FbgemmOptimType
+    from fbgemm_gpu.split_table_batched_embeddings_ops_training import (
+        SplitTableBatchedEmbeddingBagsCodegen,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Optimizer mapping helpers
+# ---------------------------------------------------------------------------
+
+
+def _dynamicemb_optimizer(name: str) -> EmbOptimType:
+    from dynamicemb import EmbOptimType
+
+    mapping = {
+        "sgd": EmbOptimType.EXACT_SGD,
+        "exact_sgd": EmbOptimType.EXACT_SGD,
+        "adam": EmbOptimType.ADAM,
+        "exact_adagrad": EmbOptimType.EXACT_ADAGRAD,
+        "exact_row_wise_adagrad": EmbOptimType.EXACT_ROWWISE_ADAGRAD,
+    }
+    if name not in mapping:
+        raise ValueError(f"Unknown optimizer: {name}")
+    return mapping[name]
+
+
+def _fbgemm_optimizer(name: str) -> FbgemmOptimType:
+    from fbgemm_gpu.split_embedding_configs import EmbOptimType as FbgemmOptimType
+
+    mapping = {
+        "sgd": FbgemmOptimType.EXACT_SGD,
+        "exact_sgd": FbgemmOptimType.EXACT_SGD,
+        "adam": FbgemmOptimType.ADAM,
+        "exact_adagrad": FbgemmOptimType.EXACT_ADAGRAD,
+        "exact_row_wise_adagrad": FbgemmOptimType.EXACT_ROWWISE_ADAGRAD,
+    }
+    if name not in mapping:
+        raise ValueError(f"Unknown optimizer: {name}")
+    return mapping[name]
+
+
+def _optim_state_dim(optimizer: str, dim: int) -> int:
+    """Return the per-row optimizer state dimension (in fp32 elements)."""
+    if "adam" in optimizer:
+        return dim * 2
+    elif "adagrad" in optimizer and "row" not in optimizer:
+        return dim
+    elif "row" in optimizer:
+        return 4  # 16 bytes // 4 (fp32)
+    return 0
+
+
+# ---------------------------------------------------------------------------
+# DynamicEmb tables (HKV backend) -- v4 fixed 2.2 GB budget
+# ---------------------------------------------------------------------------
+
+
+def create_criteo_dynamicemb_tables(
+    config: ExperimentConfig,
+    device: torch.device,
+) -> BatchedDynamicEmbeddingTablesV2:
+    """Create native caches; per-table minima can exceed the requested budget."""
+    from dynamicemb import (
+        DynamicEmbInitializerArgs,
+        DynamicEmbInitializerMode,
+        DynamicEmbPoolingMode,
+        DynamicEmbScoreStrategy,
+        DynamicEmbTableOptions,
+    )
+    from dynamicemb.batched_dynamicemb_tables import BatchedDynamicEmbeddingTablesV2
+
+    vocab_sizes = config.vocab_sizes
+    dim = config.embedding_dim
+    num_tables = len(vocab_sizes)
+    total_vocab = sum(vocab_sizes)
+
+    score_strategy = (
+        DynamicEmbScoreStrategy.LFU
+        if config.eviction == "lfu"
+        else DynamicEmbScoreStrategy.TIMESTAMP
+    )
+
+    optim_state_dim = _optim_state_dim(config.optimizer, dim)
+
+    # Minimum HBM per table: at least one cache bucket (1024 rows)
+    cache_bucket_capacity = 1024  # hardcoded in BatchedDynamicEmbeddingTablesV2
+    min_hbm_per_table = cache_bucket_capacity * (dim + optim_state_dim) * 4
+
+    # Total budget in bytes
+    total_hbm_bytes = int(config.hbm_budget_gb * (1024**3))
+
+    shared = config.hkv_layout == "shared"
+    physical_vocab_sizes = [total_vocab] if shared else vocab_sizes
+    table_options = []
+    for vocab_size in physical_vocab_sizes:
+        # Proportional allocation: larger vocab -> more HBM
+        proportion = vocab_size / total_vocab
+        hbm_budget = max(int(total_hbm_bytes * proportion), min_hbm_per_table)
+
+        # HKV requires max_capacity >= bucket_capacity (at least 1 full bucket)
+        effective_capacity = max(
+            vocab_size * config.backing_capacity_factor, config.bucket_capacity * 2
+        )
+        table_options.append(
+            DynamicEmbTableOptions(
+                index_type=torch.int64,
+                embedding_dtype=torch.float32,
+                dim=dim,
+                max_capacity=effective_capacity,
+                local_hbm_for_values=hbm_budget,
+                bucket_capacity=config.bucket_capacity,
+                initializer_args=DynamicEmbInitializerArgs(
+                    mode=DynamicEmbInitializerMode.CONSTANT, value=0.0
+                ),
+                score_strategy=score_strategy,
+                caching=config.caching,
+            )
+        )
+
+    return BatchedDynamicEmbeddingTablesV2(
+        table_options=table_options,
+        table_names=["shared"] if shared else [f"t_{i}" for i in range(num_tables)],
+        feature_table_map=[0] * num_tables if shared else None,
+        use_index_dedup=False,
+        pooling_mode=DynamicEmbPoolingMode.NONE,
+        output_dtype=torch.float32,
+        device=device,
+        optimizer=_dynamicemb_optimizer(config.optimizer),
+        stochastic_rounding=False,
+        learning_rate=config.learning_rate,
+        eps=config.eps,
+    )
+
+
+# ---------------------------------------------------------------------------
+# TorchRec / FBGEMM tables (UVM caching baseline)
+# ---------------------------------------------------------------------------
+
+
+def create_criteo_torchrec_tables(
+    config: ExperimentConfig,
+    device: torch.device,
+) -> SplitTableBatchedEmbeddingBagsCodegen:
+    """Create 26 FBGEMM embedding tables with UVM managed caching."""
+    from fbgemm_gpu.split_embedding_configs import SparseType
+    from fbgemm_gpu.split_table_batched_embeddings_ops_common import (
+        BoundsCheckMode,
+        CacheAlgorithm,
+        EmbeddingLocation,
+        PoolingMode,
+        RecordCacheMetrics,
+    )
+    from fbgemm_gpu.split_table_batched_embeddings_ops_training import (
+        ComputeDevice,
+        SplitTableBatchedEmbeddingBagsCodegen,
+    )
+
+    vocab_sizes = config.vocab_sizes
+    dim = config.embedding_dim
+
+    cache_alg = CacheAlgorithm.LRU if config.eviction == "lru" else CacheAlgorithm.LFU
+
+    emb = SplitTableBatchedEmbeddingBagsCodegen(
+        [
+            (
+                vocab_sizes[i],
+                dim,
+                EmbeddingLocation.MANAGED_CACHING,
+                ComputeDevice.CUDA,
+            )
+            for i in range(len(vocab_sizes))
+        ],
+        optimizer=_fbgemm_optimizer(config.optimizer),
+        weights_precision=SparseType.FP32,
+        stochastic_rounding=False,
+        cache_load_factor=config.gpu_ratio,
+        cache_algorithm=cache_alg,
+        pooling_mode=PoolingMode.NONE,
+        output_dtype=SparseType.FP32,
+        device=device,
+        learning_rate=config.learning_rate,
+        eps=config.eps,
+        bounds_check_mode=BoundsCheckMode.FATAL,
+        record_cache_metrics=RecordCacheMetrics(False, False),
+    )
+    with torch.no_grad():
+        for weight in emb.split_embedding_weights():
+            weight.zero_()
+
+    return emb
+
+
+class UnsupportedBackendError(RuntimeError):
+    pass
+
+
+def _backend_class(backend):
+    if backend == "dynamicemb":
+        from dynamicemb.batched_dynamicemb_tables import BatchedDynamicEmbeddingTablesV2
+
+        return BatchedDynamicEmbeddingTablesV2
+    if backend == "torchrec":
+        from fbgemm_gpu.split_table_batched_embeddings_ops_training import (
+            SplitTableBatchedEmbeddingBagsCodegen,
+        )
+
+        return SplitTableBatchedEmbeddingBagsCodegen
+    raise ValueError(f"Unknown backend: {backend}")
+
+
+def create_embedding_tables(config, device):
+    if torch.device(device).type != "cuda":
+        raise UnsupportedBackendError(
+            "Real DynamicEmb/FBGEMM adapters require CUDA; no CPU fallback"
+        )
+    try:
+        expected = _backend_class(config.backend)
+        factory = {
+            "dynamicemb": create_criteo_dynamicemb_tables,
+            "torchrec": create_criteo_torchrec_tables,
+        }[config.backend]
+        tables = factory(config, device)
+    except (
+        ImportError,
+        OSError,
+        RuntimeError,
+        AssertionError,
+        NotImplementedError,
+    ) as error:
+        raise UnsupportedBackendError(
+            f"{config.backend} unavailable or unsupported for NONE/FP32/{config.optimizer}/{config.eviction}: "
+            f"{type(error).__name__}: {error}. No fallback. Repository baseline: "
+            "benchmark_batched_dynamicemb_tables.py; docker/Dockerfile pins FBGEMM v1.2.0."
+        ) from error
+    if not isinstance(tables, expected):
+        raise TypeError(
+            f"Selected backend {config.backend} returned {type(tables)}, expected {expected}"
+        )
+    return tables
+
+
+def seed_everything(seed):
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+
+
+def flatten_embeddings(output, config, batch_size):
+    expected = (len(config.vocab_sizes) * batch_size, config.embedding_dim)
+    if tuple(output.shape) != expected:
+        raise ValueError(
+            f"Unexpected NONE embedding shape {tuple(output.shape)}; expected {expected}"
+        )
+    return (
+        output.reshape(len(config.vocab_sizes), batch_size, config.embedding_dim)
+        .permute(1, 0, 2)
+        .reshape(batch_size, -1)
+    )
+
+
+def load_frozen_weights(tables, config, weights, device):
+    if len(weights) != len(config.vocab_sizes):
+        raise ValueError("Frozen weights must include every table")
+    tables.eval()
+    with torch.no_grad():
+        if config.backend == "dynamicemb":
+            if config.hkv_layout == "shared":
+                if len(tables.tables) != 1:
+                    raise ValueError("shared HKV must have exactly one backing table")
+                storage = tables.tables[0]
+                stride = config.vocab_sizes[0]
+                if any(
+                    weight.shape != (stride, config.embedding_dim) for weight in weights
+                ):
+                    raise ValueError("shared HKV weight shape differs from logical table")
+                for table_id, begin, end, base in shared_hkv_weight_chunks(stride):
+                    weight = weights[table_id]
+                    keys = (
+                        torch.arange(end - begin, device=device, dtype=torch.int64)
+                        + base
+                    )
+                    values = torch.full(
+                        (end - begin, storage.value_dim()),
+                        storage.init_optimizer_state(),
+                        device=device,
+                        dtype=torch.float32,
+                    )
+                    values[:, : config.embedding_dim] = weight[begin:end].to(device)
+                    storage.set_score(1)
+                    storage.insert(keys, values)
+            else:
+                for storage, weight in zip(tables.tables, weights):
+                    keys = torch.arange(weight.shape[0], device=device, dtype=torch.int64)
+                    values = torch.full(
+                        (len(keys), storage.value_dim()),
+                        storage.init_optimizer_state(),
+                        device=device,
+                        dtype=torch.float32,
+                    )
+                    values[:, : config.embedding_dim] = weight.to(device)
+                    storage.set_score(1)
+                    storage.insert(keys, values)
+        else:
+            splits = tables.split_embedding_weights()
+            if len(splits) != len(weights):
+                raise ValueError("FBGEMM table count does not match frozen checkpoint")
+            for target, weight in zip(splits, weights):
+                if target.shape != weight.shape:
+                    raise ValueError("FBGEMM weight shape mismatch")
+                target.copy_(weight)
+    tables.reset_cache_states()
+
+
+def reset_and_check_cache(tables, config):
+    tables.flush()
+    tables.reset_cache_states()
+    if config.backend == "dynamicemb":
+        if not tables.caches or any(
+            cache is None or cache.size() != 0 for cache in tables.caches
+        ):
+            raise RuntimeError("DynamicEmb cold-cache reset did not empty every cache")
+    elif not hasattr(tables, "lxu_cache_state") or tables.lxu_cache_state.numel() == 0:
+        raise UnsupportedBackendError("FBGEMM has no inspectable managed cache state")
+    elif not bool(torch.all(tables.lxu_cache_state == -1)):
+        raise RuntimeError("FBGEMM cold-cache reset left resident keys")
+
+
+def _require_native_tables(tables, config):
+    if not isinstance(tables, _backend_class(config.backend)):
+        raise UnsupportedBackendError(
+            "Training state requires the selected native backend"
+        )
+    required = ("flush", "reset_cache_states")
+    if config.backend == "torchrec":
+        required += (
+            "split_embedding_weights",
+            "split_optimizer_states",
+            "optimizer_args",
+            "iter",
+            "iter_cpu",
+            "learning_rate_tensor",
+        )
+    else:
+        required += ("tables", "optimizer")
+    missing = [name for name in required if not hasattr(tables, name)]
+    if missing:
+        raise UnsupportedBackendError(
+            f"Native training state visibility missing: {missing}; no substitute state"
+        )
+    if config.backend == "dynamicemb":
+        if len(tables.tables) != len(config.vocab_sizes):
+            raise UnsupportedBackendError("DynamicEmb backing table count mismatch")
+        if not all(
+            hasattr(tables.optimizer, name) for name in ("get_opt_args", "set_opt_args")
+        ):
+            raise UnsupportedBackendError(
+                "DynamicEmb optimizer arguments are not observable/restorable"
+            )
+        if any(
+            storage.value_dim() != config.embedding_dim + _state_width(config)
+            for storage in tables.tables
+        ):
+            raise UnsupportedBackendError("DynamicEmb backing optimizer width mismatch")
+
+
+def _state_width(config):
+    if config.optimizer not in {
+        "sgd",
+        "exact_sgd",
+        "adam",
+        "exact_adagrad",
+        "exact_row_wise_adagrad",
+    }:
+        raise UnsupportedBackendError(
+            f"Uninspected optimizer state: {config.optimizer}"
+        )
+    if config.backend == "torchrec" and config.optimizer == "exact_row_wise_adagrad":
+        return 1
+    return _optim_state_dim(config.optimizer, config.embedding_dim)
+
+
+def _fbgemm_state_views(tables, config):
+    splits = tables.split_optimizer_states()
+    count = 2 if config.optimizer == "adam" else int(_state_width(config) != 0)
+    if count == 0 and len(splits) == 0:
+        splits = [()] * len(config.vocab_sizes)
+    if len(splits) != len(config.vocab_sizes) or any(
+        len(row) != count for row in splits
+    ):
+        raise UnsupportedBackendError(
+            "FBGEMM exposes an unsupported optimizer state layout"
+        )
+    for size, views in zip(config.vocab_sizes, splits):
+        width = _state_width(config) // count if count else 0
+        if any(
+            view.dtype != torch.float32 or view.numel() != size * width
+            for view in views
+        ):
+            raise UnsupportedBackendError(
+                "FBGEMM optimizer tensor shape/dtype mismatch"
+            )
+    return splits
+
+
+def validate_native_training_state(weights, state, config):
+    if not isinstance(state, dict) or set(state) != {
+        "version",
+        "backend",
+        "optimizer",
+        "optimizer_rows",
+        "optimizer_args",
+        "globals",
+    }:
+        raise ValueError("Native training state fields missing or unsupported")
+    if state.get("version") != 1 or state.get("backend") != config.backend:
+        raise ValueError("Native training state version/backend mismatch")
+    if state.get("optimizer") != config.optimizer:
+        raise ValueError("Native training optimizer mismatch")
+    rows = state.get("optimizer_rows", [])
+    if len(weights) != len(config.vocab_sizes) or len(rows) != len(weights):
+        raise ValueError(
+            "Training snapshot must include all weights and optimizer rows"
+        )
+    for weight, row, size in zip(weights, rows, config.vocab_sizes):
+        for tensor, width in (
+            (weight, config.embedding_dim),
+            (row, _state_width(config)),
+        ):
+            if (
+                not isinstance(tensor, torch.Tensor)
+                or tensor.dtype != torch.float32
+                or tuple(tensor.shape) != (size, width)
+            ):
+                raise ValueError("Training snapshot tensor shape/dtype mismatch")
+            if not bool(torch.isfinite(tensor).all()):
+                raise ValueError("Training snapshot state must be finite")
+    args = state.get("optimizer_args")
+    if not isinstance(args, dict) or not args:
+        raise ValueError("Training snapshot omits optimizer arguments")
+    if config.backend == "dynamicemb":
+        required = {"opt_type", "lr"}
+        if config.optimizer == "adam":
+            required |= {"iters", "beta1", "beta2", "eps", "weight_decay"}
+        elif "adagrad" in config.optimizer:
+            required |= {"eps", "initial_accumulator_value"}
+        expected_type = "exact_sgd" if config.optimizer == "sgd" else config.optimizer
+        if set(args) != required or args.get("opt_type") != expected_type:
+            raise ValueError(
+                "Training snapshot omits/changes native optimizer arguments"
+            )
+        if args["lr"] != config.learning_rate or (
+            "eps" in required and args["eps"] != config.eps
+        ):
+            raise ValueError("Training snapshot learning rate/epsilon mismatch")
+        if any(
+            type(value) not in (int, float) or not math.isfinite(value)
+            for name, value in args.items()
+            if name != "opt_type"
+        ):
+            raise ValueError("Native optimizer arguments must be finite numeric values")
+        if config.optimizer == "adam" and (
+            type(args["iters"]) is not int or args["iters"] < 0
+        ):
+            raise ValueError("Training snapshot omits valid Adam iteration state")
+        if state.get("globals") != {}:
+            raise ValueError("Unexpected DynamicEmb global state")
+    else:
+        globals_ = state.get("globals", {})
+        if set(globals_) != {"iter", "iter_cpu", "learning_rate_tensor"}:
+            raise ValueError("FBGEMM snapshot omits iteration/learning-rate state")
+        for counter in (globals_["iter"], globals_["iter_cpu"]):
+            if (
+                not isinstance(counter, torch.Tensor)
+                or counter.dtype != torch.int64
+                or counter.numel() != 1
+                or counter.item() < 0
+            ):
+                raise ValueError("Invalid FBGEMM iteration state")
+        rate = globals_["learning_rate_tensor"]
+        if (
+            not isinstance(rate, torch.Tensor)
+            or rate.dtype != torch.float32
+            or rate.numel() != 1
+            or rate.item()
+            != torch.tensor(config.learning_rate, dtype=torch.float32).item()
+        ):
+            raise ValueError("Invalid FBGEMM learning-rate state")
+        required = {
+            "stochastic_rounding",
+            "gradient_clipping",
+            "max_gradient",
+            "max_norm",
+            "eps",
+            "beta1",
+            "beta2",
+            "weight_decay",
+            "weight_decay_mode",
+            "eta",
+            "momentum",
+            "counter_halflife",
+            "adjustment_iter",
+            "adjustment_ub",
+            "learning_rate_mode",
+            "grad_sum_decay",
+            "tail_id_threshold",
+            "is_tail_id_thresh_ratio",
+            "total_hash_size",
+            "weight_norm_coefficient",
+            "lower_bound",
+            "regularization_mode",
+            "use_rowwise_bias_correction",
+        }
+        if set(args) != required or args.get("eps") != config.eps:
+            raise ValueError("FBGEMM optimizer arguments mismatch")
+        if any(
+            type(value) not in (int, float, bool) or not math.isfinite(value)
+            for value in args.values()
+        ):
+            raise ValueError("FBGEMM optimizer arguments must be finite numeric values")
+
+
+def initialize_training_backing(tables, config, device, chunk_size=65536):
+    """Materialize the existing zero initializer, never random trained weights."""
+    _require_native_tables(tables, config)
+    if chunk_size <= 0:
+        raise ValueError("chunk_size must be positive")
+    if config.backend == "dynamicemb":
+        for storage, size in zip(tables.tables, config.vocab_sizes):
+            if storage.size() != 0:
+                raise ValueError(
+                    "Constant initialization requires fresh native storage"
+                )
+            for start in range(0, size, chunk_size):
+                keys = torch.arange(start, min(start + chunk_size, size), device=device)
+                values = torch.full(
+                    (len(keys), storage.value_dim()),
+                    storage.init_optimizer_state(),
+                    dtype=torch.float32,
+                    device=device,
+                )
+                values[:, : config.embedding_dim] = 0
+                storage.set_score(1)
+                storage.insert(keys, values)
+    else:
+        if any(
+            bool(torch.count_nonzero(weight))
+            for weight in tables.split_embedding_weights()
+        ):
+            raise ValueError("Expected the existing native zero initialization")
+    export_native_training_state(tables, config, device, chunk_size)
+    tables.train()
+
+
+def export_native_training_state(tables, config, device, chunk_size=65536):
+    _require_native_tables(tables, config)
+    if chunk_size <= 0:
+        raise ValueError("chunk_size must be positive")
+    tables.flush()
+    weights, rows = [], []
+    with torch.no_grad():
+        if config.backend == "dynamicemb":
+            args = dict(tables.optimizer.get_opt_args())
+            globals_ = {}
+            for storage, size in zip(tables.tables, config.vocab_sizes):
+                values = torch.empty((size, storage.value_dim()), dtype=torch.float32)
+                for start in range(0, size, chunk_size):
+                    keys = torch.arange(
+                        start, min(start + chunk_size, size), device=device
+                    )
+                    found = torch.empty(len(keys), dtype=torch.bool, device=device)
+                    native = torch.full(
+                        (len(keys), storage.value_dim()), float("nan"), device=device
+                    )
+                    storage.find(keys, native, found)
+                    if not bool(found.all()):
+                        raise RuntimeError(
+                            "Native snapshot missing backing rows; no zero/synthetic substitution"
+                        )
+                    values[start : start + len(keys)].copy_(native.cpu())
+                weights.append(values[:, : config.embedding_dim].clone())
+                rows.append(values[:, config.embedding_dim :].clone())
+        else:
+            if not hasattr(tables.optimizer_args, "_asdict"):
+                raise UnsupportedBackendError(
+                    "FBGEMM optimizer arguments are not inspectable"
+                )
+            args = dict(tables.optimizer_args._asdict())
+            globals_ = {
+                name: getattr(tables, name).detach().cpu().clone()
+                for name in ("iter", "iter_cpu", "learning_rate_tensor")
+            }
+            weights = [
+                weight.detach().cpu().clone()
+                for weight in tables.split_embedding_weights()
+            ]
+            for size, views in zip(
+                config.vocab_sizes, _fbgemm_state_views(tables, config)
+            ):
+                rows.append(
+                    torch.cat(
+                        [view.detach().reshape(size, -1).cpu() for view in views], dim=1
+                    )
+                    if views
+                    else torch.empty((size, 0), dtype=torch.float32)
+                )
+    state = {
+        "version": 1,
+        "backend": config.backend,
+        "optimizer": config.optimizer,
+        "optimizer_rows": rows,
+        "optimizer_args": args,
+        "globals": globals_,
+    }
+    validate_native_training_state(weights, state, config)
+    return weights, state
+
+
+def restore_native_training_state(
+    tables, config, weights, state, device, chunk_size=65536
+):
+    _require_native_tables(tables, config)
+    validate_native_training_state(weights, state, config)
+    if chunk_size <= 0:
+        raise ValueError("chunk_size must be positive")
+    with torch.no_grad():
+        if config.backend == "dynamicemb":
+            if any(storage.size() != 0 for storage in tables.tables):
+                raise ValueError("Training restore requires fresh native storage")
+            tables.optimizer.set_opt_args(state["optimizer_args"])
+            for storage, weight, row in zip(
+                tables.tables, weights, state["optimizer_rows"]
+            ):
+                for start in range(0, len(weight), chunk_size):
+                    end = min(start + chunk_size, len(weight))
+                    values = torch.cat((weight[start:end], row[start:end]), dim=1).to(
+                        device
+                    )
+                    storage.set_score(1)
+                    storage.insert(torch.arange(start, end, device=device), values)
+        else:
+            if dict(tables.optimizer_args._asdict()) != state["optimizer_args"]:
+                raise UnsupportedBackendError(
+                    "FBGEMM constructor optimizer arguments differ from snapshot"
+                )
+            targets = tables.split_embedding_weights()
+            views_by_table = _fbgemm_state_views(tables, config)
+            if len(targets) != len(weights) or any(
+                target.shape != weight.shape or target.dtype != torch.float32
+                for target, weight in zip(targets, weights)
+            ):
+                raise UnsupportedBackendError("FBGEMM weight table layout mismatch")
+            for target, weight in zip(targets, weights):
+                target.copy_(weight)
+            for size, views, row in zip(
+                config.vocab_sizes, views_by_table, state["optimizer_rows"]
+            ):
+                offset = 0
+                for view in views:
+                    width = view.numel() // size
+                    view.copy_(row[:, offset : offset + width].reshape(view.shape))
+                    offset += width
+            for name, counter in state["globals"].items():
+                getattr(tables, name).copy_(counter)
+        tables.reset_cache_states()
+        tables.train()
+
+
+def cache_metrics(tables, config):
+    if config.backend == "dynamicemb":
+        metrics = [cache.cache_metrics for cache in tables.caches if cache is not None]
+        if not metrics or any(metric is None for metric in metrics):
+            return {"available": False}
+        result = {
+            "scope": (
+                "last forward shared physical-table unique lookup; not request hit rate"
+                if config.hkv_layout == "shared"
+                else "last forward per-table unique lookup; not request hit rate"
+            ),
+            "lookup_keys": sum(int(metric[0]) for metric in metrics),
+            "hits": sum(int(metric[1]) for metric in metrics),
+        }
+        if config.hkv_layout == "partitioned":
+            result["raw_per_table"] = [metric.tolist() for metric in metrics]
+        else:
+            result["raw_by_native_partition"] = [
+                metric.tolist() for metric in metrics
+            ]
+        return result
+    return {
+        "available": False,
+        "reason": "FBGEMM metrics disabled; no matched request denominator",
+    }
+
+
+def file_sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def runtime_manifest(tables, config):
+    root = Path(__file__).resolve().parents[4]
+
+    def git(*args):
+        result = subprocess.run(
+            ["git", "-C", str(root), *args], text=True, capture_output=True, timeout=10
+        )
+        return result.stdout.strip() if result.returncode == 0 else None
+
+    module = importlib.import_module(type(tables).__module__)
+    module_path = getattr(module, "__file__", None)
+    binaries = sorted(
+        path
+        for path in torch.ops.loaded_libraries
+        if "fbgemm" in path or "dynamicemb" in path
+    )
+    if config.backend == "dynamicemb":
+        extension = importlib.import_module("dynamicemb_extensions")
+        if getattr(extension, "__file__", None):
+            binaries.append(extension.__file__)
+        cache_payload_bytes = sum(
+            extension.dyn_emb_capacity(cache.table) * cache.value_dim() * 4
+            for cache in tables.caches
+            if cache is not None
+        )
+    else:
+        cache_weights = getattr(tables, "lxu_cache_weights", None)
+        cache_payload_bytes = (
+            cache_weights.numel() * cache_weights.element_size()
+            if cache_weights is not None
+            else None
+        )
+    versions = {}
+    for package in ("fbgemm-gpu", "torchrec", "dynamicemb"):
+        try:
+            versions[package] = importlib.metadata.version(package)
+        except importlib.metadata.PackageNotFoundError:
+            versions[package] = None
+    return {
+        "backend": config.backend,
+        "hkv_layout": config.hkv_layout,
+        "concrete_type": f"{type(tables).__module__}.{type(tables).__qualname__}",
+        "backend_module": module_path,
+        "backend_module_sha256": file_sha256(module_path) if module_path else None,
+        "loaded_objects_sha256": {path: file_sha256(path) for path in binaries},
+        "torch_version": torch.__version__,
+        "cuda_version": torch.version.cuda,
+        "package_versions": versions,
+        "cache_payload_bytes_including_optimizer_rows": cache_payload_bytes,
+        "cache_metadata_bytes": None,
+        "native_scratch_bytes": None,
+        "recsys_head": git("rev-parse", "HEAD"),
+        "hkv_gitlink": git("ls-tree", "HEAD", "third_party/HierarchicalKV"),
+        "hkv_worktree_head": git(
+            "-C", "third_party/HierarchicalKV", "rev-parse", "HEAD"
+        )
+        if (root / "third_party/HierarchicalKV/.git").exists()
+        else None,
+        "source_status": git("status", "--short", "--untracked-files=all"),
+        "scaffold_sha256": {
+            path.name: file_sha256(path) for path in Path(__file__).parent.glob("*.py")
+        },
+        "binary_to_hkv_source_alignment": "unverified; requires coordinator build provenance",
+        "requested_hbm_gib": config.hbm_budget_gb
+        if config.backend == "dynamicemb"
+        else None,
+        "requested_cache_load_factor": config.gpu_ratio
+        if config.backend == "torchrec"
+        else None,
+        "matched_total_memory_budget": False,
+        "training_optimizer_restore_verified": False,
+    }
+
+
+# ---------------------------------------------------------------------------
+# Memory budget calculator
+# ---------------------------------------------------------------------------
+
+
+def calculate_memory_budget(config: ExperimentConfig) -> Dict[str, object]:
+    """Estimate memory footprint for all 26 Criteo embedding tables.
+
+    Returns a dict with byte counts and whether the working set fits in HBM.
+    """
+    vocab_sizes = config.vocab_sizes
+    dim = config.embedding_dim
+    total_rows = sum(vocab_sizes)
+
+    # Embedding parameters: fp32 (4 bytes per element)
+    total_embedding_bytes = total_rows * dim * 4
+
+    state_dim = _optim_state_dim(config.optimizer, dim)
+    if config.backend == "torchrec" and config.optimizer == "exact_row_wise_adagrad":
+        state_dim = 1
+    optimizer_state_bytes = total_rows * state_dim * 4
+
+    total_bytes = total_embedding_bytes + optimizer_state_bytes
+    hbm_budget_bytes = (
+        int(config.hbm_budget_gb * 1024**3)
+        if config.backend == "dynamicemb"
+        else int(total_embedding_bytes * config.gpu_ratio)
+    )
+
+    return {
+        "total_embedding_bytes": total_embedding_bytes,
+        "optimizer_state_bytes": optimizer_state_bytes,
+        "total_bytes": total_bytes,
+        "hbm_budget_bytes": hbm_budget_bytes,
+        "fits_in_hbm": None,
+        "scope": "requested payload/cache estimate, excluding metadata, rounding, scratch and native allocation overhead",
+    }

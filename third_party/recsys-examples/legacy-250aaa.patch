+def diagnostic_counter_delta(backend, before, after, denominators):
+    result = {
+        "status": "unavailable",
+        "unique_hits": None,
+        "unique_misses": None,
+        "forwards_with_miss": None,
+        "admission_events": None,
+        "eviction_events": None,
+        "scope": "enabled diagnostic forward, table-key unique units; not request or timed hit rate; insertion slots are not admission events",
+    }
+    for snapshot in (before, after):
+        if snapshot.get("counter_validity", {}).get("status") != "diagnostic_only" or (
+            snapshot.get("counter_validity", {}).get("collection_enabled") is not True
+        ):
+            result[
+                "reason"
+            ] = "enabled diagnostic baseline/current observation required"
+            return result
+    unique_count = denominators["unique_table_keys"]
+    try:
+        if backend == "dynamicemb":
+            counters = after["counters"]
+            lookup_keys, hits = counters["lookup_keys"], counters["hits"]
+            if type(lookup_keys) is not int or type(hits) is not int:
+                raise ValueError("HKV lookup/hit counters must be integers")
+            if lookup_keys != unique_count or not 0 <= hits <= lookup_keys:
+                raise ValueError("HKV counters do not match this forward's denominator")
+            misses = lookup_keys - hits
+        elif backend == "torchrec":
+            prior, current = before["counter"], after["counter"]
+            if any(
+                not isinstance(counter, list)
+                or len(counter) != 2
+                or any(type(value) is not int or value < 0 for value in counter)
+                for counter in (prior, current)
+            ):
+                raise ValueError("TBE requires two nonnegative cumulative counters")
+            forwards, misses = [current[index] - prior[index] for index in range(2)]
+            if not 0 <= misses <= unique_count or forwards != int(misses > 0):
+                raise ValueError("TBE cumulative delta is invalid for one forward")
+            result["forwards_with_miss"] = forwards
+            hits = unique_count - misses
+        else:
+            raise ValueError("unsupported diagnostic backend")
+    except (KeyError, TypeError) as error:
+        result["reason"] = f"missing diagnostic counters: {error}"
+        return result
+    except ValueError as error:
+        result.update(status="invalid", reason=str(error))
+        return result
+    result.update(status="observed", unique_hits=hits, unique_misses=misses)
+    return result
+

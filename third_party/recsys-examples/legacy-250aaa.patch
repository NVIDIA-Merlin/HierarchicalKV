+        extension = [path for path in loaded if Path(path).name.startswith("dynamicemb_extensions.")]
+        if len(extension) != 1 or loaded[extension[0]] != "84cd44e9a7dc47d0f23b4b0b4fc7398be2d442c77b90f5bd9d8107382db27c8a":

+def cpu_state(value):
+    if isinstance(value, torch.Tensor):
+        return value.detach().cpu().clone()
+    if isinstance(value, dict):
+        return {key: cpu_state(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [cpu_state(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(cpu_state(item) for item in value)
+    return value
+
+
+def checkpoint_metadata(config, trained, provenance):
+    return {
+        "model": "CTR DNN",
+        "embedding_dim": config.embedding_dim,
+        "vocab_sizes": config.vocab_sizes,
+        "preprocessing": PREPROCESSING,
+        "split": [
+            config.train_split,
+            config.val_split,
+            1 - config.train_split - config.val_split,
+        ],
+        "trained": trained,
+        "provenance": provenance,
+        "seed": config.seed,
+    }
+
+
+def make_smoke_checkpoint(config):
+    seed_everything(config.seed)
+    generator = torch.Generator().manual_seed(config.seed)
+    model = DNN(config.embedding_dim)
+    return {
+        "format_version": CHECKPOINT_VERSION,
+        "model_state_dict": model.state_dict(),
+        "embedding_weights": [
+            torch.randn(size, config.embedding_dim, generator=generator) * 0.01
+            for size in config.vocab_sizes
+        ],
+        "metadata": checkpoint_metadata(
+            config, False, "explicit seeded random smoke fixture; not trained data"
+        ),
+    }
+
+
+def validate_training_checkpoint(checkpoint, model):
+    state = checkpoint.get("training_state")
+    if (
+        not isinstance(state, dict)
+        or set(state)
+        != {"version", "config", "completed_steps", "native", "dense_optimizer"}
+        or state.get("version") != 1
+    ):
+        raise ValueError("Trained checkpoint omits supported training state/version")
+    config = ExperimentConfig(**state["config"])
+    steps = state["completed_steps"]
+    if type(steps) is not int or steps <= 0 or steps != config.num_iterations:
+        raise ValueError("Trained checkpoint must record all completed training steps")
+    metadata = checkpoint["metadata"]
+    if any(
+        metadata[key] != value
+        for key, value in checkpoint_metadata(
+            config, True, metadata["provenance"]
+        ).items()
+    ):
+        raise ValueError("Trained checkpoint config does not match metadata")
+    digest = metadata.get("dataset_sha256")
+    if (
+        not isinstance(digest, str)
+        or len(digest) != 64
+        or any(character not in "0123456789abcdef" for character in digest)
+    ):
+        raise ValueError("Trained checkpoint requires real dataset SHA-256")
+    if (
+        metadata.get("data_kind") != "Criteo train.txt"
+        or not isinstance(metadata.get("runtime"), dict)
+        or metadata["runtime"].get("backend") != config.backend
+    ):
+        raise ValueError("Trained checkpoint omits native runtime/data provenance")
+    validate_native_training_state(
+        checkpoint["embedding_weights"], state["native"], config
+    )
+    if (
+        config.backend == "dynamicemb"
+        and config.optimizer == "adam"
+        and state["native"]["optimizer_args"]["iters"] != steps
+    ):
+        raise ValueError("Adam iteration counter does not match completed updates")
+    if config.backend == "torchrec":
+        for name in ("iter", "iter_cpu"):
+            counter = state["native"]["globals"][name].item()
+            if config.optimizer in ("sgd", "exact_sgd", "exact_adagrad"):
+                if counter != 0:
+                    raise ValueError("FBGEMM unused forward counter must remain zero")
+            elif counter < steps:
+                raise ValueError("FBGEMM forward counter is behind completed updates")
+    dense = state["dense_optimizer"]
+    expected = torch.optim.Adagrad(
+        model.parameters(), lr=config.learning_rate
+    ).state_dict()
+    if (
+        not isinstance(dense, dict)
+        or set(dense) != {"state", "param_groups"}
+        or dense["param_groups"] != expected["param_groups"]
+        or set(dense["state"]) != set(expected["state"])
+    ):
+        raise ValueError(
+            "Dense Adagrad parameter mapping/arguments/state omitted or changed"
+        )
+    for parameter_id, parameter in zip(
+        expected["param_groups"][0]["params"], model.parameters()
+    ):
+        row = dense["state"][parameter_id]
+        if not isinstance(row, dict) or set(row) != {"step", "sum"}:
+            raise ValueError("Dense Adagrad step/sum state omitted")
+        counter, accumulator = row["step"], row["sum"]
+        if (
+            not isinstance(counter, torch.Tensor)
+            or counter.dtype != torch.float32
+            or counter.numel() != 1
+            or counter.item() != steps
+        ):
+            raise ValueError("Dense Adagrad step counter mismatch")
+        if (
+            not isinstance(accumulator, torch.Tensor)
+            or accumulator.shape != parameter.shape
+            or accumulator.dtype != parameter.dtype
+            or not bool(torch.isfinite(accumulator).all())
+            or bool((accumulator < 0).any())
+        ):
+            raise ValueError("Dense Adagrad sum shape/dtype/finite state mismatch")
+    return config
+
+
+def validate_checkpoint(checkpoint, config):
+    if (
+        not isinstance(checkpoint, dict)
+        or checkpoint.get("format_version") != CHECKPOINT_VERSION
+    ):
+        raise ValueError("Unsupported or missing checkpoint format_version")
+    if not {"metadata", "model_state_dict", "embedding_weights"} <= set(checkpoint):
+        raise ValueError("Checkpoint omits model, embedding weights or metadata")
+    metadata = checkpoint["metadata"]
+    if (
+        metadata.get("model") != "CTR DNN"
+        or metadata.get("preprocessing") != PREPROCESSING
+    ):
+        raise ValueError("Checkpoint model/preprocessing must match CTR DNN replay")
+    if (
+        metadata.get("embedding_dim") != config.embedding_dim
+        or metadata.get("vocab_sizes") != config.vocab_sizes
+    ):
+        raise ValueError("Checkpoint embedding layout does not match config")
+    expected_split = [
+        config.train_split,
+        config.val_split,
+        1 - config.train_split - config.val_split,
+    ]
+    if not np.allclose(metadata.get("split", []), expected_split, rtol=0, atol=1e-12):
+        raise ValueError(
+            "Checkpoint split must match row-order train/validation/test split"
+        )
+    if type(metadata.get("trained")) is not bool or not metadata.get("provenance"):
+        raise ValueError("Checkpoint requires explicit trained flag and provenance")
+    weights = checkpoint["embedding_weights"]
+    if len(weights) != len(config.vocab_sizes):
+        raise ValueError("Checkpoint must contain every embedding table")
+    for weight, size in zip(weights, config.vocab_sizes):
+        if weight.dtype != torch.float32 or tuple(weight.shape) != (
+            size,
+            config.embedding_dim,
+        ):
+            raise ValueError(
+                "Checkpoint requires correctly shaped FP32 embedding weights"
+            )
+        if not bool(torch.isfinite(weight).all()):
+            raise ValueError("Checkpoint weights must be finite")
+    model = DNN(config.embedding_dim)
+    model_state = checkpoint["model_state_dict"]
+    if set(model_state) != set(model.state_dict()) or any(
+        not isinstance(model_state[name], torch.Tensor)
+        or model_state[name].dtype != target.dtype
+        or model_state[name].shape != target.shape
+        for name, target in model.state_dict().items()
+    ):
+        raise ValueError("Checkpoint model tensor layout/dtype mismatch")
+    model.load_state_dict(model_state, strict=True)
+    if any(
+        not bool(torch.isfinite(value).all()) for value in model.state_dict().values()
+    ):
+        raise ValueError("Checkpoint model weights must be finite")
+    if metadata["trained"]:
+        validate_training_checkpoint(checkpoint, model)
+    elif "training_state" in checkpoint:
+        raise ValueError("Untrained fixture cannot contain claimed training state")
+    model.eval().requires_grad_(False)
+    return model
+
+
+def load_checkpoint(path, config):
+    checkpoint = torch.load(path, map_location="cpu", weights_only=True)
+    model = validate_checkpoint(checkpoint, config)
+    weights, metadata = checkpoint["embedding_weights"], checkpoint["metadata"]
+    return weights, model, metadata
+
+
+def reference_embeddings(weights, sparse):
+    return torch.cat(
+        [weight[sparse[:, table]] for table, weight in enumerate(weights)], dim=1
+    )
+
+
+def load_arrivals(path, count):
+    arrivals = json.loads(Path(path).read_text())
+    if len(arrivals) != count or any(
+        not isinstance(value, (int, float)) or not math.isfinite(value) or value < 0
+        for value in arrivals
+    ):
+        raise ValueError(
+            "Arrival trace must contain one finite nonnegative seconds offset per batch"
+        )
+    if any(later < earlier for earlier, later in zip(arrivals, arrivals[1:])):
+        raise ValueError("Arrival trace must be monotonic")
+    return arrivals
+
+
+def _lookup(tables, config, sparse, device):
+    if config.backend == "dynamicemb" and config.hkv_layout == "shared":
+        # Keep the encoding and its GPU work inside every measured lookup.
+        table_major = sparse.t().contiguous().to(device)
+        table_offsets = (
+            torch.arange(table_major.shape[0], dtype=torch.int64, device=device)
+            * config.vocab_sizes[0]
+        )
+        indices = (table_major + table_offsets[:, None]).flatten()
+    else:
+        indices = sparse.t().contiguous().flatten().to(device)
+    offsets = torch.arange(indices.numel() + 1, dtype=torch.int64, device=device)
+    return flatten_embeddings(tables(indices, offsets), config, sparse.shape[0])
+
+
+def _assert_parity(actual, expected, exact=False):
+    torch.testing.assert_close(
+        actual.cpu(),
+        expected.cpu(),
+        rtol=0 if exact else RTOL,
+        atol=0 if exact else ATOL,
+        check_dtype=True,
+    )
+
+
+def _prepare_requests(dataset, config, max_batches):
+    start = dataset.n_train + dataset.n_val
+    requests = []
+    for offset in range(start, len(dataset), config.batch_size):
+        selection = slice(offset, min(offset + config.batch_size, len(dataset)))
+        requests.append(
+            (
+                torch.from_numpy(dataset.sparse[selection].copy()),
+                torch.from_numpy(dataset.dense[selection].copy()),
+                torch.from_numpy(dataset.labels[selection].copy()),
+            )
+        )
+        if len(requests) == max_batches:
+            break
+    if not requests:
+        raise ValueError("No nonempty test requests")
+    return requests
+
+
+@torch.no_grad()
+def replay(
+    config, checkpoint_path, dataset, output_dir, max_batches=8, arrival_trace=None
+):
+    if config.stw_mode or not config.caching:
+        raise ValueError(
+            "Frozen replay requires a native cache, without training STW maintenance"
+        )
+    if max_batches <= 0:
+        raise ValueError("max_batches must be positive")
+    if not torch.cuda.is_available():
+        raise RuntimeError(
+            "Native replay requires CUDA; CPU unit tests are not GPU parity"
+        )
+    device = torch.device("cuda:0")
+    torch.cuda.set_device(device)
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    seed_everything(config.seed)
+    weights, reference_model, metadata = load_checkpoint(checkpoint_path, config)
+    if metadata["trained"] and (
+        dataset.use_synthetic or dataset.source_sha256 != metadata["dataset_sha256"]
+    ):
+        raise ValueError(
+            "Trained replay requires the checkpoint's real dataset SHA-256"
+        )
+    requests = _prepare_requests(dataset, config, max_batches)
+    arrivals = load_arrivals(arrival_trace, len(requests)) if arrival_trace else None
+    expected_logits = [
+        reference_model(reference_embeddings(weights, sparse), dense)
+        for sparse, dense, _ in requests
+    ]
+    frozen_config = replace(config, optimizer="exact_sgd", backing_capacity_factor=2)
+    tables = create_embedding_tables(frozen_config, device)
+    load_frozen_weights(tables, frozen_config, weights, device)
+    model = DNN(config.embedding_dim).to(device).eval().requires_grad_(False)
+    model.load_state_dict(reference_model.state_dict())
+    reset_and_check_cache(tables, frozen_config)
+    if config.backend == "dynamicemb":
+        tables.set_record_cache_metrics(True)
+
+    for start in range(0, max(config.vocab_sizes), config.batch_size):
+        keys = torch.arange(
+            start, min(start + config.batch_size, max(config.vocab_sizes))
+        )
+        sparse = torch.stack([keys % size for size in config.vocab_sizes], dim=1)
+        _assert_parity(
+            _lookup(tables, config, sparse, device),
+            reference_embeddings(weights, sparse),
+            exact=True,
+        )
+
+    preflight = []
+    for phase in ("cold", "warm", "backing_restore"):
+        if phase != "warm":
+            reset_and_check_cache(tables, frozen_config)
+        for batch_index, (sparse, dense, _) in enumerate(requests):
+            embedding = _lookup(tables, config, sparse, device)
+            _assert_parity(embedding, reference_embeddings(weights, sparse), exact=True)
+            _assert_parity(
+                model(embedding, dense.to(device)), expected_logits[batch_index]
+            )
+            counters = cache_metrics(tables, frozen_config)
+            if config.backend == "dynamicemb" and phase != "warm" and batch_index == 0:
+                if counters.get("lookup_keys", 0) <= 0 or counters.get("hits") != 0:
+                    raise RuntimeError(
+                        "Cold-cache gate did not observe native backing misses"
+                    )
+            preflight.append(
+                {"phase": phase, "batch": batch_index, "metrics": counters}
+            )
+
+    if config.backend == "dynamicemb":
+        tables.set_record_cache_metrics(False)
+    reset_and_check_cache(tables, frozen_config)
+    torch.cuda.synchronize(device)
+    torch.cuda.reset_peak_memory_stats(device)
+    records, observed_logits = [], []
+    wall_start = time.perf_counter()
+    for batch_index, (sparse, dense, _) in enumerate(requests):
+        arrival = (
+            wall_start + arrivals[batch_index] if arrivals else time.perf_counter()
+        )
+        delay = arrival - time.perf_counter()
+        if delay > 0:
+            time.sleep(delay)
+        service_start = time.perf_counter()
+        embedding = _lookup(tables, config, sparse, device)
+        logits = model(embedding, dense.to(device))
+        prediction = torch.sigmoid(logits).cpu()
+        torch.cuda.synchronize(device)
+        completed = time.perf_counter()
+        records.append(
+            {
+                "batch": batch_index,
+                "rows": len(sparse),
+                "arrival_s": arrival - wall_start,
+                "completed_s": completed - wall_start,
+                "service_ms": (completed - service_start) * 1000,
+                "latency_ms": (completed - arrival) * 1000,
+                "queue_ms": max(0, service_start - arrival) * 1000,
+            }
+        )
+        observed_logits.append(prediction)
+    wall_seconds = completed - wall_start
+    for prediction, expected in zip(observed_logits, expected_logits):
+        _assert_parity(prediction, torch.sigmoid(expected))
+    joined_logits = torch.cat(expected_logits)
+    labels = torch.cat([labels for _, _, labels in requests])
+    manifest = runtime_manifest(tables, frozen_config)
+    manifest.update(
+        {
+            "status": "PASS_DEVELOPMENT_PARITY_ONLY",
+            "independent_run_count": 1,
+            "formal_v7_admitted": False,
+            "model": "CTR DNN (concatenation + MLP; no DLRM interaction)",
+            "config": asdict(frozen_config),
+            "checkpoint_sha256": file_sha256(checkpoint_path),
+            "checkpoint_metadata": metadata,
+            "request_sha256": hashlib_requests(requests),
+            "dataset_sha256": dataset.source_sha256,
+            "data_kind": "explicit synthetic smoke"
+            if dataset.use_synthetic
+            else "Criteo train.txt, row-order test split",
+            "arrival_mode": "fixed batch-arrival trace"
+            if arrivals
+            else "closed-loop, one batch in flight; no offered-load claim",
+            "arrival_trace_sha256": file_sha256(arrival_trace)
+            if arrival_trace
+            else None,
+            "timing_includes": "host wall clock: request tensor layout/H2D, native cache lookup/miss/backing restore/populate/gather, CTR DNN, sigmoid, prediction D2H, terminal CUDA synchronization; shared QPS interval also includes inter-batch host-loop overhead and offered-load idle time",
+            "timing_excludes": "network, file parsing, CPU request preparation, checkpoint load, full-weight oracle, parity passes, cold reset, metrics/oracle/report work; per-batch service excludes queue, arrival latency includes it",
+            "cold_cache": True,
+            "backing_store": "native DynamicEmb host-backed KeyValueTable"
+            if config.backend == "dynamicemb"
+            else "FBGEMM managed/UVM weights",
+            "restore_gate": "flush, explicit cache invalidation, then identical requests against unchanged native backing; not a policy-equivalence or training-state gate",
+            "preflight": preflight,
+            "tolerance": {
+                "embedding_rtol": 0,
+                "embedding_atol": 0,
+                "prediction_rtol": RTOL,
+                "prediction_atol": ATOL,
+                "dtype": "float32",
+                "tf32": False,
+            },
+            "requests": records,
+            "completed_rows": sum(record["rows"] for record in records),
+            "wall_seconds": wall_seconds,
+            "qps": sum(record["rows"] for record in records) / wall_seconds,
+            "batch_latency_ms": {
+                str(percentile): float(
+                    np.percentile(
+                        [record["latency_ms"] for record in records], percentile
+                    )
+                )
+                for percentile in (50, 95, 99)
+            },
+            "torch_peak_allocated_bytes": torch.cuda.max_memory_allocated(device),
+            "torch_peak_reserved_bytes": torch.cuda.max_memory_reserved(device),
+            "memory_scope": "PyTorch allocator only; native allocations/UVM/metadata not fully measured; not equal-total-HBM evidence",
+            "reference_auc": compute_auc(joined_logits, labels),
+            "reference_logloss": float(compute_loss(joined_logits, labels)),
+            "quality_scope": "fixed snapshot/test-prefix diagnostic only; not training quality or noninferiority",
+            "measured_pass_miss_accounting": "disabled to avoid instrumented synchronization; preflight counters only; formal miss/version trace remains open",
+        }
+    )
+    destination = Path(output_dir) / f"{config.run_id}-replay.json"
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    with destination.open("x") as stream:
+        json.dump(manifest, stream, indent=2)
+    return manifest
+
+
+def hashlib_requests(requests):
+    import hashlib
+
+    digest = hashlib.sha256()
+    for request in requests:
+        for tensor in request:
+            digest.update(tensor.numpy().tobytes())
+    return digest.hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", choices=ALL_CONFIGS, default="HKV-CE")
+    parser.add_argument("--checkpoint", type=Path)
+    parser.add_argument("--data-dir", default="data/criteo-kaggle")
+    parser.add_argument("--synthetic-smoke", action="store_true")
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--vocab-size", type=int, default=4096)
+    parser.add_argument("--embedding-dim", type=int, default=16)
+    parser.add_argument("--batch-size", type=int, default=32)
+    parser.add_argument("--max-batches", type=int, default=8)
+    parser.add_argument("--arrival-trace", type=Path)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    if not args.synthetic_smoke and (
+        args.checkpoint is None or not args.checkpoint.is_file()
+    ):
+        parser.error(
+            "Real replay requires an existing --checkpoint; random weights require --synthetic-smoke"
+        )
+    config = replace(
+        ALL_CONFIGS[args.config](),
+        seed=args.seed,
+        criteo_data_dir=args.data_dir,
+        batch_size=args.batch_size,
+    )
+    if args.synthetic_smoke:
+        config = replace(
+            config,
+            vocab_sizes=[args.vocab_size] * 26,
+            embedding_dim=args.embedding_dim,
+            hbm_budget_gb=0.002,
+        )
+        checkpoint_path = (
+            args.checkpoint or args.output_dir / f"smoke-seed{args.seed}.pt"
+        )
+        if not checkpoint_path.exists():
+            checkpoint_path.parent.mkdir(parents=True, exist_ok=True)
+            torch.save(make_smoke_checkpoint(config), checkpoint_path)
+    else:
+        checkpoint_path = args.checkpoint
+        metadata = torch.load(checkpoint_path, map_location="cpu", weights_only=True)[
+            "metadata"
+        ]
+        config = replace(
+            config,
+            vocab_sizes=metadata["vocab_sizes"],
+            embedding_dim=metadata["embedding_dim"],
+        )
+    try:
+        load_checkpoint(checkpoint_path, config)
+        dataset = CriteoKaggleDataset(config, use_synthetic=args.synthetic_smoke)
+        replay(
+            config,
+            checkpoint_path,
+            dataset,
+            args.output_dir,
+            args.max_batches,
+            args.arrival_trace,
+        )
+    except Exception as error:
+        args.output_dir.mkdir(parents=True, exist_ok=True)
+        failure = {
+            "status": "FAILED",
+            "backend": config.backend,
+            "config_id": config.config_id,
+            "seed": config.seed,
+            "error_type": type(error).__name__,
+            "error": str(error),
+            "formal_v7_admitted": False,
+        }
+        (args.output_dir / f"{config.run_id}-failure.json").write_text(
+            json.dumps(failure, indent=2)
+        )
+        raise
+
+
+if __name__ == "__main__":
+    main()

+def _budget_parse_malloc_info(payload):
+    from xml.etree import ElementTree
+
+    root = ElementTree.fromstring(payload)
+    if root.tag != "malloc" or root.attrib != {"version": "1"}:
+        raise ValueError("unsupported malloc_info XML root/version")
+
+    def one(parent, tag, kind):
+        values = [item for item in parent.findall(tag) if item.get("type") == kind]
+        if len(values) != 1:
+            raise ValueError(f"missing or duplicate {tag}:{kind}")
+        return _budget_u64(values[0].get("size"))
+
+    heaps = root.findall("heap")
+    if not heaps:
+        raise ValueError("malloc_info has no arenas")
+    maxima = []
+    for heap in heaps:
+        current, maximum = one(heap, "system", "current"), one(heap, "system", "max")
+        if maximum < current:
+            raise ValueError("arena max below current")
+        maxima.append(maximum)
+    total = sum(maxima)
+    if total > (1 << 64) - 1 or one(root, "system", "max") != total:
+        raise ValueError("malloc_info arena max sum mismatch")
+    return {"schema": "glibc_malloc_info_version_1", "arena_count": len(heaps),
+            "arena_system_max_bytes": maxima, "arena_max_sum_bytes": total,
+            "mmap_current_bytes": one(root, "total", "mmap")}
+
+
+def _budget_parse_malloc_stats(payload):
+    text = payload.decode("ascii", "strict")
+    if not text.endswith("\n"):
+        raise ValueError("truncated malloc_stats output")
+    arena = r"Arena [0-9]+:\n" + r"system bytes\s*=\s*[0-9]+\n" + r"in use bytes\s*=\s*[0-9]+\n"
+    tail = (r"Total \(incl\. mmap\):\n" + r"system bytes\s*=\s*[0-9]+\n"
+            + r"in use bytes\s*=\s*[0-9]+\n" + r"max mmap regions\s*=\s*[0-9]+\n"
+            + r"max mmap bytes\s*=\s*([0-9]+)\n")
+    match = re.fullmatch(r"(" + arena + r")+" + tail, text)
+    if match is None:
+        raise ValueError("unexpected malloc_stats source format")
+    return {"arena_count": len(re.findall(r"^Arena [0-9]+:$", text, re.MULTILINE)),
+            "mmap_max_bytes": _budget_u64(match.group(2))}
+
+
+def _budget_parse_pymalloc_stats(payload):
+    text = payload.decode("ascii", "strict")
+    if not text.endswith("\n") or "Total" not in text:
+        raise ValueError("truncated pymalloc statistics")
+    def value(pattern):
+        found = re.findall(pattern, text, re.MULTILINE)
+        if len(found) != 1:
+            raise ValueError("missing or duplicate pymalloc field")
+        return _budget_u64(found[0].replace(",", ""))
+    high = value(r"^# arenas highwater mark\s*=\s*([0-9,]+)\s*$")
+    current = value(r"^# arenas allocated current\s*=\s*([0-9,]+)\s*$")
+    sizes = re.findall(r"^\s*([0-9,]+) arenas \* ([0-9,]+) bytes/arena\s*=\s*([0-9,]+)\s*$", text, re.MULTILINE)
+    if len(sizes) != 1:
+        raise ValueError("missing or duplicate actual pymalloc arena size")
+    observed_current, arena_size, observed_bytes = (_budget_u64(x.replace(",", "")) for x in sizes[0])
+    if high < current or observed_current != current or observed_bytes != current * arena_size:
+        raise ValueError("contradictory pymalloc arena statistics")
+    total = high * arena_size
+    if total > (1 << 64) - 1:
+        raise ValueError("pymalloc highwater exceeds uint64")
+    return {"arena_size_bytes": arena_size, "arenas_highwater": high,
+            "arena_highwater_bytes": total}
+

+def test_cuda_service_actual_timing_statements_cpu_order(
+    cuda_service_cpu_fixture, backend, enabled
+):
+    torch, calls, events, native = cuda_service_cpu_fixture
+    tables, config = native(backend)
+    tables.flush = lambda: calls.append("flush")
+    tree = ast.parse(inspect.getsource(comparison.run_native))
+    body = next(
+        node.body
+        for node in ast.walk(tree)
+        if isinstance(node, ast.With)
+        and any(
+            isinstance(child, ast.Assign)
+            and ast.unparse(child.targets[0]) == "service_events"
+            for child in node.body
+        )
+    )
+    initialization = next(
+        index
+        for index, node in enumerate(body)
+        if isinstance(node, ast.Assign)
+        and ast.unparse(node.targets[0]) == "service_events"
+    )
+    timed_start = next(
+        index
+        for index, node in enumerate(body)
+        if isinstance(node, ast.Assign) and ast.unparse(node.targets[0]) == "observed"
+    )
+    timed_end = next(
+        index
+        for index, node in enumerate(body)
+        if isinstance(node, ast.Assign) and ast.unparse(node.targets[0]) == "elapsed"
+    )
+    clocks = iter([10.0, 11.0, 12.0])
+
+    def clock():
+        calls.append("wall_clock")
+        return next(clocks)
+
+    def lookup(*args):
+        calls.append("lookup")
+        return SimpleNamespace(cpu=lambda: calls.append("D2H"))
+
+    namespace = {
+        "tables": tables,
+        "config": config,
+        "device": "cuda:0",
+        "cuda_event_service": enabled,
+        "backend": backend,
+        "diagnostic_flush_repeats": 1,
+        "torch": torch,
+        "raw": {"batches": []},
+        "requests": ["request"],
+        "cell": SimpleNamespace(batch_size=1),
+        "time": SimpleNamespace(perf_counter=clock),
+        "_lookup": lookup,
+        "mark_allocation_phase": lambda phase: None,
+        "prepare_cuda_service_events": comparison.prepare_cuda_service_events,
+        "cuda_service_event_measurement": comparison.cuda_service_event_measurement,
+    }
+    statements = (
+        body[initialization : initialization + 2] + body[timed_start : timed_end + 2]
+    )
+    exec(
+        compile(
+            ast.Module(body=statements, type_ignores=[]),
+            "actual_service_timing",
+            "exec",
+        ),
+        namespace,
+    )
+    expected = [
+        "sync",
+        "wall_clock",
+        "lookup",
+        "D2H",
+        "sync",
+        "wall_clock",
+        ("push", "native_flush"),
+        "flush",
+        "pop",
+        "sync",
+        "wall_clock",
+    ]
+    if enabled:
+        expected = [
+            ("create", 0, True),
+            ("create", 1, True),
+            ("record", 0, "current"),
+            ("record", 1, "current"),
+            "sync",
+            ("push", "native_service/" + backend),
+            ("record", 0, None),
+            *expected[1:9],
+            ("record", 1, None),
+            *expected[9:],
+            "pop",
+            "elapsed_time",
+        ]
+        measurement = namespace["raw"]["cuda_event_service"]
+        assert measurement["seconds"] == 1.25
+        assert "not kernel busy-time" in measurement["includes"]
+        assert measurement["coverage_provenance"]["task"] == "44fc651b"
+    else:
+        assert events == []
+        assert "cuda_event_service" not in namespace["raw"]
+    assert calls == expected
+    assert namespace["elapsed"] == 2.0
+    assert namespace["raw"]["batches"][0]["completed_seconds"] == 1.0

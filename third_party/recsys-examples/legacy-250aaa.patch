+def test_budget_native_clamp_is_terminal_before_weight_load():
+    tree = ast.parse(inspect.getsource(comparison.run_native))
+    factory = next(
+        node
+        for node in ast.walk(tree)
+        if isinstance(node, ast.FunctionDef) and node.name == "fresh_tables"
+    )
+    guard = next(node for node in factory.body if isinstance(node, ast.If))
+    assert "explicit_controls" in ast.unparse(guard.test)
+    assert "request_satisfied" in ast.unparse(guard.test)
+    assert isinstance(guard.body[0], ast.Raise)
+    load = next(
+        node
+        for node in factory.body
+        if isinstance(node, ast.Expr)
+        and isinstance(node.value, ast.Call)
+        and getattr(node.value.func, "id", None) == "load_frozen_weights"
+    )
+    assert guard.lineno < load.lineno

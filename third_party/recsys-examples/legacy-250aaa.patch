+def validate_inputs(artifact):
+    import torch
+
+    if artifact.get("format") != FORMAT:
+        raise ValueError("not a frozen V2 input")
+    cell = Cell(**artifact["cell"])
+    workload = workload_spec(cell, artifact.get("vocab_rows"))
+    expected_trace = make_trace(cell, artifact.get("vocab_rows"))
+    expected_shapes = {
+        "requests": (cell.batches, cell.batch_size, 26),
+        "prime": (len(expected_trace["prime"]), 26),
+    }
+    for name, shape in expected_shapes.items():
+        value = artifact[name]
+        if (
+            value.dtype != torch.int64
+            or tuple(value.shape) != shape
+            or not torch.equal(value, torch.tensor(expected_trace[name]))
+        ):
+            raise ValueError(f"frozen {name} differs from seed/trace contract")
+    if artifact["request_ids"] != expected_trace["request_ids"]:
+        raise ValueError("request IDs must cover the complete trace exactly")
+    if len(artifact["weights"]) != 26 or len(artifact["weights_sha256"]) != 26:
+        raise ValueError("26 frozen weight tables required")
+    for weight, digest in zip(artifact["weights"], artifact["weights_sha256"]):
+        if (
+            weight.dtype != torch.float32
+            or tuple(weight.shape) != (workload["vocab_rows_per_table"], 32)
+            or not bool(torch.isfinite(weight).all())
+            or tensor_sha256(weight) != digest
+        ):
+            raise ValueError("invalid frozen FP32 weights or weight digest")
+    if tensor_sha256(artifact["requests"]) != artifact["trace_sha256"]:
+        raise ValueError("trace digest mismatch")
+    return cell
+
+
+def completed_denominator(records, expected_requests, elapsed_seconds):
+    if type(expected_requests) is not int or expected_requests <= 0:
+        raise ValueError("expected request count must be a positive integer")
+    if not math.isfinite(elapsed_seconds) or elapsed_seconds <= 0:
+        raise ValueError("completed host-wall interval must be finite and positive")
+    next_request = 0
+    previous_completion = 0.0
+    for record in records:
+        if (
+            type(record["rows"]) is not int
+            or type(record["first_request_id"]) is not int
+            or record["first_request_id"] != next_request
+            or record["rows"] <= 0
+        ):
+            raise ValueError("missing, duplicate or reordered completed requests")
+        completion = record["completed_seconds"]
+        if (
+            not math.isfinite(completion)
+            or not previous_completion < completion <= elapsed_seconds
+        ):
+            raise ValueError("invalid completed-request boundary")
+        previous_completion = completion
+        next_request += record["rows"]
+    if next_request != expected_requests or not records:
+        raise ValueError("incomplete service denominator")
+    return {
+        "completed_requests": next_request,
+        "embedding_rows": 26 * next_request,
+        "host_wall_seconds": elapsed_seconds,
+        "requests_per_second": next_request / elapsed_seconds,
+    }
+
+
+def prepare_cuda_service_events(tables, config, device, *, enabled):
+    if not enabled:
+        return None
+    import torch
+
+    concrete_type = f"{type(tables).__module__}.{type(tables).__qualname__}"
+    if (
+        config.backend not in BACKENDS
+        or concrete_type != NATIVE_TYPES[config.backend]
+        or config.eviction != "lru"
+        or config.optimizer != "exact_sgd"
+        or config.embedding_dim != 32
+        or str(device) != "cuda:0"
+    ):
+        raise ValueError(
+            "CUDA-event service coverage requires the fixed cuda:0 LRU/EXACT_SGD native path"
+        )
+    prefetch_attribute = (
+        "_enable_prefetch" if config.backend == "dynamicemb" else "prefetch_pipeline"
+    )
+    if (
+        getattr(tables, prefetch_attribute, None) is not False
+        or getattr(tables, "prefetch_stream", None) is not None
+    ):
+        raise ValueError(
+            "CUDA-event service coverage excludes prefetch pipelines/streams"
+        )
+    if config.backend == "dynamicemb":
+        options = [cache.options for cache in tables.caches if cache is not None]
+        options.extend(tables._dynamicemb_options)
+        if (
+            tables.device_id != 0
+            or not options
+            or any(
+                option.init_capacity != option.max_capacity
+                or option.external_storage is not None
+                for option in options
+            )
+        ):
+            raise ValueError(
+                "CUDA-event service coverage requires fixed native capacities on cuda:0"
+            )
+    elif str(tables.current_device) != "cuda:0":
+        raise ValueError("CUDA-event service coverage requires one device, cuda:0")
+    current_stream = torch.cuda.current_stream(device)
+    events = (
+        torch.cuda.Event(enable_timing=True),
+        torch.cuda.Event(enable_timing=True),
+    )
+    for event in events:
+        event.record(current_stream)
+    return events
+
+
+def cuda_service_event_measurement(events):
+    seconds = float(events[0].elapsed_time(events[1])) / 1000
+    if not math.isfinite(seconds) or seconds <= 0:
+        raise ValueError(
+            "CUDA-event service elapsed seconds must be finite and positive"
+        )
+    return {
+        "seconds": seconds,
+        "metric": "CUDA-event elapsed service envelope",
+        "primary_metric": "measurement.host_wall_seconds",
+        "includes": "host-dispatch/layout/copy/idle gaps and final flush; not kernel busy-time",
+        "wall_overhead": "stop-event enqueue is included in the unchanged primary wall timer",
+        "coverage": "source-traced fixed single-device LRU/EXACT_SGD lookup+flush, no prefetch pipeline; not runtime timeline validation",
+        "coverage_provenance": {
+            "task": "44fc651b",
+            "handoff_sha256": "327287d1dcb4d64c8eaeb7984d82086a1ce6746ab3a20d16967e5f1e9f88d275",
+            "runtime_identity": "native (same raw record); requires frozen build/source alignment",
+        },
+    }
+

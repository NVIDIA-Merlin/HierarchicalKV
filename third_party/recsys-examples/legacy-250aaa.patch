+        hbm_budget_gb=1.1,
+        stw_mode=False,
+        eviction="lru",
+        num_iterations=12000,
+        eval_interval=500,
+    )
+
+
+def stw_baseline_1g() -> ExperimentConfig:
+    """Stop-the-world baseline at 1.1 GB budget."""
+    return ExperimentConfig(
+        config_id="STW-BASELINE-1G",
+        embedding_dim=16,
+        hbm_budget_gb=1.1,
+        stw_mode=True,
+        stw_threshold=0.90,
+        stw_evict_fraction=0.10,
+        eviction="lru",
+        num_iterations=12000,
+        eval_interval=500,
+    )
+
+
+# --- 1.65 GB budget (~60% cache ratio) ---
+
+
+def hkv_ce_1_5g() -> ExperimentConfig:
+    """HKV continuous eviction at 1.65 GB budget (~60% cache ratio at dim=16)."""
+    return ExperimentConfig(
+        config_id="HKV-CE-1.5G",
+        embedding_dim=16,
+        hbm_budget_gb=1.65,
+        stw_mode=False,
+        eviction="lru",
+        num_iterations=12000,
+        eval_interval=500,
+    )
+
+
+def stw_baseline_1_5g() -> ExperimentConfig:
+    """Stop-the-world baseline at 1.65 GB budget."""
+    return ExperimentConfig(
+        config_id="STW-BASELINE-1.5G",
+        embedding_dim=16,
+        hbm_budget_gb=1.65,

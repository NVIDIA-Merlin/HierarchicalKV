+def memory_snapshot(device):
+    import torch
+
+    process_rss = None
+    try:
+        for line in Path("/proc/self/status").read_text().splitlines():
+            fields = line.split()
+            if fields[:1] == ["VmRSS:"] and fields[-1:] == ["kB"]:
+                process_rss = int(fields[1]) * 1024
+    except (OSError, ValueError):
+        pass
+    free_bytes, total_bytes = torch.cuda.mem_get_info(device)
+    return {
+        "torch_allocated_bytes": torch.cuda.memory_allocated(device),
+        "torch_reserved_bytes": torch.cuda.memory_reserved(device),
+        "torch_peak_reserved_bytes": torch.cuda.memory_stats(device)["reserved_bytes.all.peak"],
+        "torch_peak_allocated_bytes": torch.cuda.max_memory_allocated(device),
+        "device_free_bytes": free_bytes,
+        "device_total_bytes": total_bytes,
+        "cpu_process_rss_bytes": process_rss,
+        "nvml": nvml_memory_snapshot(device),
+    }
+

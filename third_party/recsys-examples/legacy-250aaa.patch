+def _budget_dso_observation(libc, callbacks, *, allow_f52_local_new=False):
+    import ctypes
+
+    class DlInfo(ctypes.Structure):
+        _fields_ = [("name", ctypes.c_char_p), ("base", ctypes.c_void_p),
+                    ("symbol", ctypes.c_char_p), ("symbol_address", ctypes.c_void_p)]
+
+    libc.dlsym.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
+    libc.dlsym.restype = ctypes.c_void_p
+    libc.dladdr.argtypes = [ctypes.c_void_p, ctypes.POINTER(DlInfo)]
+    libc.dladdr.restype = ctypes.c_int
+    local_stdcpp = None
+
+    def local_operator_new(name):
+        nonlocal local_stdcpp
+        if local_stdcpp is None:
+            paths = set()
+            for line in Path("/proc/self/maps").read_text().splitlines():
+                parts = line.split(maxsplit=5)
+                if len(parts) != 6 or not parts[5].startswith("/"):
+                    continue
+                mapped_path = parts[5].strip()
+                if "libstdc++.so.6" not in os.path.basename(mapped_path):
+                    continue
+                if mapped_path.endswith(" (deleted)"):
+                    raise ValueError("loaded libstdc++ mapping was deleted")
+                paths.add(os.path.realpath(mapped_path))
+            if len(paths) != 1:
+                raise ValueError("expected one already mapped libstdc++ provider")
+            path = paths.pop()
+            base, mappings = _budget_dso_maps(path)
+            elf = _budget_elf_identity(path)
+            if (elf["build_id"] != "eb0991e99bf8c31e942757ab71a6266bffb30e1f"
+                    or sha256(path) != "ff0825e113603c3866680d5d52216bc6d8eedf3a59f52a0aef67ff01994db128"):
+                raise ValueError("already mapped libstdc++ differs from frozen provider")
+            flags = os.RTLD_NOLOAD | os.RTLD_LOCAL | os.RTLD_NOW
+            handle = ctypes.CDLL(path, mode=flags)
+            if _budget_dso_maps(path) != (base, mappings):
+                raise ValueError("NOLOAD changed libstdc++ mappings")
+            local_stdcpp = (path, base, mappings, handle)
+        path, base, mappings, handle = local_stdcpp
+        pointer = libc.dlsym(ctypes.c_void_p(handle._handle), name)
+        detail = DlInfo()
+        if (not pointer or libc.dladdr(pointer, ctypes.byref(detail)) == 0
+                or os.path.realpath(os.fsdecode(detail.name)) != path
+                or detail.base != base
+                or not any(start <= pointer < end and "x" in perms
+                           for start, end, perms, _offset in mappings)):
+            raise ValueError("NOLOAD operator new outside pinned executable DSO")
+        if name == b"_Znwm" and pointer != base + 0xae970:
+            raise ValueError("NOLOAD _Znwm differs from frozen symbol offset")
+        return pointer
+
+    symbols = {}
+    for name in (b"_Znwm", b"_ZnwmSt11align_val_t", b"malloc", b"free",
+                 b"posix_memalign", b"malloc_info", b"malloc_stats", b"gnu_get_libc_version"):
+        pointer = libc.dlsym(None, name)
+        resolution_scope = "global"
+        detail = DlInfo()
+        if not pointer and name in (b"_Znwm", b"_ZnwmSt11align_val_t"):
+            if allow_f52_local_new:
+                pointer = local_operator_new(name)
+                resolution_scope = "already_loaded_rtld_noload_local"
+            else:
+                symbols[name.decode()] = {"status": "unresolved_in_this_process"}
+                continue
+        if not pointer or libc.dladdr(pointer, ctypes.byref(detail)) == 0:
+            raise ValueError("unresolved dynamic allocator symbol: " + name.decode())
+        symbols[name.decode()] = {"address": hex(pointer),
+                                  "dso": os.fsdecode(detail.name),
+                                  "dso_base": hex(detail.base) if detail.base else None,
+                                  "resolution_scope": resolution_scope}
+    callback_dsos = {}
+    for name, pointer in callbacks.items():
+        detail = DlInfo()
+        if not pointer or libc.dladdr(pointer, ctypes.byref(detail)) == 0:
+            raise ValueError("unresolved Python allocator callback: " + name)
+        callback_dsos[name] = {"address": hex(pointer), "dso": os.fsdecode(detail.name)}
+    def canonical_dso(name):
+        return os.path.realpath(name if os.path.isabs(name) else "/proc/self/exe")
+    paths = {canonical_dso(record["dso"]) for record in
+             [*symbols.values(), *callback_dsos.values()] if "dso" in record}
+    mapped = {}
+    for line in Path("/proc/self/maps").read_text().splitlines():
+        parts = line.split(maxsplit=5)
+        if len(parts) == 6 and parts[5].startswith("/") and os.path.realpath(parts[5]) in paths:
+            mapped.setdefault(os.path.realpath(parts[5]), {"dev": parts[3], "inode": parts[4]})
+    if not paths.issubset(mapped):
+        raise ValueError("allocator symbol DSO missing from loaded maps: "
+                         + repr(sorted(paths.difference(mapped))))
+    return {"symbols": symbols, "python_callback_dsos": callback_dsos,
+            "loaded_dso_map_identity": mapped,
+            "operator_new_symbols_resolved": all("dso" in symbols[name]
+                                                  for name in ("_Znwm", "_ZnwmSt11align_val_t")),
+            "operator_new_delegation_proved": False,
+            "provider_coverage_complete": False}
+

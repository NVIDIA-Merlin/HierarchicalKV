+def _budget_u64(value):
+    if not isinstance(value, str) or re.fullmatch(r"[0-9]+", value) is None:
+        raise ValueError("invalid unsigned decimal allocator field")
+    number = int(value)
+    if number > (1 << 64) - 1:
+        raise ValueError("allocator field exceeds uint64")
+    return number
+

--- /dev/null
+++ b/corelib/dynamicemb/benchmark/criteo_experiment/dlrm_model.py
@@ -0,0 +1,102 @@
+# SPDX-FileCopyrightText: Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""DNN model for Criteo Kaggle + DynamicEmb (HKV) evaluation.
+
+Simple Deep Neural Network: dense features + sparse embedding concat → MLP.
+This is the "Deep" component used in Wide&Deep (Cheng et al. 2016) and
+DeepFM (Guo et al. 2017) — a well-known baseline in CTR prediction.
+"""
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+from .config import NUM_DENSE_FEATURES, NUM_SPARSE_FEATURES
+
+
+class DNN(nn.Module):
+    """Deep Neural Network for CTR prediction.
+
+    Architecture:
+        1. Dense features (13) concatenated with sparse embeddings (26 * dim)
+        2. MLP: input_dim → 256 → 128 → 1
+
+    Sparse embedding lookup is handled externally (DynamicEmb / TorchRec);
+    this module receives the already-looked-up embeddings as input.
+    """
+
+    def __init__(
+        self,
+        embedding_dim: int = 16,
+        num_sparse_features: int = NUM_SPARSE_FEATURES,
+        num_dense_features: int = NUM_DENSE_FEATURES,
+    ):
+        super().__init__()
+        self.embedding_dim = embedding_dim
+        input_dim = num_dense_features + num_sparse_features * embedding_dim
+
+        self.mlp = nn.Sequential(
+            nn.Linear(input_dim, 256),
+            nn.ReLU(),
+            nn.Linear(256, 128),
+            nn.ReLU(),
+            nn.Linear(128, 1),
+        )
+
+    def forward(
+        self,
+        sparse_embeddings: torch.Tensor,
+        dense_features: torch.Tensor,
+    ) -> torch.Tensor:
+        """Forward pass.
+
+        Args:
+            sparse_embeddings: (batch_size, num_sparse_features * embedding_dim)
+            dense_features: (batch_size, num_dense_features)
+
+        Returns:
+            logits: (batch_size,)
+        """
+        combined = torch.cat([dense_features, sparse_embeddings], dim=1)
+        return self.mlp(combined).squeeze(-1)
+
+
+def compute_loss(logits: torch.Tensor, labels: torch.Tensor) -> torch.Tensor:
+    """Binary cross-entropy with logits loss."""
+    return F.binary_cross_entropy_with_logits(logits, labels)
+
+
+def compute_auc(logits: torch.Tensor, labels: torch.Tensor) -> float:
+    """Compute AUC using pure PyTorch (no sklearn dependency)."""
+    with torch.no_grad():
+        probs = torch.sigmoid(logits)
+        num_pos = labels.sum()
+        num_neg = labels.numel() - num_pos
+
+        if num_pos == 0 or num_neg == 0:
+            return 0.5
+
+        sorted_indices = torch.argsort(probs, descending=True)
+        sorted_labels = labels[sorted_indices]
+        sorted_probs = probs[sorted_indices]
+
+        tps = torch.cumsum(sorted_labels, dim=0)
+        fps = torch.cumsum(1.0 - sorted_labels, dim=0)
+        endpoints = torch.cat(
+            (
+                sorted_probs[1:] != sorted_probs[:-1],
+                torch.ones(1, dtype=torch.bool, device=probs.device),
+            )
+        )
+        tps = tps[endpoints]
+        fps = fps[endpoints]
+
+        tpr = tps / num_pos
+        fpr = fps / num_neg
+
+        tpr = torch.cat([torch.zeros(1, device=tpr.device), tpr])
+        fpr = torch.cat([torch.zeros(1, device=fpr.device), fpr])
+
+        auc = torch.trapezoid(tpr, fpr)
+        return auc.item()
diff --git a/corelib/dynamicemb/benchmark/criteo_experiment/embedding_config.py b/corelib/dynamicemb/benchmark/criteo_experiment/embedding_config.py

+                    "group_shared_mutex.d_read_count_": "cuda::atomic<int,device>",
+                    "group_shared_mutex.d_unique_flag_": "cuda::atomic<bool,device>",
+                }
+                if (not isinstance(group_rows, list) or len(group_rows) != 3
+                        or roster.get("group_lock_source_sha256") !=
+                        "c12d77929dc2124a2c8dd724f2fde4f16d6ec59fc16389421e7d6dea6e89a1fa"):
+                    raise ValueError("exact f52 group-lock companion fields absent")
+                group_seen = set()
+                for row in group_rows:
+                    origin = row.get("origin")
+                    key = (row.get("type_id"), row.get("pointer"))
+                    if (origin not in expected_group or origin in group_seen
+                            or row.get("atomic_type") != expected_group[origin]
+                            or row.get("type") != "device" or row.get("type_id") != 0
+                            or type(row.get("pointer")) is not int or row["pointer"] <= 0
+                            or type(row.get("requested_bytes")) is not int
+                            or row["requested_bytes"] <= 0
+                            or row.get("counted") is not False
+                            or row.get("in_allocator_map") is not False
+                            or row.get("asynchronous") is not False
+                            or row.get("stream") is not None
+                            or row.get("allocation_api") != "cudaMalloc"
+                            or row.get("source") != "merlin/group_lock.cuh:65-70"
+                            or key in keys):

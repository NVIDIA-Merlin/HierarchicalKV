+def native_policy_observation(tables, config):
+    if config.backend == "dynamicemb":
+        caches = [cache for cache in tables.caches if cache is not None]
+        if not caches:
+            raise ValueError("native V2 requires actual DynamicEmb caches")
+        expected = 1 if config.hkv_layout == "shared" else 26
+        if len(caches) != expected or len(tables.tables) != expected:
+            raise ValueError("HKV physical cache/backing table count differs from layout")
+        detail = {
+            "partition": (
+                "shared_across_tables"
+                if config.hkv_layout == "shared"
+                else "per_table"
+            ),
+            "logical_tables": 26,
+            "physical_tables": len(tables.tables),
+            "candidate_group_slots": [
+                cache.options.bucket_capacity for cache in caches
+            ],
+            "logical_cache_rows": [int(cache.table.capacity()) for cache in caches],
+            "native_score_strategy": [
+                str(cache.options.score_strategy) for cache in caches
+            ],
+        }
+    elif config.backend == "torchrec":
+        state = tables.lxu_cache_state
+        if len(state.shape) != 2:
+            raise ValueError("native TBE cache state must expose sets and ways")
+        detail = {
+            "partition": "shared_across_tables",
+            "logical_tables": 26,
+            "physical_tables": 26,
+            "candidate_group_slots": [int(state.shape[1])],
+            "logical_cache_rows": [int(state.shape[0]) * int(state.shape[1])],
+            "native_score_strategy": [str(tables.cache_algorithm)],
+        }
+    else:
+        raise ValueError("unsupported native policy observation")
+    return {
+        **detail,
+        "requested_eviction": config.eviction,
+        "policy_equivalence_admitted": False,
+        "matching_associativity_required": False,
+        "matching_hit_rate_required": False,
+        "scope": "native-policy system comparison: disclose native layout and naturally different hit rates; policy_equivalence_admitted=false means score-update/admission semantics and workflow remain unverified, not that architectures must match; freeze and report initial state plus actual hit/miss/admission; matched initial state/hit mask is a separate mechanism-isolation requirement",
+    }

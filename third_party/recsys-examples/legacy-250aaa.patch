+static std::string allocation_pointer_hex(uintptr_t pointer) {
+  char buffer[2 + sizeof(uintptr_t) * 2 + 1];
+  std::snprintf(buffer, sizeof(buffer), "0x%llx",
+                static_cast<unsigned long long>(pointer));
+  return buffer;
+}
+
+static py::dict dyn_emb_cpu_storage_extent(
+    const std::shared_ptr<dyn_emb::DynamicVariableBase> &owner,
+    const at::Tensor &tensor) {
+  py::dict result;
+  result["recording_enabled"] = allocation_identities_enabled();
+  result["status"] = "disabled";
+  result["observed_extent_bytes"] = py::none();
+  result["extent_source"] = "unknown";
+  if (!allocation_identities_enabled()) {
+    return result;
+  }
+  result["status"] = "unsupported_allocator_or_storage";
+  if (!tensor.defined() || !tensor.device().is_cpu() ||
+      !tensor.has_storage()) {
+    return result;
+  }
+  const auto storage = tensor.storage();
+  const auto &data = storage.data_ptr();
+  result["owner_native_object_ptr"] =
+      owner ? py::cast(allocation_pointer_hex(
+                  reinterpret_cast<uintptr_t>(owner.get())))
+            : py::none();
+  result["storage_impl_ptr_hex"] = allocation_pointer_hex(
+      reinterpret_cast<uintptr_t>(storage.unsafeGetStorageImpl()));
+  result["allocation_base_ptr_hex"] =
+      allocation_pointer_hex(reinterpret_cast<uintptr_t>(data.get()));
+  result["tensor_ptr_hex"] =
+      allocation_pointer_hex(reinterpret_cast<uintptr_t>(tensor.data_ptr()));
+  result["storage_bytes"] = storage.nbytes();
+  result["domain"] = "host";
+  result["lifetime"] =
+      "live storage held during this observation; tensor owner retains it; "
+      "allocation/free timestamps unobserved";
+  result["storage_offset_bytes"] =
+      tensor.storage_offset() * tensor.element_size();
+  result["allocation_generation"] = py::none();
+  result["host_observation_ns"] = allocation_clock_ns();
+#if defined(__GLIBC__) && defined(__linux__) && TORCH_VERSION_MAJOR == 2 && \
+    TORCH_VERSION_MINOR == 7 && TORCH_VERSION_PATCH == 0
+  auto *allocator = c10::GetDefaultCPUAllocator();
+  if (storage.allocator() != allocator || !allocator->raw_deleter() ||
+      data.get_deleter() != allocator->raw_deleter() ||
+      data.get() != data.get_context() || data.get() == nullptr) {
+    return result;
+  }
+  Dl_info libc_info{}, aligned_info{}, extent_info{}, free_info{};
+  const bool glibc_functions =
+      dladdr(reinterpret_cast<void *>(&gnu_get_libc_version), &libc_info) &&
+      dladdr(reinterpret_cast<void *>(&posix_memalign), &aligned_info) &&
+      dladdr(reinterpret_cast<void *>(&malloc_usable_size), &extent_info) &&
+      dladdr(reinterpret_cast<void *>(&std::free), &free_info) &&
+      libc_info.dli_fbase == aligned_info.dli_fbase &&
+      libc_info.dli_fbase == extent_info.dli_fbase &&
+      libc_info.dli_fbase == free_info.dli_fbase;
+  if (!glibc_functions) {
+    return result;
+  }
+  result["observed_extent_bytes"] =
+      malloc_usable_size(const_cast<void *>(data.get()));
+  result["extent_source"] =
+      "glibc_malloc_usable_size_verified_pytorch_2_7_default_cpu_allocator_base";
+  result["allocator_provider"] = libc_info.dli_fname;
+  result["status"] = "observed_live_allocation_extent";
+#endif
+  return result;
+}
+
+static py::dict allocation_identity_dict(const AllocationIdentityStats &stats) {
+  py::dict result;
+  result["schema_version"] = 1;
+  result["recording_enabled"] = stats.enabled;
+  result["records_complete"] = stats.complete;
+  result["nvtx_available"] = stats.nvtx_available;
+  result["owner_id"] = stats.owner_id;
+  result["native_object_ptr"] = allocation_pointer_hex(stats.native_object);
+  result["device_id"] = stats.device_id;
+  result["dropped_records"] = stats.dropped_records;
+  result["last_sequence"] = stats.last_sequence;
+  py::list events;
+  const char *domains[] = {"device", "pinned", "host", "managed"};
+  for (const auto &record : stats.events) {
+    py::dict event;
+    event["sequence"] = record.sequence;
+    event["allocation_generation"] = record.generation;
+    event["pointer_hex"] = allocation_pointer_hex(record.pointer);
+    event["domain"] = domains[record.domain];
+    event["origin"] = record.origin;
+    event["requested_bytes"] = record.requested_bytes;
+    event["observed_extent_bytes"] = record.host_extent_known
+                                         ? py::cast(record.host_usable_bytes)
+                                         : py::none();
+    event["extent_source"] = record.host_extent_known
+                                 ? "glibc_malloc_usable_size"
+                                 : "unknown_until_actual_allocation_trace_join";
+    event["event"] = record.free_issued ? "free_issued" : "alloc_success";
+    event["asynchronous"] = record.asynchronous;
+    event["stream_hex"] = allocation_pointer_hex(record.stream);
+    event["host_begin_ns"] = record.begin_ns;
+    event["host_end_ns"] = record.end_ns;
+    event["pool_handle_hex"] = py::none();
+    if (std::strcmp(record.origin, "native_object_control_block") == 0) {
+      event["extent_applicability"] =
+          allocation_control_block_abi_supported()
+              ? "native_layout_std_allocator_equivalent"
+              : "diagnostic_combined_allocation_only";
+      event["instrumentation_off_extent_bytes"] = py::none();
+      event["budget_class"] = "native_object_and_control_block";
+    }
+    events.append(event);
+  }
+  result["events"] = events;
+  py::list host_allocations;
+  for (const auto &record : stats.host_allocations) {
+    py::dict extent;
+    extent["pointer_hex"] = allocation_pointer_hex(record.pointer);
+    extent["domain"] = "host";
+    extent["origin"] = record.origin;
+    extent["allocation_generation"] = 1;
+    extent["object_bytes"] = record.object_bytes;
+    extent["observed_extent_bytes"] =
+        record.extent_known ? py::cast(record.usable_bytes) : py::none();
+    extent["extent_source"] =
+        record.extent_known
+            ? "glibc_malloc_usable_size_default_libstdcxx_allocation_base"
+            : "unknown";
+    extent["lifetime"] = "owner_bound_fixed_capacity_metadata";
+    host_allocations.append(extent);
+  }
+  result["host_allocations"] = host_allocations;
+  py::dict control_block_budget;
+  control_block_budget["status"] =
+      allocation_control_block_abi_supported()
+          ? "selected_abi_layout_and_allocator_equivalent"
+          : "layout_equivalence_unverified";
+  control_block_budget["instrumentation_off_extent_bytes"] = py::none();
+  control_block_budget["diagnostic_extent_is_baseline_evidence"] =
+      allocation_control_block_abi_supported();
+  control_block_budget["observer_state_journal_extent_bytes"] = py::none();
+  control_block_budget["observer_registry_extent_bytes"] = py::none();
+  control_block_budget["observer_registry_lifetime"] = "process";
+  control_block_budget["observer_registry_budget_class"] = "instrumentation";
+  control_block_budget["reason"] =
+      "The empty diagnostic allocator forwards the same std::allocator "
+      "allocation/deallocation as make_shared. Selected libstdc++ ABI layout "
+      "guards apply to every observed factory type; other ABIs are unverified. "
+      "Actual observed pointer extents are native-layout evidence, not a "
+      "measurement of a separate instrumentation-off run or physical residency. "
+      "Owner state, journal, and the out-of-band lifetime registry are separate "
+      "instrumentation allocations with unknown extents; no size subtraction.";
+  result["native_object_control_block_budget"] = control_block_budget;
+  result["scope"] =
+      "Diagnostic identity journal, not actual-total or physical memory. "
+      "CUDA requested extents require allocation/pool trace join. Free "
+      "issuance is not "
+      "GPU completion or pool release. Host usable extents exclude allocator "
+      "arenas. "
+      "Owner constructor NVTX covers uninstrumented role-counter allocations. "
+      "Instrumentation state/journal storage is not native payload metadata. "
+      "Host clock is steady_clock, not a CUDA trace timestamp.";
+  return result;
+}
+
+py::dict dyn_emb_cuda_pool_stats(int device) {
+  py::dict result;
+  result["device_id"] = device;
+  result["status"] = "disabled";
+  py::list queries;
+  result["queries"] = queries;
+  if (!allocation_identities_enabled())
+    return result;
+  int active_device = -1;
+  auto status = cudaGetDevice(&active_device);
+  if (status != cudaSuccess || active_device != device) {
+    result["status"] = "wrong_device_or_query_error";
+    result["cuda_status"] = static_cast<int>(status);
+    return result;
+  }
+  cudaMemPool_t previous = nullptr;
+  bool queries_succeeded = true;
+  for (const char *role : {"current", "default"}) {
+    py::dict query;
+    query["role"] = role;
+    query["host_begin_ns"] = allocation_clock_ns();
+    cudaMemPool_t pool = nullptr;
+    status = std::strcmp(role, "current") == 0
+                 ? cudaDeviceGetMemPool(&pool, device)
+                 : cudaDeviceGetDefaultMemPool(&pool, device);
+    query["pool_handle_hex"] =
+        allocation_pointer_hex(reinterpret_cast<uintptr_t>(pool));
+    uint64_t reserved = 0;
+    uint64_t used = 0;
+    query["reserved_current_bytes"] = py::none();
+    query["used_current_bytes"] = py::none();
+    if (status == cudaSuccess && pool == previous) {
+      query["alias_of_role"] = "current";
+    } else if (status == cudaSuccess) {
+      status = cudaMemPoolGetAttribute(pool, cudaMemPoolAttrReservedMemCurrent,
+                                       &reserved);
+      if (status == cudaSuccess)
+        query["reserved_current_bytes"] = reserved;
+      if (status == cudaSuccess) {
+        status =
+            cudaMemPoolGetAttribute(pool, cudaMemPoolAttrUsedMemCurrent, &used);
+        if (status == cudaSuccess) {
+          query["used_current_bytes"] = used;
+          query["used_le_reserved"] = used <= reserved;
+        }
+      }
+      previous = pool;
+    }
+    query["cuda_status"] = static_cast<int>(status);
+    queries_succeeded = queries_succeeded && status == cudaSuccess;
+    query["host_end_ns"] = allocation_clock_ns();
+    queries.append(query);
+  }
+  result["status"] = queries_succeeded ? "queried" : "query_error";
+  result["scope"] =
+      "Non-atomic endpoint queries; no synchronization, pool mutation, "
+      "or peak reset. Must be called at an already synchronized observation. "
+      "Reserved backing includes used suballocations; never add them.";
+  return result;
+}
+
+py::dict
+dyn_emb_memory_stats(std::shared_ptr<dyn_emb::DynamicVariableBase> table,
+                     bool include_allocations = false) {
+  if (!table) {
+    throw std::invalid_argument("table must not be null");
+  }
+  const auto stats = table->memory_stats(include_allocations);
+  py::dict result;
+  py::dict categories;
+  const char *names[] = {"device", "pinned", "host", "managed"};
+  for (size_t index = 0; index < stats.categories.size(); ++index) {
+    const auto &category = stats.categories[index];
+    py::dict entry;
+    entry["live_requested_bytes"] = category.live_requested_bytes;
+    entry["current_allocations"] = category.current_allocations;
+    entry["peak_live_requested_bytes"] = category.peak_live_requested_bytes;
+    entry["peak_current_allocations"] = category.peak_current_allocations;
+    entry["async_free_issued_requested_bytes"] = category.async_free_issued_requested_bytes;
+    entry["async_free_issued_allocations"] = category.async_free_issued_allocations;
+    categories[names[index]] = entry;
+  }
+  result["schema_version"] = 1;
+  result["allocator"] = categories;
+  result["bookkeeping_complete"] = stats.bookkeeping_complete;
+  result["bookkeeping_errors"] = stats.bookkeeping_errors;
+  result["failed_delegate_calls"] = stats.failed_delegate_calls;
+  result["direct_curand_requested_bytes"] = stats.direct_curand_requested_bytes;
+  result["physical_bytes"] = py::none();
+  result["resident_bytes"] = py::none();
+  result["async_pending_bytes"] = py::none();
+  result["pool_idle_bytes"] = py::none();
+  result["payload_metadata_breakdown"] = py::none();
+  if (include_allocations)
+    result["allocation_identity"] = allocation_identity_dict(stats.identity);
+  result["semantics"] = "Requested bytes through this table's HKV allocator; live ends at successful free issuance, not GPU completion. Async-free fields are cumulative, not pending. HKV pool backing remains live until delegated free. Direct curand requests are separate device allocations. Not physical/resident/total process memory; excludes Torch tensors, CUDA context/pool retention, C++ bookkeeping and allocations bypassing the injected allocator. Per-category peaks are not a simultaneous total peak. No CUDA query or synchronization is performed.";
+  return result;
+}
+
@@ -898,0 +1174,26 @@ void bind_dyn_emb_op(py::module &m) {
+  m.def("dyn_emb_cpu_storage_extent", &dyn_emb_cpu_storage_extent,
+        "Read a verified live CPU storage allocation extent; "
+        "no retention or synchronization.",

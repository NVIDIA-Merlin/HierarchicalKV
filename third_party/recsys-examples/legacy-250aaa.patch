+def _budget_elf_identity(path):
+    with open(path, "rb") as stream:
+        header = stream.read(64)
+        if (len(header) != 64 or header[:6] != b"\x7fELF\x02\x01"
+                or struct.unpack_from("<HH", header, 16) != (3, 62)):
+            raise ValueError("expected ELF64 little-endian x86_64 ET_DYN")
+        phoff = struct.unpack_from("<Q", header, 32)[0]
+        entsize, count = struct.unpack_from("<HH", header, 54)
+        if entsize != 56 or not 0 < count < 1024:
+            raise ValueError("unsupported ELF program header table")
+        stream.seek(phoff)
+        entries = [struct.unpack("<IIQQQQQQ", stream.read(56)) for _ in range(count)]
+        loads = [(entry[3], entry[2], entry[5]) for entry in entries if entry[0] == 1]
+        if not loads or min(entry[0] for entry in loads) != 0:
+            raise ValueError("ELF load-bias basis is not zero")
+        notes = []
+        for entry in entries:
+            if entry[0] != 4 or entry[5] > (1 << 20):
+                continue
+            stream.seek(entry[2])
+            data = stream.read(entry[5])
+            offset = 0
+            while offset + 12 <= len(data):
+                namesize, descsize, kind = struct.unpack_from("<III", data, offset)
+                offset += 12
+                name = data[offset:offset + namesize]
+                offset += (namesize + 3) & ~3
+                desc = data[offset:offset + descsize]
+                offset += (descsize + 3) & ~3
+                if name.rstrip(b"\0") == b"GNU" and kind == 3:
+                    notes.append(desc.hex())
+        if len(notes) != 1:
+            raise ValueError("missing or duplicate ELF build-id")
+    return {"build_id": notes[0], "loads": loads}
+
+
+def _budget_elf_file_bytes(path, elf, vaddr, length):
+    matches = [(offset + vaddr - start) for start, offset, size in elf["loads"]
+               if start <= vaddr and vaddr + length <= start + size]
+    if len(matches) != 1:
+        raise ValueError("ELF function address has no unique file extent")
+    with open(path, "rb") as stream:
+        stream.seek(matches[0])
+        data = stream.read(length)
+    if len(data) != length:
+        raise ValueError("truncated frozen ELF function")
+    return data
+
+
+def _budget_dso_maps(path):
+    st = os.stat(path)
+    canonical = os.path.realpath(path)
+    selected = []
+    for line in Path("/proc/self/maps").read_text().splitlines():
+        parts = line.split(maxsplit=5)
+        if len(parts) != 6 or not parts[5].startswith("/"):
+            continue
+        if os.path.realpath(parts[5]) != canonical:
+            continue
+        major, minor = (int(value, 16) for value in parts[3].split(":"))
+        if (major, minor, int(parts[4])) != (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino):
+            raise ValueError("mapped DSO inode/device differs from frozen file")
+        start, end = (int(value, 16) for value in parts[0].split("-"))
+        selected.append((start, end, parts[1], int(parts[2], 16)))
+    bases = [start for start, _end, _perms, offset in selected if offset == 0]
+    if len(bases) != 1:
+        raise ValueError("DSO has no unique zero-offset mapped base")
+    return bases[0], selected
+
+
+def _budget_read_mapped(path, base, mappings, relative, length, executable=False):
+    address = base + relative
+    matching = [record for record in mappings
+                if record[0] <= address and address + length <= record[1]
+                and "r" in record[2] and (not executable or "x" in record[2])]
+    if len(matching) != 1:
+        raise ValueError("GOT/function not wholly inside readable frozen DSO map")
+    fd = os.open("/proc/self/mem", os.O_RDONLY | os.O_CLOEXEC)
+    try:
+        data = os.pread(fd, length, address)
+    finally:
+        os.close(fd)
+    if len(data) != length or _budget_dso_maps(path) != (base, mappings):
+        raise ValueError("short process-memory read or DSO mapping changed")
+    return data
+

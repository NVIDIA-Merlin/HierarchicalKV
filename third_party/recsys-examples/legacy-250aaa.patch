+def visible_buffer_inventory(named_buffers, *, include_identity=False):
+    storages = {}
+    for name, value in named_buffers:
+        storage = value.untyped_storage()
+        identity = (
+            str(value.device),
+            storage.data_ptr() if storage.nbytes() else name,
+        )
+        record = storages.setdefault(
+            identity,
+            {
+                "names": [],
+                "storage_bytes": storage.nbytes(),
+                "device": str(value.device),
+            },
+        )
+        if record["storage_bytes"] != storage.nbytes():
+            raise ValueError("aliased storage has inconsistent byte extent")
+        record["names"].append(name)
+        if include_identity:
+            record["storage_ptr_hex"] = hex(storage.data_ptr())
+            record.setdefault("views", []).append(
+                {
+                    "name": name,
+                    "tensor_ptr_hex": hex(value.data_ptr()),
+                    "storage_offset_bytes": value.storage_offset() * value.element_size(),
+                }
+            )
+    buffers, totals = [], {}
+    for record in storages.values():
+        categories = {buffer_memory_category(name) for name in record["names"]}
+        category = next(iter(categories)) if len(categories) == 1 else "mixed_aliases"
+        record.update(
+            name=record["names"][0],
+            category=category,
+            physical_resident_bytes=None,
+            managed_or_placeholder=any(
+                name.endswith("_uvm") for name in record["names"]
+            ),
+        )
+        totals[category] = totals.get(category, 0) + record["storage_bytes"]
+        buffers.append(record)
+    return buffers, totals

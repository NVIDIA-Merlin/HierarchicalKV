+def summarize_files(paths, output):
+    records, inputs = [], []
+    for path in paths:
+        identity = {"path": str(Path(path).resolve()), "sha256": None}
+        inputs.append(identity)
+        try:
+            identity["sha256"] = sha256(path)
+            events = [json.loads(line) for line in Path(path).read_text().splitlines()]
+            if (
+                not events
+                or events[-1]["kind"] != "result"
+                or sum(event["kind"] == "result" for event in events) != 1
+            ):
+                raise ValueError("missing or duplicate terminal result")
+            records.append(events[-1]["value"])
+        except (OSError, ValueError, KeyError, TypeError) as error:
+            records.append({"status": "failed", "error": str(error)})
+    result = summarize(records)
+    result["raw_inputs"] = inputs
+    result[
+        "selection_boundary"
+    ] = "all supplied failures retained; caller must include every planned run, including terminated attempts; no automatic discovery of omitted runs"
+    with Path(output).open("x") as stream:
+        json.dump(result, stream, indent=2, allow_nan=False)
+        stream.write("\n")
+    return result

+def _budget_f52_bss_read(path, base, named_mappings, relative, length):
+    """Read only the exact f52 anonymous BSS tail contiguous to its RW LOAD."""
+    if not 0x28e4bf30 <= relative < relative + length <= 0x292e09e8:
+        raise ValueError("timestamp address outside frozen f52 RW LOAD BSS extent")
+    anonymous_start = base + 0x28e4c000
+    if not any(end == anonymous_start and "w" in perms
+               for _start, end, perms, _offset in named_mappings):
+        raise ValueError("f52 file-backed writable LOAD does not border BSS tail")
+
+    def anonymous_mapping():
+        found = []
+        for line in Path("/proc/self/maps").read_text().splitlines():
+            parts = line.split(maxsplit=5)
+            if len(parts) < 5:
+                continue
+            start, end = (int(value, 16) for value in parts[0].split("-"))
+            if (start == anonymous_start and end >= base + 0x292e09e8
+                    and "r" in parts[1] and "w" in parts[1]
+                    and parts[3] == "00:00" and parts[4] == "0"
+                    and (len(parts) == 5 or parts[5].startswith("[anon:"))):
+                found.append((start, end, parts[1], parts[3], parts[4]))
+        if len(found) != 1:
+            raise ValueError("f52 anonymous BSS map absent or ambiguous")
+        return found[0]
+
+    before = anonymous_mapping()
+    fd = os.open("/proc/self/mem", os.O_RDONLY | os.O_CLOEXEC)
+    try:
+        data = os.pread(fd, length, base + relative)
+    finally:
+        os.close(fd)
+    if len(data) != length or anonymous_mapping() != before:
+        raise ValueError("short BSS read or anonymous map changed")
+    return data

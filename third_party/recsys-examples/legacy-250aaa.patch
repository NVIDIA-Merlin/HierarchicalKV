+@pytest.mark.parametrize("corrupt", [False, True])
+def test_replay_plumbing_with_cpu_test_double(tmp_path, monkeypatch, corrupt):
+    from . import serving_replay
+
+    config = small_config(tmp_path, batch_size=4)
+
+    class Storage:
+        def __init__(self):
+            self.values = None
+
+        def value_dim(self):
+            return config.embedding_dim
+
+        def init_optimizer_state(self):
+            return 0
+
+        def set_score(self, score):
+            pass
+
+        def insert(self, keys, values):
+            self.values = values.clone()
+
+    class Cache:
+        def __init__(self):
+            self.keys = set()
+            self.cache_metrics = torch.zeros(10, dtype=torch.int64)
+
+        def size(self):
+            return len(self.keys)
+
+    class Tables(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.tables = [Storage() for _ in config.vocab_sizes]
+            self.caches = [Cache() for _ in config.vocab_sizes]
+
+        def reset_cache_states(self):
+            for cache in self.caches:
+                cache.keys.clear()
+
+        def flush(self):
+            pass
+
+        def set_record_cache_metrics(self, enabled):
+            pass
+
+        def forward(self, indices, offsets):
+            output = []
+            for keys, cache, storage in zip(
+                indices.reshape(26, -1), self.caches, self.tables
+            ):
+                unique = set(keys.tolist())
+                cache.cache_metrics[0] = len(unique)
+                cache.cache_metrics[1] = len(unique & cache.keys)
+                cache.keys.update(unique)
+                output.append(storage.values[keys])
+            return torch.cat(output) + (1 if corrupt else 0)
+
+    tables = Tables()
+    path = tmp_path / "fixture.pt"
+    torch.save(serving_replay.make_smoke_checkpoint(config), path)
+    dataset = CriteoKaggleDataset(config, True, 100)

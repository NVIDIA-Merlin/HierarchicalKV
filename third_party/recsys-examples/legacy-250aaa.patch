+def diagnostic_denominators(sparse):
+    rows = sparse.tolist()
+    table_count = len(rows[0]) if rows else 0
+    if not rows or not table_count or any(len(row) != table_count for row in rows):
+        raise ValueError("diagnostic requests must be a nonempty rectangular batch")
+    unique_per_table = [
+        len({row[table] for row in rows}) for table in range(table_count)
+    ]
+    return {
+        "original_request_rows": len(rows),
+        "embedding_rows": len(rows) * table_count,
+        "unique_keys_per_table": unique_per_table,
+        "unique_table_keys": sum(unique_per_table),
+        "scope": "one forward; keys deduplicated within each table, not across tables",
+    }

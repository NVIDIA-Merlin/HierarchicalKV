+def diagnostic_boundary_changes(before, after, sparse):
+    result = {
+        "status": "unavailable",
+        "newly_resident": None,
+        "no_longer_resident": None,
+        "requested_not_resident_after": None,
+        "admission_events": None,
+        "rejection_events": None,
+        "eviction_events": None,
+        "scope": "table-key boundary set differences only; transient admit/evict events are not observable from endpoints",
+    }
+    if before["status"] != "observed" or after["status"] != "observed":
+        result["reason"] = "both cache snapshots must be available"
+        return result
+    prior = {tuple(entry[:2]) for entry in before["entries"]}
+    current = {tuple(entry[:2]) for entry in after["entries"]}
+    requested = {
+        (table, key) for row in sparse.tolist() for table, key in enumerate(row)
+    }
+    result.update(
+        status="observed",
+        newly_resident=sorted(current - prior),
+        no_longer_resident=sorted(prior - current),
+        requested_not_resident_after=sorted(requested - current),
+    )
+    return result

+def test_calibration_observations_remain_outside_fresh_timing_path():
+    source = inspect.getsource(comparison.run_native)
+    timed_workflow = source.split("                del tables", 1)[1]
+    for helper in (
+        "diagnostic_cache_snapshot",
+        "diagnostic_counter_delta",
+        "diagnostic_boundary_changes",
+        "diagnostic_denominators",
+    ):
+        assert helper not in timed_workflow
+    assert timed_workflow.count("metrics_enabled=False") == 2
+    assert "diagnostic_metrics(tables, config, False)" in timed_workflow
+    tree = ast.parse(source)
+    phase_loop = next(
+        node
+        for node in ast.walk(tree)
+        if isinstance(node, ast.For)
+        and isinstance(node.target, ast.Name)
+        and node.target.id == "phase"
+    )
+    exported_calls = [
+        node
+        for node in ast.walk(phase_loop)
+        if isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Name)
+        and node.func.id == "diagnostic_cache_snapshot"
+    ]
+    assert len(exported_calls) == 2

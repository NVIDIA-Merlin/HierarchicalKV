+@pytest.fixture
+def dirty_cpu_fixture(monkeypatch):
+    import torch
+    from .config import ExperimentConfig
+
+    created = []
+
+    class CpuBacking:
+        def __init__(self, owner, table_index):
+            self.owner = owner
+            self.table_index = table_index
+
+        def value_dim(self):
+            return 32
+
+        def find(self, keys, values, found):
+            values.copy_(self.owner.backing[self.table_index][keys])
+            found.fill_(True)
+
+    class CpuTables:
+        def __init__(self, config, fault):
+            self.config = config
+            self.fault = fault
+            self.caches = [OrderedDict() for _ in range(26)]
+            self.tables = [CpuBacking(self, index) for index in range(26)]
+            self.events = []
+            self.requests = []
+            self.training = False
+            self.updated = set()
+            self.capacity = 2 if config.backend == "dynamicemb" else 3
+
+        def train(self):
+            self.training = True
+
+        def split_embedding_weights(self):
+            return self.backing
+
+        def flush(self):
+            self.events.append("flush")
+            for table_index, cache in enumerate(self.caches):
+                for key, value in cache.items():
+                    if self.fault != "lost_flush" or (table_index, key) != (0, 1):
+                        self.backing[table_index][key].copy_(value)
+
+        def reset_cache_states(self):
+            self.events.append("reset")
+            if self.fault != "bad_reset":
+                for cache in self.caches:
+                    cache.clear()
+
+        def lookup(self, sparse):
+            self.requests.append(sparse.clone())
+            output_rows = []
+            for row in sparse.tolist():
+                values = []
+                for table_index, key in enumerate(row):
+                    cache = self.caches[table_index]
+                    if key not in cache:
+                        if len(cache) >= self.capacity and self.fault != "no_eviction":
+                            victim, value = cache.popitem(last=False)
+                            self.events.append(("evict", table_index, victim))
+                            if self.fault != "lost_eviction" or (
+                                table_index,
+                                victim,
+                            ) != (0, 0):
+                                self.backing[table_index][victim].copy_(value)
+                        value = self.backing[table_index][key].clone()
+                        if (
+                            self.fault == "stale_restore"
+                            and (table_index, key) == (0, 0)
+                            and key in self.updated
+                        ):
+                            value = self.initial[0][0].clone()
+                        cache[key] = value
+                    cache.move_to_end(key)
+                    values.append(cache[key])
+                output_rows.append(torch.cat(values))
+            result = torch.stack(output_rows)
+            if (
+                torch.is_grad_enabled()
+                and self.training
+                and self.fault != "no_backward"
+            ):
+                result.requires_grad_()
+
+                def backward(gradient):
+                    self.events.append("backward")
+                    if self.fault != "no_update":
+                        for row_index, row in enumerate(sparse.tolist()):
+                            for table_index, key in enumerate(row):
+                                delta = gradient[
+                                    row_index, table_index * 32 : (table_index + 1) * 32
+                                ]
+                                if self.fault == "partial_update":
+                                    delta = delta.clone()
+                                    delta[1:] = 0
+                                self.caches[table_index][key].sub_(
+                                    self.config.learning_rate * delta
+                                )
+                                if self.fault == "write_through":
+                                    self.backing[table_index][key].copy_(
+                                        self.caches[table_index][key]
+                                    )
+                                if table_index == 0:
+                                    self.updated.add(key)
+
+                result.register_hook(backward)
+            return result
+
+    def setup(backend, fault=None):
+        config = ExperimentConfig(
+            backend=backend,
+            vocab_sizes=[12] * 26,
+            embedding_dim=32,
+            optimizer="exact_sgd",
+            batch_size=3,
+        )
+        weights = [torch.full((12, 32), float(index) / 8) for index in range(26)]
+
+        def create(config, device):
+            assert device == "cpu"
+            tables = CpuTables(config, fault)
+            created.append(tables)
+            return tables
+
+        def load(tables, config, weights, device):
+            tables.initial = [weight.clone() for weight in weights]
+            tables.backing = [weight.clone() for weight in weights]
+
+        def reference(weights, sparse):
+            return torch.cat(
+                [weight[sparse[:, index]] for index, weight in enumerate(weights)],
+                dim=1,
+            )
+
+        def parity(actual, expected, exact=False):
+            assert exact is True
+            torch.testing.assert_close(actual.detach(), expected, rtol=0, atol=0)
+
+        monkeypatch.setitem(
+            sys.modules,
+            f"{comparison.__package__}.embedding_config",
+            SimpleNamespace(create_embedding_tables=create, load_frozen_weights=load),
+        )
+        monkeypatch.setitem(
+            sys.modules,
+            f"{comparison.__package__}.serving_replay",
+            SimpleNamespace(
+                _lookup=lambda tables, config, sparse, device: tables.lookup(sparse),
+                _assert_parity=parity,
+                reference_embeddings=reference,
+            ),
+        )
+        monkeypatch.setattr(torch.cuda, "synchronize", lambda device: None)
+        monkeypatch.setattr(
+            comparison,
+            "native_policy_observation",
+            lambda tables, config: {"fixture_only": True},
+        )
+        monkeypatch.setattr(
+            comparison,
+            "diagnostic_cache_snapshot",
+            lambda tables, config: {
+                "status": "observed",
+                "entries": [
+                    [index, key, 0]
+                    for index, cache in enumerate(tables.caches)
+                    for key in cache
+                ],
+            },
+        )
+        return config, weights, created
+
+    return setup

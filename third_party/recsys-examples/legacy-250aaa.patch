+def _budget_registered_managed_pointers(inventory, pool):
+    result = {"status": "incomplete", "coverage_complete": False}
+    try:
+        if inventory.get("status") != "observed_unqualified" or pool.get("status") != "observed_unqualified":
+            raise ValueError("registered storage or CUDA pool observation unavailable")
+        handles = {int(item["handle_hex"], 16) for item in pool["queries"]}
+        candidates = [item for item in inventory["records"]
+                      if item.get("managed_or_placeholder") and item["storage_bytes"] > 0]
+        if not candidates:
+            return {"status": "observed_unqualified", "records": [],
+                    "scope": "no nonempty registered managed-or-placeholder buffers"}
+        cuda, range_function, _range_name = _budget_cuda_pointer_reader()
+        records = []
+        for storage in candidates:
+            row = {"type": "managed", "pointer": int(storage["storage_ptr_hex"], 16),
+                   "requested_bytes": storage["storage_bytes"]}
+            observed = _budget_probe_cuda_pointer(cuda, range_function, row, handles)
+            records.append({"names": storage["names"], "storage": row,
+                            "cuda_pointer": observed})
+        result.update(status="observed_unqualified", records=records,
+                      scope="Actual registered storage pointers; no managed commitment upper inferred from mappable VA")
+    except Exception as error:
+        result["error"] = f"{type(error).__name__}: {error}"
+    return result
+

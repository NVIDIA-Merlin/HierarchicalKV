+def dynamic_training_double(config, monkeypatch, corrupt_reload=False, no_update=False):
+    """CPU plumbing only; deliberately not a native optimizer implementation."""
+
+    class Storage:
+        def __init__(self):
+            self.rows = {}
+
+        def value_dim(self):
+            return config.embedding_dim + backends._state_width(config)
+
+        def init_optimizer_state(self):
+            return 0.0
+
+        def size(self):
+            return len(self.rows)
+
+        def set_score(self, score):
+            pass
+
+        def insert(self, keys, values):
+            for key, value in zip(keys.tolist(), values):
+                self.rows[key] = value.clone()
+
+        def find(self, keys, values, found):
+            for index, key in enumerate(keys.tolist()):
+                found[index] = key in self.rows
+                if key in self.rows:
+                    values[index].copy_(self.rows[key])
+
+    class Cache:
+        def __init__(self):
+            self.rows = {}
+            self.cache_metrics = torch.zeros(10, dtype=torch.int64)
+
+        def size(self):
+            return len(self.rows)
+
+    class Tables(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.tables = [Storage() for _size in config.vocab_sizes]
+            self.caches = [Cache() for _size in config.vocab_sizes]
+            self.args = {"opt_type": config.optimizer, "lr": config.learning_rate}
+            if config.optimizer == "adam":
+                self.args.update(
+                    iters=0, beta1=0.9, beta2=0.999, eps=config.eps, weight_decay=0.0
+                )
+            elif "adagrad" in config.optimizer:
+                self.args.update(eps=config.eps, initial_accumulator_value=0.0)
+            self.optimizer = SimpleNamespace(
+                get_opt_args=lambda: self.args.copy(),
+                set_opt_args=lambda args: self.args.update(args),
+            )
+            self.updated = False
+
+        def flush(self):
+            for cache, storage in zip(self.caches, self.tables):
+                for key, value in cache.rows.items():
+                    storage.rows[key] = value.clone()
+
+        def reset_cache_states(self):
+            for cache, storage in zip(self.caches, self.tables):
+                if corrupt_reload and self.updated:
+                    for value in storage.rows.values():
+                        value[config.embedding_dim :] = 0
+                cache.rows.clear()
+
+        def set_record_cache_metrics(self, enabled):
+            pass
+
+        def forward(self, indices, offsets):
+            keys_by_table = indices.reshape(26, -1).tolist()
+            outputs = []
+            for keys, cache, storage in zip(keys_by_table, self.caches, self.tables):
+                unique = set(keys)
+                cache.cache_metrics[0] = len(unique)
+                cache.cache_metrics[1] = len(unique & cache.rows.keys())
+                for key in unique:
+                    if key not in cache.rows:
+                        cache.rows[key] = storage.rows[key].clone()
+                outputs.extend(cache.rows[key][: config.embedding_dim] for key in keys)
+            output = torch.stack(outputs).detach().requires_grad_(True)
+
+            def update(gradient):
+                if not no_update:
+                    for keys, cache, grads in zip(
+                        keys_by_table,
+                        self.caches,
+                        gradient.reshape(26, -1, config.embedding_dim),
+                    ):
+                        for key, grad in zip(keys, grads):
+                            cache.rows[key][: config.embedding_dim] -= (
+                                config.learning_rate * grad
+                            )
+                            cache.rows[key][config.embedding_dim :] += grad.abs().sum()
+                    self.updated = True
+                return gradient
+
+            output.register_hook(update)
+            return output
+
+    monkeypatch.setattr(backends, "_backend_class", lambda backend: Tables)
+    return Tables
+

+def timing_cache_boundary(tables, config, run, phase):
+    snapshot = diagnostic_cache_snapshot(tables, config)
+    snapshot["association"] = {
+        "factory_id": "final",
+        "phase": phase,
+        "backend": run["backend"],
+        "state": run["state"],
+        "input_sha256": run["input_sha256"],
+        "trace_sha256": run["trace_sha256"],
+        "weights_sha256": run["weights_sha256"],
+        "first_request_id": 0,
+        "request_id_end_exclusive": run["expected_requests"],
+        "first_batch": 0,
+        "batch_end_exclusive": run["cell"]["batches"],

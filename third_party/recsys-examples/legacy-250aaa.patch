+FORMAT = "hkv-native-tbe-v2-1"
+BUDGET_GLIBC_SOURCE_VERSIONS = frozenset(("2.35", "2.39"))
+BACKENDS = ("dynamicemb", "torchrec")
+NATIVE_TYPES = {
+    "dynamicemb": "dynamicemb.batched_dynamicemb_tables.BatchedDynamicEmbeddingTablesV2",
+    "torchrec": "fbgemm_gpu.split_table_batched_embeddings_ops_training.SplitTableBatchedEmbeddingBagsCodegen",
+}
+OPEN_GATES = {
+    "native_policy_equivalence": (
+        "OPEN: verify matching LRU/LFU score-update/admission semantics and "
+        "full-service workflow; report actual hit/miss/admission under the "
+        "common trace and frozen warmup, prefill, score and resident states. "
+        "Native associativity differences are disclosure, not a standalone "
+        "blocker; naturally different hit rates are allowed."
+    ),
